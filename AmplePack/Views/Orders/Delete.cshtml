@using AmplePack.Helpers
@model AmplePack.Models.Order
@{
    ViewData["Title"] = "Delete Order";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Delete Order</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <div class="card card-danger">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-exclamation-triangle"></i> Delete Order #@Model.Id
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-warning">
                            <h5><i class="icon fas fa-exclamation-triangle"></i> Warning!</h5>
                            Are you sure you want to delete this order? This action cannot be undone and will remove all associated order details.
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <table class="table table-borderless">
                                    <tr>
                                        <th><i class="fas fa-hashtag mr-1"></i> Order ID:</th>
                                        <td><strong>#@Model.Id</strong></td>
                                    </tr>
                                    <tr>
                                        <th><i class="fas fa-user mr-1"></i> Customer:</th>
                                        <td>@Model.Customer?.Name</td>
                                    </tr>
                                    <tr>
                                        <th><i class="fas fa-calendar mr-1"></i> Order Date:</th>
                                        <td>@Model.Date.ToString("MMMM dd, yyyy")</td>
                                    </tr>
                                    <tr>
                                        <th><i class="fas fa-info-circle mr-1"></i> Status:</th>
                                        <td>
                                            <span class="badge @(Model.Status == "Completed" ? "badge-success" : Model.Status == "Pending" ? "badge-warning" : Model.Status == "Processing" ? "badge-info" : "badge-danger")">
                                                @Model.Status
                                            </span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th><i class="fas fa-money-bill mr-1"></i> Total Amount:</th>
                                        <td><strong class="text-success">@CurrencyHelper.FormatCurrency(Model.TotalAmount)</strong></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-md-6">
                                @if (Model.OrderDetails?.Any() == true)
                                {
                                    <h6><i class="fas fa-list mr-1"></i> Order Items (@Model.OrderDetails.Count()):</h6>
                                    <div class="list-group list-group-flush">
                                        @foreach (var detail in Model.OrderDetails.Take(3))
                                        {
                                            <div class="list-group-item p-2">
                                                <strong>@detail.BoxType</strong> <small class="text-muted">(@detail.Size)</small><br>
                                                <small class="text-muted">
                                                    Qty: @detail.Quantity × @CurrencyHelper.FormatCurrency(detail.PricePerBox) = 
                                                    <strong>@CurrencyHelper.FormatCurrency(detail.Quantity * detail.PricePerBox)</strong>
                                                </small>
                                            </div>
                                        }
                                        @if (Model.OrderDetails.Count() > 3)
                                        {
                                            <div class="list-group-item p-2 text-muted">
                                                <small><i class="fas fa-ellipsis-h mr-1"></i>...and @(Model.OrderDetails.Count() - 3) more items</small>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center text-muted">
                                        <i class="fas fa-box-open fa-2x mb-2"></i>
                                        <p>No order items</p>
                                    </div>
                                }
                            </div>
                        </div>

                        @if (Model.Customer != null)
                        {
                            <hr>
                            <div class="row">
                                <div class="col-12">
                                    <h6><i class="fas fa-user-circle mr-1"></i> Customer Details:</h6>
                                    <div class="row">
                                        <div class="col-sm-6">
                                            <small class="text-muted">Email:</small><br>
                                            <a href="mailto:@Model.Customer.Email">@Model.Customer.Email</a>
                                        </div>
                                        <div class="col-sm-6">
                                            <small class="text-muted">Contact:</small><br>
                                            <a href="tel:@Model.Customer.Contact">@Model.Customer.Contact</a>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(Model.Customer.Address))
                                    {
                                        <div class="mt-2">
                                            <small class="text-muted">Address:</small><br>
                                            @Model.Customer.Address
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <div class="card-footer">
                        <form asp-action="Delete" method="post">
                            <input type="hidden" asp-for="Id" />
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Are you absolutely sure you want to delete this order? This action cannot be undone!')">
                                <i class="fas fa-trash"></i> Yes, Delete Order
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info">
                                <i class="fas fa-eye"></i> View Details
                            </a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>