@page
@model AmplePack.Pages_Customers.DetailsModel
@{
    ViewData["Title"] = "Customer Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="row">
  <div class="col-md-8">
    <!-- Profile Image -->
    <div class="card card-primary card-outline">
      <div class="card-body box-profile">
        <div class="text-center">
          <img class="profile-user-img img-fluid img-circle"
               src="https://adminlte.io/themes/v3/dist/img/user4-128x128.jpg"
               alt="User profile picture">
        </div>

        <h3 class="profile-username text-center">@Html.DisplayFor(model => model.Customer!.Name)</h3>

        <p class="text-muted text-center">Customer ID: @Html.DisplayFor(model => model.Customer!.Id)</p>

        <ul class="list-group list-group-unbordered mb-3">
          <li class="list-group-item">
            <b><i class="fas fa-envelope mr-1"></i> Email</b> 
            <a class="float-right" href="mailto:@Model.Customer?.Email">@Html.DisplayFor(model => model.Customer!.Email)</a>
          </li>
          <li class="list-group-item">
            <b><i class="fas fa-phone mr-1"></i> Contact</b> 
            <a class="float-right" href="tel:@Model.Customer?.Contact">@Html.DisplayFor(model => model.Customer!.Contact)</a>
          </li>
          <li class="list-group-item">
            <b><i class="fas fa-map-marker-alt mr-1"></i> Address</b>
            <span class="float-right">@Html.DisplayFor(model => model.Customer!.Address)</span>
          </li>
        </ul>

        <div class="row">
          <div class="col-6">
            <a asp-page="./Edit" asp-route-id="@Model.Customer?.Id" class="btn btn-warning btn-block">
              <i class="fas fa-edit"></i> Edit
            </a>
          </div>
          <div class="col-6">
            <a asp-page="./Delete" asp-route-id="@Model.Customer?.Id" class="btn btn-danger btn-block">
              <i class="fas fa-trash"></i> Delete
            </a>
          </div>
        </div>
      </div>
      <!-- /.card-body -->
    </div>
    <!-- /.card -->
  </div>
  <!-- /.col -->
  
  <div class="col-md-4">
    <!-- Recent Orders -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Recent Orders</h3>
      </div>
      <!-- /.card-header -->
      <div class="card-body">
        @if (Model.Customer?.Orders?.Any() == true)
        {
          <ul class="list-unstyled">
            @foreach (var order in Model.Customer.Orders.Take(5))
            {
              <li class="media mb-3">
                <div class="media-body">
                  <h6 class="mt-0 mb-1">Order #@order.Id</h6>
                  <small class="text-muted">@order.Date.ToString("MMM dd, yyyy")</small>
                  <div class="float-right">
                    <span class="badge @(order.Status == "Completed" ? "badge-success" : order.Status == "Pending" ? "badge-warning" : "badge-info")">
                      @order.Status
                    </span>
                  </div>
                  <br>
                  <strong>$@order.TotalAmount</strong>
                </div>
              </li>
            }
          </ul>
        }
        else
        {
          <p class="text-muted">No orders found for this customer.</p>
        }
      </div>
      <!-- /.card-body -->
    </div>
    <!-- /.card -->

    <!-- Quick Actions -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Quick Actions</h3>
      </div>
      <div class="card-body">
        <a href="#" class="btn btn-primary btn-block">
          <i class="fas fa-plus"></i> New Order
        </a>
        <a href="mailto:@Model.Customer?.Email" class="btn btn-info btn-block">
          <i class="fas fa-envelope"></i> Send Email
        </a>
        <a href="tel:@Model.Customer?.Contact" class="btn btn-success btn-block">
          <i class="fas fa-phone"></i> Call Customer
        </a>
      </div>
    </div>
  </div>
  <!-- /.col -->
</div>
<!-- /.row -->

<div class="row">
  <div class="col-12">
    <div class="card-footer">
      <a asp-page="./Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back to List
      </a>
      <a asp-page="./Edit" asp-route-id="@Model.Customer?.Id" class="btn btn-warning">
        <i class="fas fa-edit"></i> Edit Customer
      </a>
    </div>
  </div>
</div>
