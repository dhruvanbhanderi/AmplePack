@model IEnumerable<AmplePack.Models.CustomerProduct>
@{
    ViewData["Title"] = "Customer Products";
}

<!-- Content Header -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Customer Products</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                    <li class="breadcrumb-item active">Customer Products</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        
        <!-- Stats Row -->
        <div class="row">
            <div class="col-lg-3 col-6">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3>@ViewBag.TotalProducts</h3>
                        <p>Total Products</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-cube"></i>
                    </div>
                    <a asp-action="Create" class="small-box-footer">
                        Add New Product <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3>@ViewBag.ActiveProducts</h3>
                        <p>Active Products</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <a href="#" class="small-box-footer">
                        View Active <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3>@ViewBag.TotalCustomers</h3>
                        <p>Customers</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <a asp-controller="Customers" asp-action="Index" class="small-box-footer">
                        View Customers <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-danger">
                    <div class="inner">
                        <h3>@ViewBag.UniqueCategories</h3>
                        <p>Categories</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-tags"></i>
                    </div>
                    <a href="#" class="small-box-footer">
                        View Categories <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Filter Row -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-filter mr-2"></i>
                            Product Filters
                        </h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <form method="get" class="row">
                            <div class="col-md-3 mb-3">
                                <label for="customerId" class="form-label">Customer</label>
                                <select name="customerId" id="customerId" class="form-control">
                                    <option value="">All Customers</option>
                                    @foreach (var customer in ViewBag.Customers as List<AmplePack.Models.Customer>)
                                    {
                                        <option value="@customer.Id">@customer.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="category" class="form-label">Category</label>
                                <select name="category" id="category" class="form-control">
                                    <option value="">All Categories</option>
                                    @foreach (var category in ViewBag.Categories as List<string>)
                                    {
                                        <option value="@category">@category</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="searchTerm" class="form-label">Search</label>
                                <input type="text" name="searchTerm" id="searchTerm" class="form-control" 
                                       placeholder="Product name...">
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">&nbsp;</label>
                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-search mr-1"></i>
                                        Filter
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                                        <i class="fas fa-times mr-1"></i>
                                        Clear
                                    </a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Products Table -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-cubes mr-2"></i>
                            Customer Product Catalog
                        </h3>
                        <div class="card-tools">
                            <a asp-action="Create" class="btn btn-primary btn-sm">
                                <i class="fas fa-plus mr-1"></i>
                                Add Product
                            </a>
                            <button type="button" class="btn btn-success btn-sm ml-1" onclick="bulkImport()">
                                <i class="fas fa-upload mr-1"></i>
                                Bulk Import
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="customerProductsTable" class="table table-bordered table-striped data-table">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Customer</th>
                                        <th>Category</th>
                                        <th>Unit Price</th>
                                        <th>Packaging</th>
                                        <th>Status</th>
                                        <th class="no-sort" style="width: 150px">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Any())
                                    {
                                        @foreach (var product in Model)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="d-flex flex-column">
                                                        <strong>@product.ProductName</strong>
                                                        <small class="text-muted">ID: #CP@product.Id.ToString("D3")</small>
                                                        <small class="text-muted">@(string.IsNullOrEmpty(product.Description) ? "No description" : product.Description)</small>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="d-flex flex-column">
                                                        <strong>@(product.Customer?.Name ?? "Unknown Customer")</strong>
                                                        <small class="text-muted">@(product.Customer?.Email ?? "")</small>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge badge-info">@(string.IsNullOrEmpty(product.Category) ? "Uncategorized" : product.Category)</span>
                                                </td>
                                                <td class="currency">@AmplePack.Helpers.CurrencyHelper.FormatCurrency(product.PricePerBox)</td>
                                                <td>
                                                    <div class="d-flex flex-column">
                                                        <span class="badge badge-secondary">Box</span>
                                                        <small class="text-muted mt-1">@product.Length×@product.Width×@product.Height cm</small>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="status-badge @(product.IsActive ? "status-completed" : "status-cancelled")">
                                                        <i class="fas @(product.IsActive ? "fa-check" : "fa-times") mr-1"></i>
                                                        @(product.IsActive ? "Active" : "Inactive")
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="btn-group">
                                                        <button type="button" class="btn btn-default btn-sm dropdown-toggle" 
                                                                data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                            <i class="fas fa-cog"></i>
                                                            Actions
                                                        </button>
                                                        <div class="dropdown-menu dropdown-menu-right">
                                                            <a class="dropdown-item" asp-action="Details" asp-route-id="@product.Id">
                                                                <i class="fas fa-eye mr-2"></i>
                                                                View Details
                                                            </a>
                                                            <a class="dropdown-item" asp-action="Edit" asp-route-id="@product.Id">
                                                                <i class="fas fa-edit mr-2"></i>
                                                                Edit Product
                                                            </a>
                                                            <div class="dropdown-divider"></div>
                                                            <a class="dropdown-item" asp-controller="Orders" asp-action="CreateWorkflow" asp-route-customerId="@(product.Customer?.Id ?? 0)">
                                                                <i class="fas fa-shopping-cart mr-2"></i>
                                                                Create Order for @(product.Customer?.Name ?? "Customer")
                                                            </a>
                                                            <a class="dropdown-item" href="javascript:void(0)" 
                                                               onclick="duplicateProduct(@product.Id)">
                                                                <i class="fas fa-copy mr-2"></i>
                                                                Duplicate Product
                                                            </a>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center text-muted py-4">
                                                <i class="fas fa-cube fa-3x mb-3"></i>
                                                <br>
                                                No customer products found. <a asp-action="Create">Add your first product</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <!-- DataTables & Plugins -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap4.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap4.min.js"></script>
    
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        $(document).ready(function() {
            // Initialize DataTable
            $('#customerProductsTable').DataTable({
                responsive: true,
                autoWidth: false,
                pageLength: 25,
                order: [[0, 'asc']],
                columnDefs: [
                    { orderable: false, targets: [6] }, // Actions column
                    { responsivePriority: 1, targets: 0 }, // Product name
                    { responsivePriority: 2, targets: 1 }, // Customer
                    { responsivePriority: 3, targets: 6 }  // Actions
                ],
                language: {
                    search: "Search products:",
                    lengthMenu: "Show _MENU_ products per page",
                    info: "Showing _START_ to _END_ of _TOTAL_ products",
                    emptyTable: "No customer products found",
                    zeroRecords: "No matching products found"
                }
            });
        });

        // Customer product management functions
        function createOrderWithProduct(customerId, customerProductId) {
            window.location.href = `/Orders/CreateWorkflow?customerId=${customerId}&productId=${customerProductId}`;
        }

        function duplicateProduct(customerProductId) {
            Swal.fire({
                title: 'Duplicate Product',
                text: 'Do you want to create a copy of this product?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, duplicate it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = `/CustomerProducts/Duplicate/${customerProductId}`;
                }
            });
        }

        function bulkImport() {
            Swal.fire({
                title: 'Bulk Import',
                text: 'Bulk import feature will be available soon!',
                icon: 'info'
            });
        }

        function confirmDelete(customerProductId, productName) {
            Swal.fire({
                title: 'Delete Product?',
                text: `Are you sure you want to delete "${productName}"? This action cannot be undone.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = `/CustomerProducts/Delete/${customerProductId}`;
                }
            });
        }
    </script>
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap4.min.css">
    
    <style>
        .gap-2 {
            gap: 0.5rem;
        }
        
        .d-flex.gap-2 > * {
            margin-right: 0.5rem;
        }
        
        .d-flex.gap-2 > *:last-child {
            margin-right: 0;
        }
        
        .status-completed {
            background-color: #d1e7dd;
            color: #0f5132;
            border: 1px solid #badbcc;
        }
        
        .status-cancelled {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
    </style>
}

@Html.AntiForgeryToken()@Html.AntiForgeryToken()