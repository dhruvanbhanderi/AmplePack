@model List<AmplePack.Models.Customer>
@{
    ViewData["Title"] = "Customer Products";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Customer Products</h1>
            </div>
            <div class="col-sm-6">
                <div class="float-sm-right">
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Add New Product
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        @if (Model.Any())
        {
            <div class="row">
                @foreach (var customer in Model)
                {
                    <div class="col-lg-6 col-md-6 mb-4">
                        <div class="card card-outline card-primary">
                            <div class="card-header">
                                <h5 class="card-title mb-0">
                                    <i class="fas fa-user mr-2"></i>
                                    @customer.Name
                                </h5>
                                <div class="card-tools">
                                    <span class="badge badge-primary">
                                        @customer.CustomerProducts.Count() products
                                    </span>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-8">
                                        <p class="mb-1"><strong>Email:</strong> @customer.Email</p>
                                        <p class="mb-1"><strong>Contact:</strong> @customer.Contact</p>
                                        <p class="mb-3"><strong>Products:</strong> @customer.CustomerProducts.Count() items</p>
                                    </div>
                                    <div class="col-md-4 text-right">
                                        @if (customer.CustomerProducts.Any())
                                        {
                                            <div class="small text-muted">
                                                Active: @customer.CustomerProducts.Count(p => p.IsActive)<br>
                                                Total: @customer.CustomerProducts.Count()
                                            </div>
                                        }
                                    </div>
                                </div>
                                
                                @if (customer.CustomerProducts.Any())
                                {
                                    <div class="mb-3">
                                        <h6>Recent Products:</h6>
                                        @foreach (var product in customer.CustomerProducts.Take(3))
                                        {
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="small">@product.ProductName</span>
                                                <span class="badge badge-@(product.IsActive ? "success" : "secondary") badge-sm">
                                                    @(product.IsActive ? "Active" : "Inactive")
                                                </span>
                                            </div>
                                        }
                                        @if (customer.CustomerProducts.Count() > 3)
                                        {
                                            <small class="text-muted">... and @(customer.CustomerProducts.Count() - 3) more</small>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="card-footer">
                                <div class="row">
                                    <div class="col-6">
                                        <a href="@Url.Action("Index", new { customerId = customer.Id })" class="btn btn-info btn-sm btn-block">
                                            <i class="fas fa-eye"></i> View Products
                                        </a>
                                    </div>
                                    <div class="col-6">
                                        <a href="@Url.Action("Create", new { customerId = customer.Id })" class="btn btn-success btn-sm btn-block">
                                            <i class="fas fa-plus"></i> Add Product
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="text-center py-5">
                                <i class="fas fa-users fa-3x text-muted mb-3"></i>
                                <h4>No Customers Found</h4>
                                <p class="text-muted">You need to add customers first before creating products.</p>
                                <a asp-controller="Customers" asp-action="Create" class="btn btn-primary">
                                    <i class="fas fa-user-plus"></i> Add First Customer
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>