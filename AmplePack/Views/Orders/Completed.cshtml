@model IEnumerable<AmplePack.Models.Order>
@{
    ViewData["Title"] = "Completed Orders";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">
                    <i class="fas fa-check-circle mr-2 text-success"></i>
                    Completed Orders
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">Dashboard</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-controller="Orders" asp-action="Index">Orders</a>
                    </li>
                    <li class="breadcrumb-item active">Completed</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <!-- Completed Orders Statistics -->
        <div class="row mb-4">
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="info-box">
                    <span class="info-box-icon bg-success">
                        <i class="fas fa-check-circle"></i>
                    </span>
                    <div class="info-box-content">
                        <span class="info-box-text">Total Completed</span>
                        <span class="info-box-number">@ViewBag.TotalCompletedOrders</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="info-box">
                    <span class="info-box-icon bg-primary">
                        <i class="fas fa-rupee-sign"></i>
                    </span>
                    <div class="info-box-content">
                        <span class="info-box-text">Total Revenue</span>
                        <span class="info-box-number">@AmplePack.Helpers.CurrencyHelper.FormatCurrency((decimal)ViewBag.TotalRevenue)</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="info-box">
                    <span class="info-box-icon bg-info">
                        <i class="fas fa-chart-line"></i>
                    </span>
                    <div class="info-box-content">
                        <span class="info-box-text">Avg Order Value</span>
                        <span class="info-box-number">@AmplePack.Helpers.CurrencyHelper.FormatCurrency((decimal)ViewBag.AverageOrderValue)</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="info-box">
                    <span class="info-box-icon bg-warning">
                        <i class="fas fa-calendar-month"></i>
                    </span>
                    <div class="info-box-content">
                        <span class="info-box-text">This Month</span>
                        <span class="info-box-number">@ViewBag.ThisMonthCompleted</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filters -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-filter mr-2"></i>
                            Search & Filter Completed Orders
                        </h3>
                        <div class="card-tools">
                            <a asp-controller="Reports" asp-action="Export" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-file-export mr-1"></i>
                                Export Report
                            </a>
                        </div>
                    </div>
                    <div class="card-body orders-filters">
                        <form method="get" id="completedFilterForm">
                            <div class="row">
                                <div class="col-lg-4 col-md-6 mb-2">
                                    <label for="customerFilter" class="form-label">Customer</label>
                                    <select name="customerFilter" id="customerFilter" class="form-control">
                                        <option value="">All Customers</option>
                                        @foreach (var customer in (IEnumerable<dynamic>)ViewBag.Customers)
                                        {
                                            <option value="@customer.Id" selected="@(ViewBag.CustomerFilter?.ToString() == customer.Id.ToString())">
                                                @customer.Name
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="col-lg-3 col-md-6 mb-2">
                                    <label for="startDate" class="form-label">From Date</label>
                                    <input type="date" name="startDate" id="startDate" class="form-control" 
                                           value="@ViewBag.StartDate">
                                </div>
                                <div class="col-lg-3 col-md-6 mb-2">
                                    <label for="endDate" class="form-label">To Date</label>
                                    <input type="date" name="endDate" id="endDate" class="form-control" 
                                           value="@ViewBag.EndDate">
                                </div>
                                <div class="col-lg-2 col-md-12 mb-2">
                                    <label class="form-label">&nbsp;</label>
                                    <div class="btn-group d-block">
                                        <button type="submit" class="btn btn-success btn-block">
                                            <i class="fas fa-search mr-1"></i>Filter
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-12">
                                    <div class="btn-group">
                                        <a href="@Url.Action("Completed")" class="btn btn-outline-secondary btn-sm">
                                            <i class="fas fa-times mr-1"></i>Clear Filters
                                        </a>
                                        <button type="button" class="btn btn-outline-info btn-sm" onclick="setDateRange('thisMonth')">
                                            This Month
                                        </button>
                                        <button type="button" class="btn btn-outline-info btn-sm" onclick="setDateRange('lastMonth')">
                                            Last Month
                                        </button>
                                        <button type="button" class="btn btn-outline-info btn-sm" onclick="setDateRange('thisYear')">
                                            This Year
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Completed Orders Table -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-check-circle mr-2"></i>
                    Completed Orders List
                </h3>
                <div class="card-tools">
                    <span class="badge badge-success">@Model.Count() completed orders</span>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover orders-table">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Customer</th>
                                <th>Completed Date</th>
                                <th class="items-column">Items</th>
                                <th>Total Amount</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>#@order.Id</strong>
                                    </td>
                                    <td class="customer-info">
                                        <div>
                                            <strong>@order.Customer?.Name</strong>
                                            <small>@order.Customer?.Email</small>
                                        </div>
                                    </td>
                                    <td>
                                        <span>@order.Date.ToString("dd MMM yyyy")</span>
                                        <small class="d-block text-muted">@order.Date.ToString("HH:mm")</small>
                                    </td>
                                    <td class="items-column">
                                        @if (order.OrderDetails.Any())
                                        {
                                            var firstItem = order.OrderDetails.First();
                                            <span class="items-badge completed-orders-badge">
                                                @firstItem.BoxType (@firstItem.Quantity)
                                            </span>
                                            @if (order.OrderDetails.Count > 1)
                                            {
                                                <div class="items-more">
                                                    +@(order.OrderDetails.Count - 1) more items
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">No items</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="currency">@AmplePack.Helpers.CurrencyHelper.FormatCurrency(order.TotalAmount)</span>
                                    </td>
                                    <td>
                                        <span class="completed-status">
                                            <i class="fas fa-check mr-1"></i>@order.Status
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="#" onclick="generateInvoice(@order.Id)" class="btn btn-sm btn-outline-success" title="Download Invoice">
                                                <i class="fas fa-file-invoice"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="reorderOrder(@order.Id)" title="Reorder">
                                                <i class="fas fa-redo"></i>
                                            </button>
                                            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-warning" onclick="changeOrderStatus(@order.Id, '@order.Status')" title="Change Status">
                                                    <i class="fas fa-exchange-alt"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                
                @if (!Model.Any())
                {
                    <div class="p-4 text-center">
                        <i class="fas fa-clipboard-check fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">No Completed Orders Found</h5>
                        <p class="text-muted">No completed orders match your current filter criteria.</p>
                        <a href="@Url.Action("Completed")" class="btn btn-outline-primary">
                            <i class="fas fa-refresh mr-2"></i>Clear Filters
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function setDateRange(range) {
            const now = new Date();
            let startDate, endDate;

            switch(range) {
                case 'thisMonth':
                    startDate = new Date(now.getFullYear(), now.getMonth(), 1);
                    endDate = new Date(now.getFullYear(), now.getMonth() + 1, 0);
                    break;
                case 'lastMonth':
                    startDate = new Date(now.getFullYear(), now.getMonth() - 1, 1);
                    endDate = new Date(now.getFullYear(), now.getMonth(), 0);
                    break;
                case 'thisYear':
                    startDate = new Date(now.getFullYear(), 0, 1);
                    endDate = new Date(now.getFullYear(), 11, 31);
                    break;
            }

            if (startDate && endDate) {
                document.getElementById('startDate').value = startDate.toISOString().substr(0, 10);
                document.getElementById('endDate').value = endDate.toISOString().substr(0, 10);
            }
        }

        function generateInvoice(orderId) {
            window.open(`/Orders/GenerateInvoice/${orderId}`, '_blank');
        }

        function reorderOrder(orderId) {
            if (confirm('Are you sure you want to create a new order based on this completed order?')) {
                fetch(`/Orders/Reorder/${orderId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        window.location.href = `/Orders/Edit/${data.newOrderId}`;
                    } else {
                        alert('Failed to create reorder: ' + data.message);
                    }
                })
                .catch(error => {
                    alert('Error creating reorder: ' + error.message);
                });
            }
        }

        function changeOrderStatus(orderId, currentStatus) {
            // Create a modal for status change
            const statusOptions = ['Pending', 'Processing', 'Completed', 'Delivered', 'Cancelled'];
            let optionsHtml = statusOptions.map(status => 
                `<option value="${status}" ${status === currentStatus ? 'selected' : ''}>${status}</option>`
            ).join('');

            const modalHtml = `
                <div class="modal fade" id="statusChangeModal" tabindex="-1">
                    <div class="modal-dialog modal-sm">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Change Order Status</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label for="newStatus" class="form-label">Select New Status:</label>
                                    <select id="newStatus" class="form-control">
                                        ${optionsHtml}
                                    </select>
                                </div>
                                <div class="alert alert-warning">
                                    <small><i class="fas fa-exclamation-triangle mr-1"></i>
                                    Changing from <strong>${currentStatus}</strong> status. Are you sure?</small>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="button" class="btn btn-warning" onclick="updateOrderStatus(${orderId})">Update Status</button>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            // Remove existing modal if any
            $('#statusChangeModal').remove();
            
            // Add modal to body and show
            $('body').append(modalHtml);
            $('#statusChangeModal').modal('show');
        }

        function updateOrderStatus(orderId) {
            const newStatus = $('#newStatus').val();
            const button = $('.modal-footer .btn-warning');
            
            // Show loading state
            button.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i>Updating...');

            fetch(`/Orders/ChangeStatus/${orderId}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val(),
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ status: newStatus })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    $('#statusChangeModal').modal('hide');
                    showToast(data.message, 'success');
                    // Reload page after a short delay
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showToast('Failed to change status: ' + data.message, 'danger');
                }
            })
            .catch(error => {
                showToast('Error changing status: ' + error.message, 'danger');
            })
            .finally(() => {
                button.prop('disabled', false).html('Update Status');
            });
        }

        function showToast(message, type) {
            const toastHtml = `
                <div class="toast align-items-center text-white bg-${type} border-0" role="alert" style="min-width: 300px;">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-triangle'} mr-2"></i>
                            ${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;
            
            // Create toast container if it doesn't exist
            if (!$('.toast-container').length) {
                $('body').append('<div class="toast-container position-fixed top-0 end-0 p-3"></div>');
            }
            
            $('.toast-container').append(toastHtml);
            $('.toast:last').toast('show');
            
            // Auto remove after 5 seconds
            setTimeout(() => {
                $('.toast:first').remove();
            }, 5000);
        }
    </script>
}

@Html.AntiForgeryToken()