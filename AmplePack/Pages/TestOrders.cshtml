@page
@model AmplePack.Pages.TestOrdersModel
@{
    ViewData["Title"] = "Orders Test";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Orders CRUD Test</h3>
            </div>
            <div class="card-body">
                <div class="alert @(Model.Status.StartsWith("?") ? "alert-success" : "alert-danger")">
                    @Model.Status
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <h5>Test Actions</h5>
                        <form method="post" asp-page-handler="CreateTestOrder" class="mb-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-plus"></i> Create Test Order
                            </button>
                        </form>
                        
                        <a asp-page="/Orders/Create" class="btn btn-success">
                            <i class="fas fa-shopping-cart"></i> Create Real Order
                        </a>
                        <a asp-page="/Orders/Index" class="btn btn-info">
                            <i class="fas fa-list"></i> View All Orders
                        </a>
                    </div>
                    <div class="col-md-6">
                        <h5>Recent Orders</h5>
                        @if (Model.Orders.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Customer</th>
                                            <th>Date</th>
                                            <th>Status</th>
                                            <th>Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var order in Model.Orders.Take(5))
                                        {
                                            <tr>
                                                <td>@order.Id</td>
                                                <td>@order.Customer?.Name</td>
                                                <td>@order.Date.ToString("MM/dd/yyyy")</td>
                                                <td>
                                                    <span class="badge @(order.Status == "Completed" ? "badge-success" : order.Status == "Pending" ? "badge-warning" : "badge-info")">
                                                        @order.Status
                                                    </span>
                                                </td>
                                                <td>$@order.TotalAmount</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No orders found.</p>
                        }
                    </div>
                </div>

                <div class="mt-3">
                    <h5>Available Customers (@Model.Customers.Count)</h5>
                    @if (Model.Customers.Any())
                    {
                        <div class="row">
                            @foreach (var customer in Model.Customers.Take(6))
                            {
                                <div class="col-md-4 mb-2">
                                    <div class="card card-outline card-primary">
                                        <div class="card-body p-2">
                                            <strong>@customer.Name</strong><br>
                                            <small class="text-muted">ID: @customer.Id</small>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i>
                            No customers found. <a asp-page="/Customers/Create" class="alert-link">Create a customer first</a> to test orders.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>