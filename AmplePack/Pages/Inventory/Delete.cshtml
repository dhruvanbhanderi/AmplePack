@page
@model AmplePack.Pages_Inventory.DeleteModel
@{
    ViewData["Title"] = "Delete Inventory Item";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="row">
  <div class="col-md-8 offset-md-2">
    <div class="card card-danger">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fas fa-exclamation-triangle"></i> Delete Inventory Item
        </h3>
      </div>
      <div class="card-body">
        <div class="alert alert-warning">
          <h5><i class="icon fas fa-exclamation-triangle"></i> Warning!</h5>
          Are you sure you want to delete this inventory item? This action cannot be undone.
        </div>

        <div class="row">
          <div class="col-md-4 text-center">
            <i class="fas fa-box text-primary" style="font-size: 4rem;"></i>
          </div>
          <div class="col-md-8">
            <table class="table table-borderless">
              <tr>
                <th>Item ID:</th>
                <td>@Html.DisplayFor(model => model.Inventory!.Id)</td>
              </tr>
              <tr>
                <th>Item Name:</th>
                <td>@Html.DisplayFor(model => model.Inventory!.ItemName)</td>
              </tr>
              <tr>
                <th>Current Stock:</th>
                <td>
                  <span class="badge @(Model.Inventory!.Quantity > Model.Inventory.ReorderLevel ? "badge-success" : Model.Inventory.Quantity > 0 ? "badge-warning" : "badge-danger")">
                    @Html.DisplayFor(model => model.Inventory!.Quantity) @Html.DisplayFor(model => model.Inventory!.Unit)
                  </span>
                </td>
              </tr>
              <tr>
                <th>Unit:</th>
                <td>@Html.DisplayFor(model => model.Inventory!.Unit)</td>
              </tr>
              <tr>
                <th>Reorder Level:</th>
                <td>@Html.DisplayFor(model => model.Inventory!.ReorderLevel) @Html.DisplayFor(model => model.Inventory!.Unit)</td>
              </tr>
              <tr>
                <th>Status:</th>
                <td>
                  @if (Model.Inventory.Quantity > Model.Inventory.ReorderLevel)
                  {
                    <span class="badge badge-success">Well Stocked</span>
                  }
                  else if (Model.Inventory.Quantity > 0)
                  {
                    <span class="badge badge-warning">Low Stock</span>
                  }
                  else
                  {
                    <span class="badge badge-danger">Out of Stock</span>
                  }
                </td>
              </tr>
            </table>
          </div>
        </div>

        @if (Model.Inventory.Quantity > 0)
        {
          <div class="alert alert-info">
            <i class="fas fa-info-circle"></i>
            <strong>Note:</strong> This item currently has @Model.Inventory.Quantity @Model.Inventory.Unit in stock. 
            Deleting this item will permanently remove all stock records.
          </div>
        }
      </div>
      <div class="card-footer">
        <form method="post">
          <input type="hidden" asp-for="Inventory!.Id" />
          <button type="submit" class="btn btn-danger">
            <i class="fas fa-trash"></i> Yes, Delete Item
          </button>
          <a asp-page="./Index" class="btn btn-secondary">
            <i class="fas fa-times"></i> Cancel
          </a>
          <a asp-page="./Details" asp-route-id="@Model.Inventory?.Id" class="btn btn-info">
            <i class="fas fa-eye"></i> View Details
          </a>
        </form>
      </div>
    </div>
  </div>
</div>