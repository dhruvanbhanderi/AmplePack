<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AmplePack</title>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <!-- AdminLTE CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(User.Identity?.IsAuthenticated == true ? "hold-transition sidebar-mini layout-fixed" : "hold-transition login-page")">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="wrapper">
            <!-- Navbar -->
            <nav class="main-header navbar navbar-expand navbar-white navbar-light">
                <!-- Left navbar links -->
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                    </li>
                    <li class="nav-item d-none d-sm-inline-block">
                        <a asp-controller="Home" asp-action="Index" class="nav-link">Home</a>
                    </li>
                </ul>

                <!-- Right navbar links -->
                <ul class="navbar-nav ml-auto">
                    <!-- User Dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-user"></i>
                            @if (User.Identity?.Name != null)
                            {
                                @User.Identity.Name
                            }
                        </a>
                        <div class="dropdown-menu dropdown-menu-end">
                            @if (User.IsInRole("Admin"))
                            {
                                <a class="dropdown-item" asp-controller="UserManagement" asp-action="Index">
                                    <i class="fas fa-users-cog me-2"></i>Manage Users
                                </a>
                                <div class="dropdown-divider"></div>
                            }
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="dropdown-item">
                                    <i class="fas fa-sign-out-alt me-2"></i>Logout
                                </button>
                            </form>
                        </div>
                    </li>
                    
                    <li class="nav-item">
                        <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                            <i class="fas fa-expand-arrows-alt"></i>
                        </a>
                    </li>
                </ul>
            </nav>

            <!-- Main Sidebar Container -->
            <aside class="main-sidebar sidebar-dark-primary elevation-4">
                <!-- Brand Logo -->
                <a asp-controller="Home" asp-action="Index" class="brand-link">
                    <i class="fas fa-box brand-image" style="opacity: .8; font-size: 1.8rem; margin-right: 0.5rem; color: white;"></i>
                    <span class="brand-text font-weight-light">AmplePack</span>
                </a>

                <!-- Sidebar -->
                <div class="sidebar">
                    <!-- Sidebar user panel -->
                    <div class="user-panel mt-3 pb-3 mb-3 d-flex">
                        <div class="image">
                            <i class="fas fa-user-circle fa-2x text-white"></i>
                        </div>
                        <div class="info">
                            <a href="#" class="d-block text-white">
                                @if (User.Identity?.Name != null)
                                {
                                    @User.Identity.Name
                                }
                            </a>
                        </div>
                    </div>

                    <!-- Sidebar Menu -->
                    <nav class="mt-2">
                        <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                            <li class="nav-item">
                                <a asp-controller="Home" asp-action="Index" class="nav-link">
                                    <i class="nav-icon fas fa-tachometer-alt"></i>
                                    <p>Dashboard</p>
                                </a>
                            </li>
                            
                            <li class="nav-item">
                                <a asp-controller="Orders" asp-action="Index" class="nav-link">
                                    <i class="nav-icon fas fa-shopping-cart"></i>
                                    <p>Orders</p>
                                </a>
                            </li>
                            
                            <li class="nav-item">
                                <a asp-controller="Customers" asp-action="Index" class="nav-link">
                                    <i class="nav-icon fas fa-users"></i>
                                    <p>Customers</p>
                                </a>
                            </li>
                            
                            <li class="nav-item">
                                <a asp-controller="Inventory" asp-action="Index" class="nav-link">
                                    <i class="nav-icon fas fa-boxes"></i>
                                    <p>Inventory</p>
                                </a>
                            </li>
                            
                            <li class="nav-item">
                                <a asp-controller="CustomerProducts" asp-action="Index" class="nav-link">
                                    <i class="nav-icon fas fa-cube"></i>
                                    <p>Customer Products</p>
                                </a>
                            </li>
                            
                            <li class="nav-item">
                                <a asp-controller="Reports" asp-action="Index" class="nav-link">
                                    <i class="nav-icon fas fa-chart-bar"></i>
                                    <p>Reports</p>
                                </a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-header">ADMINISTRATION</li>
                                <li class="nav-item">
                                    <a asp-controller="UserManagement" asp-action="Index" class="nav-link">
                                        <i class="nav-icon fas fa-users-cog"></i>
                                        <p>User Management</p>
                                    </a>
                                </li>
                            }
                            
                            <li class="nav-header">USER</li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="nav-link">
                                    <button type="submit" class="btn btn-link text-left p-0 text-white" style="text-decoration: none;">
                                        <i class="nav-icon fas fa-sign-out-alt"></i>
                                        <p>Logout</p>
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </nav>
                </div>
            </aside>

            <!-- Content Wrapper -->
            <div class="content-wrapper">
                @RenderBody()
            </div>

            <!-- Footer -->
            <footer class="main-footer">
                <strong>Copyright &copy; 2025 <a href="#">AmplePack</a>.</strong>
                All rights reserved.
                <div class="float-right d-none d-sm-inline-block">
                    <b>Version</b> 1.0.0
                </div>
            </footer>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
