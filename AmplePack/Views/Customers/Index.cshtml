@model List<AmplePack.Models.Customer>
@{
    ViewData["Title"] = "Customer Management";
}

<!-- Add CSS for Actions dropdown -->
<style>
    /* Ensure Actions column is visible */
    .table th:last-child,
    .table td:last-child {
        min-width: 200px !important;
        white-space: nowrap;
    }
    
    /* Dropdown styling */
    .btn-group {
        position: relative;
        display: inline-block;
    }
    
    .dropdown-menu {
        position: absolute;
        top: 100%;
        left: 0;
        z-index: 1000;
        display: none;
        min-width: 200px;
        padding: 0.5rem 0;
        margin: 0.125rem 0 0;
        font-size: 0.875rem;
        color: #212529;
        background-color: #fff;
        background-clip: padding-box;
        border: 1px solid rgba(0,0,0,.15);
        border-radius: 0.25rem;
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,.175);
    }
    
    .dropdown-menu.show {
        display: block;
    }
    
    .dropdown-item {
        display: block;
        width: 100%;
        padding: 0.375rem 1rem;
        clear: both;
        font-weight: 400;
        color: #212529;
        text-align: inherit;
        text-decoration: none;
        white-space: nowrap;
        background-color: transparent;
        border: 0;
    }
    
    .dropdown-item:hover,
    .dropdown-item:focus {
        color: #16181b;
        background-color: #f8f9fa;
        text-decoration: none;
    }
    
    .dropdown-divider {
        height: 0;
        margin: 0.5rem 0;
        overflow: hidden;
        border-top: 1px solid #e9ecef;
    }
    
    /* Button group styling */
    .btn-group .btn {
        margin-right: 2px;
    }
    
    .btn-group .btn:last-child {
        margin-right: 0;
    }
    
    /* Table responsiveness */
    .table-responsive {
        overflow-x: auto;
    }
</style>

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Customer Management</h1>
            </div>
            <div class="col-sm-6">
                <div class="float-sm-right">
                    <a asp-action="Create" class="btn btn-success">
                        <i class="fas fa-user-plus"></i> Add New Customer
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-users mr-2"></i>
                            Customer Directory
                        </h3>
                    </div>
                    <div class="card-body">
                        @if (Model.Any())
                        {
                            <div class="table-responsive">
                                <table id="customersTable" class="table table-bordered table-hover table-striped">
                                    <thead class="thead-dark">
                                        <tr>
                                            <th>Name</th>
                                            <th>Contact</th>
                                            <th>Email</th>
                                            <th>Address</th>
                                            <th>Orders</th>
                                            <th>Products</th>
                                            <th style="min-width: 200px;">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var customer in Model)
                                        {
                                            <tr>
                                                <td>
                                                    <div>
                                                        <strong>@customer.Name</strong>
                                                        <br>
                                                        <small class="text-muted">ID: #@customer.Id</small>
                                                    </div>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(customer.Contact))
                                                    {
                                                        <span class="badge badge-info">@customer.Contact</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No contact</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(customer.Email))
                                                    {
                                                        <a href="mailto:@customer.Email" class="text-primary">
                                                            <i class="fas fa-envelope mr-1"></i>@customer.Email
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No email</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(customer.Address))
                                                    {
                                                        <small>@customer.Address</small>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No address</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge badge-primary">
                                                        @customer.Orders.Count orders
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="badge badge-secondary">
                                                        @customer.CustomerProducts.Count products
                                                    </span>
                                                </td>
                                                <td>
                                                    <!-- Option 1: Bootstrap Dropdown -->
                                                    <div class="btn-group" style="display: inline-block;">
                                                        <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                                            <i class="fas fa-cog mr-1"></i> Actions
                                                        </button>
                                                        <ul class="dropdown-menu">
                                                            <li>
                                                                <a class="dropdown-item" asp-action="Details" asp-route-id="@customer.Id">
                                                                    <i class="fas fa-eye mr-2"></i>View Details
                                                                </a>
                                                            </li>
                                                            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                                            {
                                                                <li>
                                                                    <a class="dropdown-item" asp-action="Edit" asp-route-id="@customer.Id">
                                                                        <i class="fas fa-edit mr-2"></i>Edit Customer
                                                                    </a>
                                                                </li>
                                                            }
                                                            <li><hr class="dropdown-divider"></li>
                                                            <li>
                                                                <a class="dropdown-item" asp-controller="Orders" asp-action="CreateWorkflow" asp-route-customerId="@customer.Id">
                                                                    <i class="fas fa-plus mr-2"></i>Create Order
                                                                </a>
                                                            </li>
                                                            <li>
                                                                <a class="dropdown-item" asp-controller="CustomerProducts" asp-action="Create" asp-route-customerId="@customer.Id">
                                                                    <i class="fas fa-cube mr-2"></i>Add Product
                                                                </a>
                                                            </li>
                                                            @if (User.IsInRole("Admin"))
                                                            {
                                                                <li><hr class="dropdown-divider"></li>
                                                                <li>
                                                                    <a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@customer.Id">
                                                                        <i class="fas fa-trash mr-2"></i>Delete Customer
                                                                    </a>
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                
                                                    <!-- Option 2: Button Group (Fallback) -->
                                                    <div class="btn-group btn-group-sm d-none" role="group" style="margin-left: 5px;">
                                                        <a href="@Url.Action("Details", new { id = customer.Id })" class="btn btn-outline-info" title="View Details">
                                                            <i class="fas fa-eye"></i>
                                                        </a>
                                                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                                        {
                                                            <a href="@Url.Action("Edit", new { id = customer.Id })" class="btn btn-outline-warning" title="Edit">
                                                                <i class="fas fa-edit"></i>
                                                            </a>
                                                        }
                                                        <a href="@Url.Action("CreateWorkflow", "Orders", new { customerId = customer.Id })" class="btn btn-outline-success" title="Create Order">
                                                            <i class="fas fa-plus"></i>
                                                        </a>
                                                        @if (User.IsInRole("Admin"))
                                                        {
                                                            <a href="@Url.Action("Delete", new { id = customer.Id })" class="btn btn-outline-danger" title="Delete">
                                                                <i class="fas fa-trash"></i>
                                                            </a>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-users fa-3x text-muted mb-3"></i>
                                <h4>No Customers Found</h4>
                                <p class="text-muted">Get started by adding your first customer.</p>
                                <a asp-action="Create" class="btn btn-success">
                                    <i class="fas fa-user-plus"></i> Add First Customer
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.4/css/dataTables.bootstrap4.min.css">
    <script src="https://cdn.datatables.net/1.11.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.4/js/dataTables.bootstrap4.min.js"></script>
    
    <script>
        $(document).ready(function() {
            // Initialize DataTables
            $('#customersTable').DataTable({
                "responsive": true,
                "lengthChange": true,
                "autoWidth": false,
                "pageLength": 25,
                "order": [[ 0, "asc" ]],
                "columnDefs": [
                    { "orderable": false, "targets": 6 }, // Actions column
                    { "width": "200px", "targets": 6 }    // Fixed width for Actions
                ],
                "language": {
                    "search": "Search customers:",
                    "lengthMenu": "Show _MENU_ customers per page",
                    "info": "Showing _START_ to _END_ of _TOTAL_ customers"
                }
            });
            
            // Debug: Check if dropdowns are working
            console.log('Customer table loaded. Checking dropdown functionality...');
            
            // Fallback: If Bootstrap dropdown fails, show button group
            setTimeout(function() {
                $('.dropdown-toggle').each(function() {
                    var $this = $(this);
                    $this.on('click', function(e) {
                        e.preventDefault();
                        var $menu = $this.next('.dropdown-menu');
                        if ($menu.is(':visible')) {
                            $menu.hide();
                        } else {
                            $('.dropdown-menu').hide(); // Hide all other dropdowns
                            $menu.show();
                        }
                    });
                });
                
                // Close dropdown when clicking outside
                $(document).on('click', function(e) {
                    if (!$(e.target).closest('.btn-group').length) {
                        $('.dropdown-menu').hide();
                    }
                });
            }, 500);
        });
    </script>
}