                                                    <td class="text-right">Rs.@Model.Result.Quantities["3000"].Printing.ToString("F4")</td>
                                                </tr>
                                                <tr>
                                                    <td><i class="fas fa-paint-brush mr-2"></i><strong>Lamination</strong></td>
