@page
@model AmplePack.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="row">
  <!-- Small boxes (Stat box) -->
  <div class="col-lg-3 col-6">
    <!-- small box -->
    <div class="small-box bg-info">
      <div class="inner">
        <h3>@Model.TotalOrders</h3>
        <p>Total Orders</p>
      </div>
      <div class="icon">
        <i class="ion ion-bag"></i>
      </div>
      <a asp-page="/Orders/Index" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
    </div>
  </div>
  <!-- ./col -->
  <div class="col-lg-3 col-6">
    <!-- small box -->
    <div class="small-box bg-success">
      <div class="inner">
        <h3>@Model.TotalCustomers</h3>
        <p>Total Customers</p>
      </div>
      <div class="icon">
        <i class="ion ion-person-add"></i>
      </div>
      <a asp-page="/Customers/Index" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
    </div>
  </div>
  <!-- ./col -->
  <div class="col-lg-3 col-6">
    <!-- small box -->
    <div class="small-box bg-warning">
      <div class="inner">
        <h3>@Model.LowStockItems</h3>
        <p>Low Stock Items</p>
      </div>
      <div class="icon">
        <i class="ion ion-stats-bars"></i>
      </div>
      <a asp-page="/Inventory/Index" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
    </div>
  </div>
  <!-- ./col -->
  <div class="col-lg-3 col-6">
    <!-- small box -->
    <div class="small-box bg-danger">
      <div class="inner">
        <h3>$@Model.TotalRevenue</h3>
        <p>Total Revenue</p>
      </div>
      <div class="icon">
        <i class="ion ion-pie-graph"></i>
      </div>
      <a href="#" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
    </div>
  </div>
  <!-- ./col -->
</div>
<!-- /.row -->

<!-- Main row -->
<div class="row">
  <!-- Left col -->
  <section class="col-lg-7 connectedSortable">
    <!-- Recent Orders -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fas fa-shopping-cart mr-1"></i>
          Recent Orders
        </h3>
      </div><!-- /.card-header -->
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-sm">
            <thead>
              <tr>
                <th>Order ID</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Status</th>
                <th>Amount</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var order in Model.RecentOrders)
              {
                <tr>
                  <td>#@order.Id</td>
                  <td>@order.Customer?.Name</td>
                  <td>@order.Date.ToString("MMM dd")</td>
                  <td>
                    <span class="badge @(order.Status == "Completed" ? "badge-success" : order.Status == "Pending" ? "badge-warning" : "badge-info")">
                      @order.Status
                    </span>
                  </td>
                  <td>$@order.TotalAmount</td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </div><!-- /.card-body -->
    </div>
    <!-- /.card -->

    <!-- Low Stock Alert -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fas fa-exclamation-triangle mr-1"></i>
          Low Stock Alert
        </h3>
      </div>
      <div class="card-body">
        @if (Model.LowStockInventory.Any())
        {
          <div class="table-responsive">
            <table class="table table-sm">
              <thead>
                <tr>
                  <th>Item</th>
                  <th>Current Stock</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                @foreach (var item in Model.LowStockInventory)
                {
                  <tr>
                    <td>@item.ItemName</td>
                    <td>@item.Quantity</td>
                    <td>
                      <span class="badge @(item.Quantity > 20 ? "badge-warning" : "badge-danger")">
                        @(item.Quantity > 20 ? "Low Stock" : "Very Low")
                      </span>
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        }
        else
        {
          <p class="text-muted">All items are well stocked!</p>
        }
      </div>
    </div>
  </section>
  <!-- /.Left col -->
  
  <!-- right col (We are only adding the ID to make the widgets sortable)-->
  <section class="col-lg-5 connectedSortable">
    <!-- Map card -->
    <div class="card bg-gradient-primary">
      <div class="card-header border-0">
        <h3 class="card-title">
          <i class="fas fa-map-marker-alt mr-1"></i>
          Quick Actions
        </h3>
        <!-- card tools -->
        <div class="card-tools">
          <button type="button" class="btn btn-primary btn-sm" data-card-widget="collapse" title="Collapse">
            <i class="fas fa-minus"></i>
          </button>
        </div>
        <!-- /.card-tools -->
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-6">
            <a asp-page="/Orders/Create" class="btn btn-success btn-block">
              <i class="fas fa-plus"></i> New Order
            </a>
          </div>
          <div class="col-6">
            <a asp-page="/Customers/Create" class="btn btn-info btn-block">
              <i class="fas fa-user-plus"></i> New Customer
            </a>
          </div>
        </div>
        <div class="row mt-2">
          <div class="col-6">
            <a asp-page="/Inventory/Create" class="btn btn-warning btn-block">
              <i class="fas fa-boxes"></i> Add Item
            </a>
          </div>
          <div class="col-6">
            <a asp-page="/Orders/Index" class="btn btn-secondary btn-block">
              <i class="fas fa-list"></i> View Orders
            </a>
          </div>
        </div>
      </div>
      <!-- /.card-body-->
    </div>
    <!-- /.card -->

    <!-- Order Status Chart -->
    <div class="card bg-gradient-success">
      <div class="card-header border-0">
        <h3 class="card-title">
          <i class="far fa-chart-bar"></i>
          Order Status
        </h3>
        <div class="card-tools">
          <button type="button" class="btn btn-success btn-sm" data-card-widget="collapse">
            <i class="fas fa-minus"></i>
          </button>
        </div>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-6">
            <div class="description-block border-right">
              <span class="description-percentage text-success">
                <i class="fas fa-caret-up"></i> @Model.CompletedOrders
              </span>
              <h5 class="description-header">Completed</h5>
              <span class="description-text">ORDERS</span>
            </div>
          </div>
          <div class="col-6">
            <div class="description-block">
              <span class="description-percentage text-warning">
                <i class="fas fa-caret-left"></i> @Model.PendingOrders
              </span>
              <h5 class="description-header">Pending</h5>
              <span class="description-text">ORDERS</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- /.card -->
  </section>
  <!-- right col -->
</div>
<!-- /.row (main row) -->
