@page
@model AmplePack.Pages_Reports.IndexModel
@{
    ViewData["Title"] = "Reports Dashboard";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<style>
    /* Fix scrolling and layout issues */
    .content-wrapper {
        overflow-x: hidden !important;
    }
    
    .chart-container {
        overflow: hidden;
    }
    
    .chart-wrapper {
        overflow: hidden;
    }
    
    .chart-wrapper canvas {
        max-width: 100% !important;
        height: auto !important;
    }
    
    /* Prevent horizontal scrolling */
    .row {
        margin-left: -7.5px;
        margin-right: -7.5px;
    }
    
    .row > [class*="col-"] {
        padding-left: 7.5px;
        padding-right: 7.5px;
    }
    
    /* Fix table scrolling */
    .table-responsive {
        border: none;
    }
    
    /* Sticky header for tables */
    .sticky-top {
        position: sticky;
        top: 0;
        z-index: 10;
        background-color: #f8f9fa;
    }
    
    /* Info box improvements */
    .info-box {
        min-height: 80px;
        margin-bottom: 0;
    }
    
    .info-box-content {
        padding: 10px 10px 10px 15px;
    }
    
    .info-box-number {
        font-size: 1.3rem;
        font-weight: 700;
    }
    
    .info-box-text {
        font-size: 0.875rem;
        text-transform: uppercase;
        font-weight: 600;
    }
    
    /* Card height consistency */
    .h-100 {
        height: 100% !important;
    }
    
    /* Smooth scrolling only for content areas */
    .card-body {
        scroll-behavior: smooth;
    }
    
    /* Prevent chart overflow */
    #revenueChart {
        max-width: 100% !important;
        max-height: 100% !important;
    }
    
    /* Progress groups styling */
    .progress-group {
        margin-bottom: 15px;
    }
    
    .progress {
        height: 8px;
    }
</style>

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Reports Dashboard</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <!-- Sales Summary Cards -->
        <div class="row mb-3">
            <div class="col-lg-3 col-md-6 col-sm-6 mb-2">
                <div class="info-box">
                    <span class="info-box-icon bg-info">
                        <i class="fas fa-dollar-sign"></i>
                    </span>
                    <div class="info-box-content">
                        <span class="info-box-text">Total Revenue</span>
                        <span class="info-box-number">$@Model.TotalRevenue.ToString("N0")</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-6 mb-2">
                <div class="info-box">
                    <span class="info-box-icon bg-success">
                        <i class="fas fa-chart-line"></i>
                    </span>
                    <div class="info-box-content">
                        <span class="info-box-text">Monthly Revenue</span>
                        <span class="info-box-number">$@Model.MonthlyRevenue.ToString("N0")</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-6 mb-2">
                <div class="info-box">
                    <span class="info-box-icon bg-warning">
                        <i class="fas fa-shopping-cart"></i>
                    </span>
                    <div class="info-box-content">
                        <span class="info-box-text">Orders This Month</span>
                        <span class="info-box-number">@Model.TotalOrdersThisMonth</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-6 mb-2">
                <div class="info-box">
                    <span class="info-box-icon bg-primary">
                        <i class="fas fa-users"></i>
                    </span>
                    <div class="info-box-content">
                        <span class="info-box-text">Total Customers</span>
                        <span class="info-box-number">@Model.TotalCustomers</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Row -->
        <div class="row mb-3">
            <!-- Monthly Revenue Chart -->
            <div class="col-lg-8 mb-3">
                <div class="card h-100">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-chart-area mr-2"></i>
                            Monthly Revenue Trend
                        </h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body chart-container">
                        <div class="chart-wrapper" style="position: relative; height: 280px; max-height: 280px;">
                            <canvas id="revenueChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Status Distribution -->
            <div class="col-lg-4 mb-3">
                <div class="card h-100">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-chart-pie mr-2"></i>
                            Order Status
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="progress-group">
                            Completed Orders
                            <span class="float-right"><b>@Model.CompletedOrders</b>/@(Model.CompletedOrders + Model.PendingOrders + Model.ProcessingOrders + Model.CancelledOrders)</span>
                            <div class="progress progress-sm">
                                <div class="progress-bar bg-success" style="width: @(Model.CompletedOrders > 0 ? (Model.CompletedOrders * 100.0 / (Model.CompletedOrders + Model.PendingOrders + Model.ProcessingOrders + Model.CancelledOrders)) : 0)%"></div>
                            </div>
                        </div>
                        <div class="progress-group">
                            Processing Orders
                            <span class="float-right"><b>@Model.ProcessingOrders</b>/@(Model.CompletedOrders + Model.PendingOrders + Model.ProcessingOrders + Model.CancelledOrders)</span>
                            <div class="progress progress-sm">
                                <div class="progress-bar bg-info" style="width: @(Model.ProcessingOrders > 0 ? (Model.ProcessingOrders * 100.0 / (Model.CompletedOrders + Model.PendingOrders + Model.ProcessingOrders + Model.CancelledOrders)) : 0)%"></div>
                            </div>
                        </div>
                        <div class="progress-group">
                            Pending Orders
                            <span class="float-right"><b>@Model.PendingOrders</b>/@(Model.CompletedOrders + Model.PendingOrders + Model.ProcessingOrders + Model.CancelledOrders)</span>
                            <div class="progress progress-sm">
                                <div class="progress-bar bg-warning" style="width: @(Model.PendingOrders > 0 ? (Model.PendingOrders * 100.0 / (Model.CompletedOrders + Model.PendingOrders + Model.ProcessingOrders + Model.CancelledOrders)) : 0)%"></div>
                            </div>
                        </div>
                        <div class="progress-group">
                            Cancelled Orders
                            <span class="float-right"><b>@Model.CancelledOrders</b>/@(Model.CompletedOrders + Model.PendingOrders + Model.ProcessingOrders + Model.CancelledOrders)</span>
                            <div class="progress progress-sm">
                                <div class="progress-bar bg-danger" style="width: @(Model.CancelledOrders > 0 ? (Model.CancelledOrders * 100.0 / (Model.CompletedOrders + Model.PendingOrders + Model.ProcessingOrders + Model.CancelledOrders)) : 0)%"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Detailed Reports Row -->
        <div class="row mb-3">
            <!-- Top Customers -->
            <div class="col-lg-6 mb-3">
                <div class="card h-100">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-trophy mr-2"></i>
                            Top Customers by Revenue
                        </h3>
                    </div>
                    <div class="card-body p-0" style="max-height: 350px; overflow-y: auto;">
                        @if (Model.TopCustomers.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-striped mb-0">
                                    <thead class="thead-light sticky-top">
                                        <tr>
                                            <th>Customer</th>
                                            <th>Orders</th>
                                            <th>Revenue</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var customer in Model.TopCustomers)
                                        {
                                            <tr>
                                                <td>
                                                    <a asp-page="/Customers/Details" asp-route-id="@customer.Id" class="text-decoration-none">
                                                        <strong>@customer.Name</strong>
                                                        <br><small class="text-muted">@customer.Email</small>
                                                    </a>
                                                </td>
                                                <td>
                                                    <span class="badge badge-primary">@customer.Orders.Count()</span>
                                                </td>
                                                <td>
                                                    <strong class="text-success">$@customer.Orders.Where(o => o.Status == "Completed").Sum(o => o.TotalAmount).ToString("N0")</strong>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <p class="text-muted mb-0">No customer data available</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Critical Stock Items -->
            <div class="col-lg-6 mb-3">
                <div class="card h-100">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-exclamation-triangle mr-2 text-warning"></i>
                            Critical Stock Items
                        </h3>
                        <div class="card-tools">
                            <span class="badge badge-danger">@Model.LowStockCount items need attention</span>
                        </div>
                    </div>
                    <div class="card-body p-0" style="max-height: 350px; overflow-y: auto;">
                        @if (Model.CriticalStockItems.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-striped mb-0">
                                    <thead class="thead-light sticky-top">
                                        <tr>
                                            <th>Item</th>
                                            <th>Stock</th>
                                            <th>Reorder</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.CriticalStockItems)
                                        {
                                            <tr class="table-warning">
                                                <td>
                                                    <a asp-page="/Inventory/Details" asp-route-id="@item.Id" class="text-decoration-none">
                                                        <strong>@item.ProductName</strong>
                                                        <br><small class="text-muted">@item.ItemName</small>
                                                    </a>
                                                </td>
                                                <td>
                                                    <span class="badge badge-warning">
                                                        @item.AvailableQuantity.ToString("N0") @item.Unit
                                                    </span>
                                                </td>
                                                <td>@item.ReorderLevel.ToString("N0") @item.Unit</td>
                                                <td>
                                                    <span class="badge @(item.AvailableQuantity > 0 ? "badge-warning" : "badge-danger")">
                                                        @(item.AvailableQuantity > 0 ? "Low" : "Out")
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="fas fa-check-circle fa-2x text-success mb-2"></i>
                                <p class="text-success mb-0">All items well stocked!</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Export Options -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-download mr-2"></i>
                            Export Reports
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3 mb-2">
                                <button type="button" class="btn btn-success btn-block" onclick="exportReport('excel')">
                                    <i class="fas fa-file-excel"></i> Export to Excel
                                </button>
                            </div>
                            <div class="col-md-3 mb-2">
                                <button type="button" class="btn btn-danger btn-block" onclick="exportReport('pdf')">
                                    <i class="fas fa-file-pdf"></i> Export to PDF
                                </button>
                            </div>
                            <div class="col-md-3 mb-2">
                                <button type="button" class="btn btn-info btn-block" onclick="exportReport('csv')">
                                    <i class="fas fa-file-csv"></i> Export to CSV
                                </button>
                            </div>
                            <div class="col-md-3 mb-2">
                                <button type="button" class="btn btn-secondary btn-block" onclick="window.print()">
                                    <i class="fas fa-print"></i> Print Report
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
            // Prevent automatic scrolling
            $('html, body').css({
                'scroll-behavior': 'auto',
                'overflow-x': 'hidden'
            });
            
            // Initialize charts after DOM is ready
            initializeChart();
        });
        
        function initializeChart() {
            // Revenue Chart
            var revenueChartCanvas = document.getElementById('revenueChart');
            if (revenueChartCanvas) {
                var revenueChart = new Chart(revenueChartCanvas, {
                    type: 'line',
                    data: {
                        labels: [@Html.Raw(string.Join(",", Model.MonthlyRevenueChart.Select(m => $"'{m.Month}'"))),
                        datasets: [{
                            label: 'Revenue ($)',
                            data: [@string.Join(",", Model.MonthlyRevenueChart.Select(m => m.Revenue.ToString("F2"))),
                            borderColor: '#007bff',
                            backgroundColor: 'rgba(0, 123, 255, 0.1)',
                            borderWidth: 2,
                            tension: 0.1,
                            fill: true,
                            pointBackgroundColor: '#007bff',
                            pointBorderColor: '#fff',
                            pointBorderWidth: 2,
                            pointRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            intersect: false,
                            mode: 'index'
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: {
                                    color: 'rgba(0,0,0,0.1)'
                                },
                                ticks: {
                                    callback: function(value) {
                                        return '$' + value.toLocaleString();
                                    }
                                }
                            },
                            x: {
                                grid: {
                                    color: 'rgba(0,0,0,0.1)'
                                }
                            }
                        },
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                backgroundColor: 'rgba(0,0,0,0.8)',
                                titleColor: '#fff',
                                bodyColor: '#fff',
                                callbacks: {
                                    label: function(context) {
                                        return 'Revenue: $' + context.parsed.y.toLocaleString();
                                    }
                                }
                            }
                        }
                    });
                }
            }
        }

        function exportReport(format) {
            // Show loading state
            const button = event.target;
            const originalText = button.innerHTML;
            button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Exporting...';
            button.disabled = true;
            
            // Simulate export process
            setTimeout(function() {
                alert('Export to ' + format.toUpperCase() + ' functionality would be implemented here');
                button.innerHTML = originalText;
                button.disabled = false;
            }, 2000);
        }
    </script>
}