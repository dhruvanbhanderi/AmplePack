@{
    ViewData["Title"] = "Customer Products";
    var customer = ViewBag.SelectedCustomer as AmplePack.Models.Customer;
    var products = ViewBag.CustomerProducts as List<AmplePack.Models.CustomerProduct>;
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Products for @customer?.Name</h1>
            </div>
            <div class="col-sm-6">
                <div class="float-sm-right">
                    <a href="@Url.Action("Create", new { customerId = customer?.Id })" class="btn btn-success">
                        <i class="fas fa-plus"></i> Add Product
                    </a>
                    <a href="@Url.Action("Index")" class="btn btn-secondary ml-2">
                        <i class="fas fa-arrow-left"></i> Back to Customers
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <!-- Customer Info Card -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="card card-outline card-info">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-8">
                                <h5 class="mb-1">@customer?.Name</h5>
                                <p class="mb-1"><strong>Email:</strong> @customer?.Email</p>
                                <p class="mb-0"><strong>Contact:</strong> @customer?.Contact</p>
                            </div>
                            <div class="col-md-4 text-right">
                                <div class="info-box-content">
                                    <span class="info-box-text">Total Products</span>
                                    <span class="info-box-number">@(products?.Count ?? 0)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Search Bar -->
        <div class="row mb-3">
            <div class="col-md-6">
                <form method="get" asp-action="Index">
                    <input type="hidden" name="customerId" value="@customer?.Id" />
                    <div class="input-group">
                        <input type="text" name="searchTerm" class="form-control" placeholder="Search products..." value="@ViewBag.SearchTerm">
                        <div class="input-group-append">
                            <button class="btn btn-outline-secondary" type="submit">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Products Grid -->
        @if (products != null && products.Any())
        {
            <div class="row">
                @foreach (var product in products)
                {
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="card h-100 @(product.IsActive ? "card-outline-success" : "card-outline-secondary")">
                            <div class="card-header">
                                <h6 class="card-title mb-0">@product.ProductName</h6>
                                <div class="card-tools">
                                    <span class="badge badge-@(product.IsActive ? "success" : "secondary")">
                                        @(product.IsActive ? "Active" : "Inactive")
                                    </span>
                                </div>
                            </div>
                            <div class="card-body">
                                <p><strong>Size:</strong> @product.SizeDisplay</p>
                                <p><strong>Price:</strong> <span class="text-success font-weight-bold">$@product.PricePerBox.ToString("N2")</span></p>
                                <p><strong>Specifications:</strong><br>
                                   <small class="text-muted">@product.SpecificationDisplay</small>
                                </p>
                                @if (!string.IsNullOrEmpty(product.Description))
                                {
                                    <p><strong>Description:</strong><br>
                                       <small>@product.Description</small>
                                    </p>
                                }
                                
                                <div class="row mt-2">
                                    <div class="col-6">
                                        <small class="text-muted">
                                            <i class="fas fa-tag"></i> @product.Category
                                        </small>
                                    </div>
                                    <div class="col-6 text-right">
                                        <small class="text-muted">
                                            <i class="fas fa-shopping-cart"></i> @product.TotalOrdersCount orders
                                        </small>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer">
                                <div class="btn-group w-100" role="group">
                                    <a href="@Url.Action("Details", new { id = product.Id })" class="btn btn-sm btn-outline-info">
                                        <i class="fas fa-eye"></i> Details
                                    </a>
                                    <a href="@Url.Action("Edit", new { id = product.Id })" class="btn btn-sm btn-outline-warning">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = product.Id })" class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash"></i> Delete
                                    </a>
                                </div>
                                <div class="mt-2">
                                    <a href="@Url.Action("CreateWorkflow", "Orders", new { customerId = customer?.Id, productId = product.Id })" class="btn btn-success btn-sm btn-block">
                                        <i class="fas fa-plus"></i> Create Order
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="text-center py-5">
                                <i class="fas fa-cube fa-3x text-muted mb-3"></i>
                                <h4>No Products Found</h4>
                                @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
                                {
                                    <p class="text-muted">No products match your search criteria.</p>
                                    <a href="@Url.Action("Index", new { customerId = customer?.Id })" class="btn btn-secondary">
                                        <i class="fas fa-times"></i> Clear Search
                                    </a>
                                }
                                else
                                {
                                    <p class="text-muted">This customer doesn't have any products yet.</p>
                                    <a href="@Url.Action("Create", new { customerId = customer?.Id })" class="btn btn-primary">
                                        <i class="fas fa-plus"></i> Create First Product
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>