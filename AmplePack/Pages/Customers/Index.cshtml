@page
@model AmplePack.Pages_Customers.IndexModel
@{
    ViewData["Title"] = "Customers";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Customer Management</h3>
        <div class="card-tools">
          <a asp-page="Create" class="btn btn-primary">
            <i class="fas fa-user-plus"></i> New Customer
          </a>
        </div>
      </div>
      <!-- /.card-header -->
      <div class="card-body">
        <table id="customersTable" class="table table-bordered table-hover">
          <thead>
          <tr>
            <th>@Html.DisplayNameFor(model => model.Customer[0].Id)</th>
            <th>@Html.DisplayNameFor(model => model.Customer[0].Name)</th>
            <th>@Html.DisplayNameFor(model => model.Customer[0].Email)</th>
            <th>@Html.DisplayNameFor(model => model.Customer[0].Contact)</th>
            <th>@Html.DisplayNameFor(model => model.Customer[0].Address)</th>
            <th>Actions</th>
          </tr>
          </thead>
          <tbody>
          @foreach (var item in Model.Customer) {
              <tr>
                  <td>@Html.DisplayFor(modelItem => item.Id)</td>
                  <td>
                    <div class="d-flex align-items-center">
                      <div class="user-panel-img mr-2">
                        <img src="https://adminlte.io/themes/v3/dist/img/user2-160x160.jpg" class="img-circle elevation-1" alt="User Image" style="width: 30px; height: 30px;">
                      </div>
                      <div>
                        <strong>@Html.DisplayFor(modelItem => item.Name)</strong>
                      </div>
                    </div>
                  </td>
                  <td>
                    <a href="mailto:@item.Email" class="text-muted">
                      <i class="fas fa-envelope mr-1"></i>@Html.DisplayFor(modelItem => item.Email)
                    </a>
                  </td>
                  <td>
                    <a href="tel:@item.Contact" class="text-muted">
                      <i class="fas fa-phone mr-1"></i>@Html.DisplayFor(modelItem => item.Contact)
                    </a>
                  </td>
                  <td>
                    <i class="fas fa-map-marker-alt mr-1 text-muted"></i>
                    @Html.DisplayFor(modelItem => item.Address)
                  </td>
                  <td>
                    <div class="btn-group">
                      <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary" title="Edit">
                        <i class="fas fa-edit"></i>
                      </a>
                      <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Details">
                        <i class="fas fa-eye"></i>
                      </a>
                      <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Delete">
                        <i class="fas fa-trash"></i>
                      </a>
                    </div>
                  </td>
              </tr>
          }
          </tbody>
          <tfoot>
          <tr>
            <th>Customer ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Contact</th>
            <th>Address</th>
            <th>Actions</th>
          </tr>
          </tfoot>
        </table>
      </div>
      <!-- /.card-body -->
    </div>
    <!-- /.card -->
  </div>
  <!-- /.col -->
</div>
<!-- /.row -->

@section Scripts {
  <!-- DataTables  & Plugins -->
  <script src="https://cdn.datatables.net/1.11.4/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.11.4/js/dataTables.bootstrap4.min.js"></script>
  <script>
    $(function () {
      $("#customersTable").DataTable({
        "responsive": true, 
        "lengthChange": false, 
        "autoWidth": false,
        "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"]
      }).buttons().container().appendTo('#customersTable_wrapper .col-md-6:eq(0)');
    });
  </script>
}
