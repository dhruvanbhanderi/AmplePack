@model AmplePack.Models.OrderDetailInput
@{
    ViewData["Title"] = "Create Order - Workflow";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Create New Order</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <form method="post" asp-action="CreateWorkflow">
            <div class="row">
                <!-- Customer Selection -->
                <div class="col-lg-4">
                    <div class="card card-primary">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-user mr-2"></i>
                                Step 1: Select Customer
                            </h3>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label asp-for="CustomerId" class="control-label">Customer *</label>
                                <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-control" id="customerSelect">
                                    <option value="">-- Select Customer --</option>
                                </select>
                                <span asp-validation-for="CustomerId" class="text-danger"></span>
                            </div>
                            
                            <div id="customerInfo" class="customer-info" style="display: none;">
                                <div class="alert alert-info">
                                    <h6><i class="fas fa-info-circle"></i> Customer Details</h6>
                                    <div id="customerDetails"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Product Selection -->
                <div class="col-lg-4">
                    <div class="card card-success">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-cube mr-2"></i>
                                Step 2: Select Product
                            </h3>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label for="productSelect" class="control-label">Product Template</label>
                                <select name="CustomerProductId" asp-for="CustomerProductId" class="form-control" id="productSelect" disabled>
                                    <option value="">-- Select Customer First --</option>
                                </select>
                                <small class="form-text text-muted">Choose a saved product template for this customer</small>
                            </div>
                            
                            <div id="productInfo" class="product-info" style="display: none;">
                                <div class="alert alert-success">
                                    <h6><i class="fas fa-check-circle"></i> Product Details</h6>
                                    <div id="productDetails"></div>
                                </div>
                            </div>
                            
                            <div id="noProductsAlert" class="alert alert-warning" style="display: none;">
                                <h6><i class="fas fa-exclamation-triangle"></i> No Products Found</h6>
                                <p class="mb-2">This customer doesn't have any saved product templates.</p>
                                <a href="#" id="createProductLink" class="btn btn-warning btn-sm" target="_blank">
                                    <i class="fas fa-plus"></i> Create Product Template
                                </a>
                                <small class="d-block mt-2 text-muted">You can also create a manual order below without a template.</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Order Details -->
                <div class="col-lg-4">
                    <div class="card card-warning">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-edit mr-2"></i>
                                Step 3: Order Details
                            </h3>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-6">
                                    <div class="form-group">
                                        <label asp-for="Quantity" class="control-label">Quantity *</label>
                                        <input asp-for="Quantity" class="form-control" type="number" min="1" value="1" />
                                        <span asp-validation-for="Quantity" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="form-group">
                                        <label asp-for="PricePerBox" class="control-label">Price per Box (?) *</label>
                                        <input asp-for="PricePerBox" class="form-control" type="number" step="0.01" min="0.01" />
                                        <span asp-validation-for="PricePerBox" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="form-group">
                                <label asp-for="DeliveryDate" class="control-label">Delivery Date</label>
                                <input asp-for="DeliveryDate" class="form-control" type="date" />
                                <span asp-validation-for="DeliveryDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Manual Product Entry (Fallback) -->
            <div class="row mt-3">
                <div class="col-12">
                    <div class="card card-outline card-secondary" id="manualEntryCard">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-tools mr-2"></i>
                                Manual Product Entry (Optional)
                            </h3>
                            <div class="card-tools">
                                <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                    <i class="fas fa-minus"></i>
                                </button>
                            </div>
                        </div>
                        <div class="card-body" style="display: none;">
                            <div class="alert alert-info">
                                <strong>Info:</strong> Use this section if you want to create an order without using a saved product template, or if the customer doesn't have any products yet.
                            </div>
                            
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label asp-for="BoxType" class="control-label">Box Type</label>
                                        <input asp-for="BoxType" class="form-control" placeholder="e.g., Custom Box" />
                                        <span asp-validation-for="BoxType" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label asp-for="Length" class="control-label">Length (cm)</label>
                                        <input asp-for="Length" class="form-control" type="number" step="0.1" min="0.1" />
                                        <span asp-validation-for="Length" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label asp-for="Width" class="control-label">Width (cm)</label>
                                        <input asp-for="Width" class="form-control" type="number" step="0.1" min="0.1" />
                                        <span asp-validation-for="Width" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label asp-for="Height" class="control-label">Height (cm)</label>
                                        <input asp-for="Height" class="form-control" type="number" step="0.1" min="0.1" />
                                        <span asp-validation-for="Height" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label asp-for="GSM" class="control-label">GSM</label>
                                        <select asp-for="GSM" class="form-control">
                                            <option value="">-- Select GSM --</option>
                                            <option value="180">180 GSM</option>
                                            <option value="200">200 GSM</option>
                                            <option value="250">250 GSM</option>
                                            <option value="300">300 GSM</option>
                                            <option value="350">350 GSM</option>
                                        </select>
                                        <span asp-validation-for="GSM" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label asp-for="PaperType" class="control-label">Paper Type</label>
                                        <select asp-for="PaperType" class="form-control">
                                            <option value="">-- Select Paper --</option>
                                            <option value="Corrugated">Corrugated</option>
                                            <option value="Art Paper">Art Paper</option>
                                            <option value="Kraft Paper">Kraft Paper</option>
                                            <option value="Duplex Board">Duplex Board</option>
                                        </select>
                                        <span asp-validation-for="PaperType" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label asp-for="PrintingType" class="control-label">Printing Type</label>
                                        <select asp-for="PrintingType" class="form-control">
                                            <option value="">-- Select Printing --</option>
                                            <option value="No Printing">No Printing</option>
                                            <option value="1 Color">1 Color</option>
                                            <option value="2 Color">2 Color</option>
                                            <option value="4 Color">4 Color</option>
                                            <option value="Full Color">Full Color</option>
                                        </select>
                                        <span asp-validation-for="PrintingType" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label asp-for="Notes" class="control-label">Notes</label>
                                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Any special instructions..."></textarea>
                                        <span asp-validation-for="Notes" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Summary and Submit -->
            <div class="row mt-3">
                <div class="col-12">
                    <div class="card card-info">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-receipt mr-2"></i>
                                Order Summary
                            </h3>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-8">
                                    <div id="orderSummary">
                                        <p class="text-muted">Please select customer and configure order details to see summary.</p>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="order-total">
                                        <h4>Total Amount: <span id="totalAmount" class="text-success">?0.00</span></h4>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fas fa-check"></i> Create Order
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-lg ml-2">
                                <i class="fas fa-arrow-left"></i> Cancel
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            // Auto-expand manual entry if no products available
            $('#customerSelect').change(function() {
                var customerId = $(this).val();
                
                if (!customerId) {
                    $('#productSelect').prop('disabled', true).html('<option value="">-- Select Customer First --</option>');
                    $('#customerInfo, #productInfo, #noProductsAlert').hide();
                    updateOrderSummary();
                    return;
                }
                
                // Update create product link
                $('#createProductLink').attr('href', '@Url.Action("Create", "CustomerProducts")?customerId=' + customerId);
                
                // Load customer details
                loadCustomerDetails(customerId);
                
                // Load customer products
                loadCustomerProducts(customerId);
            });
            
            $('#productSelect').change(function() {
                var productId = $(this).val();
                if (productId) {
                    loadProductDetails(productId);
                } else {
                    $('#productInfo').hide();
                }
                updateOrderSummary();
            });
            
            // Update summary on quantity/price change
            $('#Quantity, #PricePerBox').on('input', function() {
                updateOrderSummary();
            });
            
            function loadCustomerDetails(customerId) {
                $.get('@Url.Action("GetCustomerDetails")', { id: customerId }, function(data) {
                    if (data.success) {
                        $('#customerDetails').html(`
                            <strong>${data.customer.name}</strong><br>
                            <small>Email: ${data.customer.email}</small><br>
                            <small>Contact: ${data.customer.contact}</small>
                        `);
                        $('#customerInfo').show();
                    }
                });
            }
            
            function loadCustomerProducts(customerId) {
                $.get('@Url.Action("GetCustomerProducts")', { customerId: customerId }, function(data) {
                    var options = '<option value="">-- Select Product Template --</option>';
                    
                    if (data.length > 0) {
                        data.forEach(function(product) {
                            options += `<option value="${product.id}">${product.productName} - ?${product.pricePerBox}</option>`;
                        });
                        $('#productSelect').html(options).prop('disabled', false);
                        $('#noProductsAlert').hide();
                    } else {
                        $('#productSelect').html('<option value="">-- No Products Available --</option>').prop('disabled', true);
                        $('#noProductsAlert').show();
                        // Auto-expand manual entry section
                        $('#manualEntryCard .card-body').show();
                        $('#manualEntryCard .card-tools .fas').removeClass('fa-minus').addClass('fa-plus');
                    }
                });
            }
            
            function loadProductDetails(productId) {
                $.get('@Url.Action("GetProductDetails")', { id: productId }, function(data) {
                    if (data.success) {
                        var product = data.product;
                        $('#productDetails').html(`
                            <strong>${product.productName}</strong><br>
                            <small>Size: ${product.length}×${product.width}×${product.height} cm</small><br>
                            <small>Price: ?${product.pricePerBox}</small><br>
                            <small>Default Qty: ${product.defaultQuantity}</small>
                        `);
                        
                        // Auto-fill values
                        $('#Quantity').val(product.defaultQuantity);
                        $('#PricePerBox').val(product.pricePerBox);
                        
                        $('#productInfo').show();
                        updateOrderSummary();
                    }
                });
            }
            
            function updateOrderSummary() {
                var customerId = $('#customerSelect').val();
                var productId = $('#productSelect').val();
                var quantity = parseInt($('#Quantity').val()) || 0;
                var pricePerBox = parseFloat($('#PricePerBox').val()) || 0;
                var totalAmount = quantity * pricePerBox;
                
                $('#totalAmount').text('?' + totalAmount.toFixed(2));
                
                if (customerId && quantity > 0 && pricePerBox > 0) {
                    var customerName = $('#customerSelect option:selected').text();
                    var productName = productId ? $('#productSelect option:selected').text() : 'Manual Entry';
                    
                    $('#orderSummary').html(`
                        <div class="row">
                            <div class="col-md-6">
                                <strong>Customer:</strong> ${customerName}<br>
                                <strong>Product:</strong> ${productName}<br>
                            </div>
                            <div class="col-md-6">
                                <strong>Quantity:</strong> ${quantity} boxes<br>
                                <strong>Price per Box:</strong> ?${pricePerBox.toFixed(2)}<br>
                            </div>
                        </div>
                    `);
                } else {
                    $('#orderSummary').html('<p class="text-muted">Please complete all required fields to see order summary.</p>');
                }
            }
            
            // Initial load if customer is pre-selected
            var initialCustomerId = $('#customerSelect').val();
            if (initialCustomerId) {
                $('#customerSelect').trigger('change');
            }
        });
    </script>
}