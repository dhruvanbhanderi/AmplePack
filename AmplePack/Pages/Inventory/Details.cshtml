@page
@model AmplePack.Pages_Inventory.DetailsModel
@{
    ViewData["Title"] = "Inventory Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="row">
  <div class="col-md-8">
    <!-- Item Information -->
    <div class="card card-primary card-outline">
      <div class="card-body box-profile">
        <div class="text-center">
          <i class="fas fa-box text-primary" style="font-size: 4rem;"></i>
        </div>

        <h3 class="profile-username text-center">@Html.DisplayFor(model => model.Inventory!.ItemName)</h3>

        <p class="text-muted text-center">Item ID: @Html.DisplayFor(model => model.Inventory!.Id)</p>

        <ul class="list-group list-group-unbordered mb-3">
          <li class="list-group-item">
            <b><i class="fas fa-cubes mr-1"></i> Current Stock</b>
            <span class="float-right">
              <span class="badge @(Model.Inventory!.Quantity > 50 ? "badge-success" : Model.Inventory.Quantity > Model.Inventory.ReorderLevel ? "badge-warning" : "badge-danger")">
                @Html.DisplayFor(model => model.Inventory!.Quantity) @Html.DisplayFor(model => model.Inventory!.Unit)
              </span>
            </span>
          </li>
          <li class="list-group-item">
            <b><i class="fas fa-ruler mr-1"></i> Unit</b>
            <span class="float-right">@Html.DisplayFor(model => model.Inventory!.Unit)</span>
          </li>
          <li class="list-group-item">
            <b><i class="fas fa-exclamation-triangle mr-1"></i> Reorder Level</b>
            <span class="float-right">@Html.DisplayFor(model => model.Inventory!.ReorderLevel) @Html.DisplayFor(model => model.Inventory!.Unit)</span>
          </li>
          <li class="list-group-item">
            <b><i class="fas fa-info-circle mr-1"></i> Status</b>
            <span class="float-right">
              @if (Model.Inventory.Quantity > 50)
              {
                <span class="badge badge-success">Well Stocked</span>
              }
              else if (Model.Inventory.Quantity > Model.Inventory.ReorderLevel)
              {
                <span class="badge badge-warning">Low Stock</span>
              }
              else if (Model.Inventory.Quantity > 0)
              {
                <span class="badge badge-danger">Critical Stock</span>
              }
              else
              {
                <span class="badge badge-dark">Out of Stock</span>
              }
            </span>
          </li>
        </ul>

        <div class="row">
          <div class="col-6">
            <a asp-page="./Edit" asp-route-id="@Model.Inventory?.Id" class="btn btn-warning btn-block">
              <i class="fas fa-edit"></i> Edit
            </a>
          </div>
          <div class="col-6">
            <a asp-page="./Delete" asp-route-id="@Model.Inventory?.Id" class="btn btn-danger btn-block">
              <i class="fas fa-trash"></i> Delete
            </a>
          </div>
        </div>
      </div>
      <!-- /.card-body -->
    </div>
    <!-- /.card -->
  </div>
  <!-- /.col -->
  
  <div class="col-md-4">
    <!-- Stock Level Chart -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Stock Level</h3>
      </div>
      <div class="card-body">
        <div class="progress mb-3">
          @{
            var percentage = Model.Inventory!.ReorderLevel > 0 ? 
              Math.Min(100, (double)(Model.Inventory.Quantity / Model.Inventory.ReorderLevel) * 100) : 100;
            var progressClass = percentage > 100 ? "bg-success" : percentage > 50 ? "bg-warning" : "bg-danger";
          }
          <div class="progress-bar @progressClass" role="progressbar" 
               style="width: @Math.Min(100, percentage)%" 
               aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100">
            @percentage.ToString("F0")%
          </div>
        </div>
        <small class="text-muted">
          Current: @Model.Inventory.Quantity / Reorder at: @Model.Inventory.ReorderLevel
        </small>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Quick Actions</h3>
      </div>
      <div class="card-body">
        <button type="button" class="btn btn-success btn-block" data-toggle="modal" data-target="#adjustStockModal">
          <i class="fas fa-plus-minus"></i> Adjust Stock
        </button>
        <button type="button" class="btn btn-info btn-block" onclick="printBarcode()">
          <i class="fas fa-barcode"></i> Print Barcode
        </button>
        <button type="button" class="btn btn-primary btn-block" onclick="createOrder()">
          <i class="fas fa-shopping-cart"></i> Create Order
        </button>
      </div>
    </div>

    <!-- Stock History -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Recent Activity</h3>
      </div>
      <div class="card-body">
        <div class="timeline">
          <div class="time-label">
            <span class="bg-blue">Today</span>
          </div>
          <div>
            <i class="fas fa-plus bg-green"></i>
            <div class="timeline-item">
              <span class="time"><i class="fas fa-clock"></i> 2 hours ago</span>
              <h3 class="timeline-header">Stock Added</h3>
              <div class="timeline-body">
                +25 units added to inventory
              </div>
            </div>
          </div>
          <div>
            <i class="fas fa-minus bg-yellow"></i>
            <div class="timeline-item">
              <span class="time"><i class="fas fa-clock"></i> Yesterday</span>
              <h3 class="timeline-header">Stock Used</h3>
              <div class="timeline-body">
                -10 units used for Order #123
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- /.col -->
</div>
<!-- /.row -->

<!-- Stock Adjustment Modal -->
<div class="modal fade" id="adjustStockModal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h4 class="modal-title">Adjust Stock for @Model.Inventory?.ItemName</h4>
        <button type="button" class="close" data-dismiss="modal">&times;</button>
      </div>
      <div class="modal-body">
        <form id="adjustStockForm">
          <div class="form-group">
            <label>Current Stock: @Model.Inventory?.Quantity @Model.Inventory?.Unit</label>
          </div>
          <div class="form-group">
            <label>Adjustment Type</label>
            <select class="form-control" id="adjustmentType">
              <option value="add">Add Stock</option>
              <option value="remove">Remove Stock</option>
              <option value="set">Set Exact Amount</option>
            </select>
          </div>
          <div class="form-group">
            <label>Quantity</label>
            <input type="number" class="form-control" id="adjustmentQuantity" min="0" step="1" />
          </div>
          <div class="form-group">
            <label>Reason</label>
            <textarea class="form-control" id="adjustmentReason" rows="2" placeholder="Reason for adjustment..."></textarea>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="submitAdjustment()">Apply Adjustment</button>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-12">
    <div class="card-footer">
      <a asp-page="./Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back to List
      </a>
      <a asp-page="./Edit" asp-route-id="@Model.Inventory?.Id" class="btn btn-warning">
        <i class="fas fa-edit"></i> Edit Item
      </a>
    </div>
  </div>
</div>

@section Scripts {
  <script>
    function printBarcode() {
      alert('Barcode printing functionality would be implemented here');
    }

    function createOrder() {
      window.location.href = '/Orders/Create';
    }

    function submitAdjustment() {
      var type = $('#adjustmentType').val();
      var quantity = $('#adjustmentQuantity').val();
      var reason = $('#adjustmentReason').val();
      
      if (!quantity || quantity <= 0) {
        alert('Please enter a valid quantity');
        return;
      }
      
      // This would typically make an AJAX call to update the inventory
      alert('Stock adjustment would be processed here: ' + type + ' ' + quantity + ' units');
      $('#adjustStockModal').modal('hide');
    }
  </script>
}