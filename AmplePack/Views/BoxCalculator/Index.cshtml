</section>

@section Scripts {
    <script src="~/js/BoxLayoutVisualizer.js"></script>
    <script>
        $(document).ready(function() {
            let layoutVisualizer = null;

            // Initialize layout visualizer
            function initializeLayoutVisualizer() {
                if (layoutVisualizer) {
                    return;
                }
                
                try {
                    layoutVisualizer = new BoxLayoutVisualizer('layoutVisualization');
                } catch (error) {
                    console.error('Failed to initialize layout visualizer:', error);
                }
            }

            // Handle mode selection changes
            $('#modeSelect').change(function() {
                var selectedMode = $(this).val();
                if (selectedMode === 'dual-liner') {
                    $('#dualLinerFields').show();
                } else {
                    $('#dualLinerFields').hide();
                }
                updateLayoutVisualization();
            });

            // Handle preset selection
            $('#presetSelect').change(function() {
                var preset = $(this).val();
                if (preset) {
                    loadPreset(preset);
                }
            });

            // Handle sheet size selection
            $('#sheetSizeSelect').change(function() {
                var selectedSize = $(this).val();
                if (selectedSize === 'custom') {
                    $('#customSheetSizeRow').show();
                } else if (selectedSize) {
                    $('#customSheetSizeRow').hide();
                    var dimensions = selectedSize.split('x');
                    if (dimensions.length === 2) {
                        // Store sheet dimensions for visualization
                        window.currentSheetLength = parseFloat(dimensions[0]);
                        window.currentSheetWidth = parseFloat(dimensions[1]);
                        updateLayoutVisualization();
                    }
                } else {
                    $('#customSheetSizeRow').hide();
                    $('#layoutVisualizationSection').hide();
                }
            });

            // Handle custom sheet size changes
            $('#customSheetLength, #customSheetWidth').on('input', function() {
                var length = parseFloat($('#customSheetLength').val());
                var width = parseFloat($('#customSheetWidth').val());
                
                if (!isNaN(length) && !isNaN(width) && length > 0 && width > 0) {
                    window.currentSheetLength = length;
                    window.currentSheetWidth = width;
                    updateLayoutVisualization();
                }
            });

            // Handle box dimension changes
            $('#boxLength, #boxWidth').on('input', function() {
                updateLayoutVisualization();
            });

            // Update layout visualization
            function updateLayoutVisualization() {
                var boxLength = parseFloat($('#boxLength').val());
                var boxWidth = parseFloat($('#boxWidth').val());
                var sheetLength = window.currentSheetLength;
                var sheetWidth = window.currentSheetWidth;

                if (!isNaN(boxLength) && !isNaN(boxWidth) && 
                    !isNaN(sheetLength) && !isNaN(sheetWidth) &&
                    boxLength > 0 && boxWidth > 0 && sheetLength > 0 && sheetWidth > 0) {
                    
                    $('#layoutVisualizationSection').show();
                    initializeLayoutVisualizer();
                    
                    // Calculate layout
                    var layoutData = calculateBoxLayout(sheetLength, sheetWidth, boxLength, boxWidth);
                    
                    // Update the visualization
                    if (layoutVisualizer && layoutData) {
                        layoutVisualizer.updateVisualization(layoutData);
                        $('#boxCountBadge').text(layoutData.totalBlanksPerSheet + ' boxes per sheet');
                    }
                } else {
                    $('#layoutVisualizationSection').hide();
                }
            }

            // Calculate box layout
            function calculateBoxLayout(sheetLength, sheetWidth, boxLength, boxWidth) {
                // Calculate how many boxes fit in each direction
                var blanksPerRow = Math.floor(sheetLength / boxLength);
                var blanksPerColumn = Math.floor(sheetWidth / boxWidth);
                var totalBlanks = blanksPerRow * blanksPerColumn;

                // Calculate waste
                var usedSheetLength = blanksPerRow * boxLength;
                var usedSheetWidth = blanksPerColumn * boxWidth;
                var wasteLength = sheetLength - usedSheetLength;
                var wasteWidth = sheetWidth - usedSheetWidth;
                
                var totalSheetArea = sheetLength * sheetWidth;
                var usedArea = usedSheetLength * usedSheetWidth;
                var wasteArea = totalSheetArea - usedArea;
                var wastePercentage = (wasteArea / totalSheetArea) * 100;
                var efficiencyPercentage = (usedArea / totalSheetArea) * 100;

                // Create blank positions
                var blankPositions = [];
                for (var row = 0; row < blanksPerColumn; row++) {
                    for (var col = 0; col < blanksPerRow; col++) {
                        blankPositions.push({
                            startXPercent: (col * boxLength / sheetLength) * 100,
                            startYPercent: (row * boxWidth / sheetWidth) * 100,
                            widthPercent: (boxLength / sheetLength) * 100,
                            heightPercent: (boxWidth / sheetWidth) * 100
                        });
                    }
                }

                // Create waste areas
                var wasteAreas = [];
                
                // Right waste area
                if (wasteLength > 0.1) {
                    wasteAreas.push({
                        startXPercent: (usedSheetLength / sheetLength) * 100,
                        startYPercent: 0,
                        widthPercent: (wasteLength / sheetLength) * 100,
                        heightPercent: (usedSheetWidth / sheetWidth) * 100
                    });
                }
                
                // Bottom waste area
                if (wasteWidth > 0.1) {
                    wasteAreas.push({
                        startXPercent: 0,
                        startYPercent: (usedSheetWidth / sheetWidth) * 100,
                        widthPercent: 100,
                        heightPercent: (wasteWidth / sheetWidth) * 100
                    });
                }

                return {
                    sheetLengthInches: sheetLength,
                    sheetWidthInches: sheetWidth,
                    sheetLengthMm: sheetLength * 25.4,
                    sheetWidthMm: sheetWidth * 25.4,
                    blankLengthInches: boxLength,
                    blankWidthInches: boxWidth,
                    blankLengthMm: boxLength * 25.4,
                    blankWidthMm: boxWidth * 25.4,
                    blanksPerRow: blanksPerRow,
                    blanksPerColumn: blanksPerColumn,
                    totalBlanksPerSheet: totalBlanks,
                    efficiencyPercentage: efficiencyPercentage,
                    wastePercentage: wastePercentage,
                    blankPositions: blankPositions,
                    wasteAreas: wasteAreas,
                    layoutDescription: `${blanksPerRow} × ${blanksPerColumn} layout (${totalBlanks} boxes per sheet)`
                };
            }

            // Load preset configurations
            function loadPreset(preset) {
                var presets = {
                    'single-liner-default': {
                        mode: 'single-liner',
                        size1: 20, size2: 21,
                        duplex_gsm: 230, duplex_rate: 58,
                        liner_gsm: 360, liner_rate: 43,
                        divide1: 1550, divide2: 1000,
                        printing_rate1: 3000, printing_rate2: 2000, printing_rate3: 2100,
                        qty1: 1000, qty2: 2000, qty3: 3000,
                        lamination_rate: 0.0039, pasting_rate: 0.0013,
                        punching_rate: 0.35, punching_qty: 1,
                        freight_rate: 300,
                        plate_charge: 1000, plate_qty: 1,
                        die_charge: 0, die_qty: 1,
                        pin_rate_no_extras: 0.4, pin_qty_no_extras: 1,
                        box_pes_rate_no_extras: 0, box_pes_qty_no_extras: 0,
                        pin_rate_with_extras: 0.08, pin_qty_with_extras: 3,
                        box_pes_rate_with_extras: 0.07, box_pes_qty_with_extras: 1,
                        apps_divisor: 2, profit_percent: 10
                    },
                    'dual-liner-default': {
                        mode: 'dual-liner',
                        size1: 19, size2: 20,
                        duplex_gsm: 230, duplex_rate: 65,
                        liner_gsm: 290, liner_rate: 43,
                        liner2_gsm: 290, liner2_rate: 43,
                        divide1: 1550, divide2: 1000,
                        punching_rate: 0.4, punching_qty: 1,
                        freight_rate: 0,
                        plate_charge: 1000, plate_qty: 1,
                        die_charge: 1800, die_qty: 1,
                        pin_rate_no_extras: 0.1, pin_qty_no_extras: 3,
                        box_pes_rate_no_extras: 0.07, box_pes_qty_no_extras: 1,
                        pin_rate_with_extras: 0.08, pin_qty_with_extras: 3,
                        box_pes_rate_with_extras: 0.07, box_pes_qty_with_extras: 1,
                        apps_divisor: 1, profit_percent: 10
                    },
                    'economy': {
                        mode: 'single-liner',
                        size1: 15, size2: 18,
                        duplex_gsm: 200, duplex_rate: 50,
                        liner_gsm: 300, liner_rate: 38,
                        divide1: 1550, divide2: 1000,
                        printing_rate1: 2500, printing_rate2: 1800, printing_rate3: 1900,
                        qty1: 1000, qty2: 2000, qty3: 3000,
                        lamination_rate: 0.003, pasting_rate: 0.001,
                        punching_rate: 0.3, punching_qty: 1,
                        freight_rate: 200,
                        plate_charge: 800, plate_qty: 1,
                        die_charge: 0, die_qty: 1,
                        pin_rate_no_extras: 0.35, pin_qty_no_extras: 1,
                        box_pes_rate_no_extras: 0, box_pes_qty_no_extras: 0,
                        pin_rate_with_extras: 0.06, pin_qty_with_extras: 3,
                        box_pes_rate_with_extras: 0.05, box_pes_qty_with_extras: 1,
                        apps_divisor: 2, profit_percent: 8
                    },
                    'premium': {
                        mode: 'dual-liner',
                        size1: 22, size2: 24,
                        duplex_gsm: 250, duplex_rate: 75,
                        liner_gsm: 350, liner_rate: 48,
                        liner2_gsm: 320, liner2_rate: 46,
                        divide1: 1550, divide2: 1000,
                        printing_rate1: 3500, printing_rate2: 4000, printing_rate3: 4200,
                        qty1: 1000, qty2: 2000, qty3: 3000,
                        lamination_rate: 0.65, pasting_rate: 0.32,
                        punching_rate: 0.5, punching_qty: 1,
                        freight_rate: 500,
                        plate_charge: 1500, plate_qty: 1,
                        die_charge: 2500, die_qty: 1,
                        pin_rate_no_extras: 0.12, pin_qty_no_extras: 3,
                        box_pes_rate_no_extras: 0.08, box_pes_qty_no_extras: 1,
                        pin_rate_with_extras: 0.1, pin_qty_with_extras: 3,
                        box_pes_rate_with_extras: 0.08, box_pes_qty_with_extras: 1,
                        apps_divisor: 1, profit_percent: 15
                    }
                };

                if (presets[preset]) {
                    populateForm(presets[preset]);
                    // Show success message
                    toastr.success('Preset configuration has been loaded successfully!', 'Preset Loaded');
                }
            }

            // Populate form with preset data
            function populateForm(data) {
                for (var key in data) {
                    var pascalKey = key.split('_').map(function(word, index) {
                        return word.charAt(0).toUpperCase() + word.slice(1);
                    }).join('');
                    
                    var element = $('[name="Input.' + pascalKey + '"]');
                    if (element.length) {
                        element.val(data[key]);
                    }
                }
                
                // Trigger change events
                $('#modeSelect').trigger('change');
                $('#boxLength, #boxWidth').trigger('input');
            }

            // Initialize based on current mode
            var currentMode = $('#modeSelect').val();
            if (currentMode === 'dual-liner') {
                $('#dualLinerFields').show();
            }

            // Set up accordion chevron rotation
            $('.collapse').on('show.bs.collapse', function () {
                $(this).parent().find('.fa-chevron-down').removeClass('fa-chevron-down').addClass('fa-chevron-up');
            });
            
            $('.collapse').on('hide.bs.collapse', function () {
                $(this).parent().find('.fa-chevron-up').removeClass('fa-chevron-up').addClass('fa-chevron-down');
            });
        });
    </script>
}