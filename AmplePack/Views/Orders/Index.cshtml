@using AmplePack.Helpers
@using AmplePack.ViewModels
@model OrderListViewModel
@{
    ViewData["Title"] = "Orders Management";
    var filter = Model.Filter;
}

<!-- Enhanced Orders Management Header -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">
                    <i class="fas fa-shopping-cart mr-2"></i>
                    Orders Management
                </h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                        <li class="breadcrumb-item active">Orders</li>
                    </ol>
                </nav>
            </div>
            <div class="col-sm-6">
                <div class="float-sm-right">
                    <div class="btn-group">
                        <a asp-action="CreateWorkflow" class="btn btn-primary">
                            <i class="fas fa-plus"></i> New Order
                        </a>
                        <button type="button" class="btn btn-secondary dropdown-toggle dropdown-toggle-split" data-toggle="dropdown">
                            <span class="sr-only">Toggle Dropdown</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-right">
                            <a class="dropdown-item" href="#" onclick="exportOrders('excel')">
                                <i class="fas fa-file-excel mr-2"></i>Export to Excel
                            </a>
                            <a class="dropdown-item" href="#" onclick="exportOrders('pdf')">
                                <i class="fas fa-file-pdf mr-2"></i>Export to PDF
                            </a>
                            <a class="dropdown-item" href="#" onclick="exportOrders('csv')">
                                <i class="fas fa-file-csv mr-2"></i>Export to CSV
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <!-- Enhanced Statistics Dashboard -->
        <div class="row mb-4">
            <div class="col-lg-2 col-md-4 col-6">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3 id="totalOrdersCount">@Model.Stats.TotalOrders</h3>
                        <p>Total Orders</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                </div>
            </div>
            <div class="col-lg-2 col-md-4 col-6">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3 id="pendingOrdersCount">@Model.Stats.PendingOrders</h3>
                        <p>Pending</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-clock"></i>
                    </div>
                </div>
            </div>
            <div class="col-lg-2 col-md-4 col-6">
                <div class="small-box bg-primary">
                    <div class="inner">
                        <h3 id="processingOrdersCount">@Model.Stats.ProcessingOrders</h3>
                        <p>Processing</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-cogs"></i>
                    </div>
                </div>
            </div>
            <div class="col-lg-2 col-md-4 col-6">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3 id="completedOrdersCount">@Model.Stats.CompletedOrders</h3>
                        <p>Completed</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-check-circle"></i>
                    </div>
                </div>
            </div>
            <div class="col-lg-2 col-md-4 col-6">
                <div class="small-box bg-danger">
                    <div class="inner">
                        <h3 id="overdueOrdersCount">@Model.Stats.OverdueOrders</h3>
                        <p>Overdue</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                </div>
            </div>
            <div class="col-lg-2 col-md-4 col-6">
                <div class="small-box bg-dark">
                    <div class="inner">
                        <h3 id="monthlyRevenue">@CurrencyHelper.FormatCurrency(Model.Stats.MonthlyRevenue)</h3>
                        <p>Monthly Revenue</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-money-bill"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Advanced Filters Panel -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="card card-outline card-primary">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-filter mr-2"></i>Advanced Filters
                        </h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <form id="filterForm" method="get" asp-action="Index">
                            <div class="row">
                                <!-- Search Term -->
                                <div class="col-md-3 mb-3">
                                    <label for="searchTerm" class="form-label">Search Orders</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="searchTerm" name="SearchTerm" 
                                               value="@filter.SearchTerm" placeholder="Order ID, Customer, Product...">
                                        <div class="input-group-append">
                                            <span class="input-group-text"><i class="fas fa-search"></i></span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Status Filter -->
                                <div class="col-md-2 mb-3">
                                    <label for="status" class="form-label">Status</label>
                                    <select class="form-control" id="status" name="Status">
                                        <option value="">All Statuses</option>
                                        <option value="Pending" selected="@(filter.Status == "Pending")">Pending</option>
                                        <option value="Processing" selected="@(filter.Status == "Processing")">Processing</option>
                                        <option value="Completed" selected="@(filter.Status == "Completed")">Completed</option>
                                        <option value="Cancelled" selected="@(filter.Status == "Cancelled")">Cancelled</option>
                                    </select>
                                </div>

                                <!-- Customer Filter -->
                                <div class="col-md-3 mb-3">
                                    <label for="customerId" class="form-label">Customer</label>
                                    <select class="form-control" id="customerId" name="CustomerId">
                                        <option value="">All Customers</option>
                                        @foreach (var customer in Model.Customers)
                                        {
                                            <option value="@customer.Id" selected="@(filter.CustomerId == customer.Id)">
                                                @customer.Name
                                            </option>
                                        }
                                    </select>
                                </div>

                                <!-- Date Period Quick Select -->
                                <div class="col-md-2 mb-3">
                                    <label for="datePeriod" class="form-label">Period</label>
                                    <select class="form-control" id="datePeriod" name="DatePeriod">
                                        <option value="">Custom Range</option>
                                        <option value="thismonth" selected="@(filter.DatePeriod == "thismonth")">This Month</option>
                                        <option value="lastmonth" selected="@(filter.DatePeriod == "lastmonth")">Last Month</option>
                                        <option value="thisquarter" selected="@(filter.DatePeriod == "thisquarter")">This Quarter</option>
                                        <option value="thisyear" selected="@(filter.DatePeriod == "thisyear")">This Year</option>
                                        <option value="last30days" selected="@(filter.DatePeriod == "last30days")">Last 30 Days</option>
                                        <option value="last90days" selected="@(filter.DatePeriod == "last90days")">Last 90 Days</option>
                                    </select>
                                </div>

                                <!-- Quick Filter Buttons -->
                                <div class="col-md-2 mb-3">
                                    <label class="form-label">&nbsp;</label>
                                    <div class="btn-group-vertical w-100">
                                        <button type="button" class="btn btn-outline-warning btn-sm toggle-filter" 
                                                data-filter="overdue" data-active="@filter.ShowOverdue">
                                            <i class="fas fa-exclamation-triangle"></i> Overdue
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <!-- Start Date -->
                                <div class="col-md-2 mb-3">
                                    <label for="startDate" class="form-label">Start Date</label>
                                    <input type="date" class="form-control" id="startDate" name="StartDate" 
                                           value="@filter.StartDate?.ToString("yyyy-MM-dd")">
                                </div>

                                <!-- End Date -->
                                <div class="col-md-2 mb-3">
                                    <label for="endDate" class="form-label">End Date</label>
                                    <input type="date" class="form-control" id="endDate" name="EndDate" 
                                           value="@filter.EndDate?.ToString("yyyy-MM-dd")">
                                </div>

                                <!-- Primary Sort -->
                                <div class="col-md-2 mb-3">
                                    <label for="sortBy" class="form-label">Sort By</label>
                                    <select class="form-control" id="sortBy" name="SortBy">
                                        <option value="Date" selected="@(filter.SortBy == "Date")">Date</option>
                                        <option value="Id" selected="@(filter.SortBy == "Id")">Order ID</option>
                                        <option value="Customer" selected="@(filter.SortBy == "Customer")">Customer</option>
                                        <option value="Status" selected="@(filter.SortBy == "Status")">Status</option>
                                        <option value="TotalAmount" selected="@(filter.SortBy == "TotalAmount")">Amount</option>
                                    </select>
                                </div>

                                <div class="col-md-2 mb-3">
                                    <label for="sortOrder" class="form-label">Order</label>
                                    <select class="form-control" id="sortOrder" name="SortOrder">
                                        <option value="asc" selected="@(filter.SortOrder == "asc")">Ascending</option>
                                        <option value="desc" selected="@(filter.SortOrder == "desc")">Descending</option>
                                    </select>
                                </div>

                                <!-- Secondary Sort -->
                                <div class="col-md-2 mb-3">
                                    <label for="secondarySortBy" class="form-label">Then By</label>
                                    <select class="form-control" id="secondarySortBy" name="SecondarySortBy">
                                        <option value="">None</option>
                                        <option value="Date" selected="@(filter.SecondarySortBy == "Date")">Date</option>
                                        <option value="Id" selected="@(filter.SecondarySortBy == "Id")">Order ID</option>
                                        <option value="Customer" selected="@(filter.SecondarySortBy == "Customer")">Customer</option>
                                        <option value="Status" selected="@(filter.SecondarySortBy == "Status")">Status</option>
                                        <option value="TotalAmount" selected="@(filter.SecondarySortBy == "TotalAmount")">Amount</option>
                                    </select>
                                </div>

                                <div class="col-md-2 mb-3">
                                    <label for="secondarySortOrder" class="form-label">Order</label>
                                    <select class="form-control" id="secondarySortOrder" name="SecondarySortOrder">
                                        <option value="asc" selected="@(filter.SecondarySortOrder == "asc")">Ascending</option>
                                        <option value="desc" selected="@(filter.SecondarySortOrder == "desc")">Descending</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12">
                                    <div class="btn-group">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="fas fa-search"></i> Apply Filters
                                        </button>
                                        <button type="button" class="btn btn-secondary" onclick="clearFilters()">
                                            <i class="fas fa-times"></i> Clear
                                        </button>
                                        <button type="button" class="btn btn-info" onclick="saveFilterPreset()">
                                            <i class="fas fa-save"></i> Save Preset
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Hidden fields for pagination -->
                            <input type="hidden" name="Page" value="@filter.Page" id="pageInput">
                            <input type="hidden" name="PageSize" value="@filter.PageSize" id="pageSizeInput">
                            <input type="hidden" name="ShowOverdue" value="@filter.ShowOverdue" id="showOverdueInput">
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Orders Table -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-list mr-2"></i>
                            Orders List 
                            <span class="badge badge-info ml-2">@Model.TotalCount total</span>
                        </h3>
                        <div class="card-tools">
                            <div class="input-group input-group-sm" style="width: 150px;">
                                <select class="form-control" id="pageSize" onchange="changePageSize(this.value)">
                                    <option value="10" selected="@(filter.PageSize == 10)">10 per page</option>
                                    <option value="25" selected="@(filter.PageSize == 25)">25 per page</option>
                                    <option value="50" selected="@(filter.PageSize == 50)">50 per page</option>
                                    <option value="100" selected="@(filter.PageSize == 100)">100 per page</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="card-body table-responsive p-0">
                        @if (Model.Orders.Any())
                        {
                            <table class="table table-hover text-nowrap">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>
                                            <a href="#" onclick="sortBy('Id')" class="text-white text-decoration-none">
                                                Order #
                                                @if (filter.SortBy == "Id")
                                                {
                                                    <i class="fas fa-sort-@(filter.SortOrder == "asc" ? "up" : "down")"></i>
                                                }
                                            </a>
                                        </th>
                                        <th>
                                            <a href="#" onclick="sortBy('Customer')" class="text-white text-decoration-none">
                                                Customer
                                                @if (filter.SortBy == "Customer")
                                                {
                                                    <i class="fas fa-sort-@(filter.SortOrder == "asc" ? "up" : "down")"></i>
                                                }
                                            </a>
                                        </th>
                                        <th>
                                            <a href="#" onclick="sortBy('Date')" class="text-white text-decoration-none">
                                                Date
                                                @if (filter.SortBy == "Date")
                                                {
                                                    <i class="fas fa-sort-@(filter.SortOrder == "asc" ? "up" : "down")"></i>
                                                }
                                            </a>
                                        </th>
                                        <th>Items</th>
                                        <th>
                                            <a href="#" onclick="sortBy('TotalAmount')" class="text-white text-decoration-none">
                                                Total Amount
                                                @if (filter.SortBy == "TotalAmount")
                                                {
                                                    <i class="fas fa-sort-@(filter.SortOrder == "asc" ? "up" : "down")"></i>
                                                }
                                            </a>
                                        </th>
                                        <th>
                                            <a href="#" onclick="sortBy('Status')" class="text-white text-decoration-none">
                                                Status
                                                @if (filter.SortBy == "Status")
                                                {
                                                    <i class="fas fa-sort-@(filter.SortOrder == "asc" ? "up" : "down")"></i>
                                                }
                                            </a>
                                        </th>
                                        <th>Delivery</th>
                                        <th width="200px">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.Orders)
                                    {
                                        <tr class="@(order.IsOverdue ? "table-warning" : "")">
                                            <td>
                                                <strong>#@order.Id</strong>
                                                @if (order.IsOverdue)
                                                {
                                                    <span class="badge badge-warning ml-1">
                                                        <i class="fas fa-exclamation-triangle"></i>
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <div>
                                                    <strong>@order.CustomerName</strong><br>
                                                    <small class="text-muted">@order.CustomerEmail</small>
                                                </div>
                                            </td>
                                            <td>
                                                <div>
                                                    @order.Date.ToString("MMM dd, yyyy")<br>
                                                    <small class="text-muted">@order.Date.ToString("dddd")</small>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge badge-primary">@order.ItemCount items</span><br>
                                                <small class="text-muted">@order.ItemsSummary</small>
                                            </td>
                                            <td>
                                                <strong class="text-success">@CurrencyHelper.FormatCurrency(order.TotalAmount)</strong>
                                            </td>
                                            <td>
                                                <span class="badge badge-@GetStatusBadgeClass(order.Status)">
                                                    @order.Status
                                                </span>
                                            </td>
                                            <td>
                                                @if (order.DeliveryDate.HasValue)
                                                {
                                                    <div>
                                                        @order.DeliveryDate.Value.ToString("MMM dd, yyyy")
                                                        @if (order.IsOverdue)
                                                        {
                                                            <br><small class="text-danger">Overdue</small>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not set</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a href="@Url.Action("Details", new { id = order.Id })" 
                                                       class="btn btn-outline-info" title="View Details">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a href="@Url.Action("DownloadInvoice", new { id = order.Id })" 
                                                       class="btn btn-outline-primary" title="Download Invoice">
                                                        <i class="fas fa-file-pdf"></i>
                                                    </a>
                                                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                                    {
                                                        <a href="@Url.Action("Edit", new { id = order.Id })" 
                                                           class="btn btn-outline-warning" title="Edit">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                                                    }
                                                    @if (User.IsInRole("Admin"))
                                                    {
                                                        <a href="@Url.Action("Delete", new { id = order.Id })" 
                                                           class="btn btn-outline-danger" title="Delete">
                                                            <i class="fas fa-trash"></i>
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-search fa-3x text-muted mb-3"></i>
                                <h4>No Orders Found</h4>
                                <p class="text-muted">Try adjusting your search criteria or filters.</p>
                                <a asp-action="CreateWorkflow" class="btn btn-primary">
                                    <i class="fas fa-plus"></i> Create New Order
                                </a>
                            </div>
                        }
                    </div>

                    <!-- Pagination -->
                    @if (Model.PageCount > 1)
                    {
                        <div class="card-footer">
                            <div class="row">
                                <div class="col-sm-12 col-md-5">
                                    <div class="dataTables_info">
                                        Showing @((filter.Page - 1) * filter.PageSize + 1) to 
                                        @(Math.Min(filter.Page * filter.PageSize, Model.TotalCount)) of 
                                        @Model.TotalCount entries
                                    </div>
                                </div>
                                <div class="col-sm-12 col-md-7">
                                    <div class="dataTables_paginate paging_simple_numbers float-right">
                                        <ul class="pagination">
                                            @if (filter.Page > 1)
                                            {
                                                <li class="paginate_button page-item">
                                                    <a href="#" onclick="goToPage(@(filter.Page - 1))" class="page-link">Previous</a>
                                                </li>
                                            }

                                            @for (int i = Math.Max(1, filter.Page - 5); i <= Math.Min(Model.PageCount, filter.Page + 5); i++)
                                            {
                                                <li class="paginate_button page-item @(i == filter.Page ? "active" : "")">
                                                    <a href="#" onclick="goToPage(@i)" class="page-link">@i</a>
                                                </li>
                                            }

                                            @if (filter.Page < Model.PageCount)
                                            {
                                                <li class="paginate_button page-item">
                                                    <a href="#" onclick="goToPage(@(filter.Page + 1))" class="page-link">Next</a>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "warning",
            "Processing" => "info",
            "Completed" => "success",
            "Cancelled" => "danger",
            _ => "secondary"
        };
    }
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize Select2 for customer dropdown
            $('#customerId').select2({
                placeholder: 'Select a customer...',
                allowClear: true
            });

            // Initialize date range picker functionality
            initializeDateHandling();
            
            // Initialize quick filter toggles
            initializeQuickFilters();
        });

        function initializeDateHandling() {
            $('#datePeriod').on('change', function() {
                const period = $(this).val();
                const today = new Date();
                
                if (period) {
                    let startDate, endDate;
                    
                    switch(period) {
                        case 'thismonth':
                            startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                            endDate = new Date(today.getFullYear(), today.getMonth() + 1, 0);
                            break;
                        case 'lastmonth':
                            startDate = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                            endDate = new Date(today.getFullYear(), today.getMonth(), 0);
                            break;
                        case 'thisquarter':
                            const quarter = Math.floor(today.getMonth() / 3);
                            startDate = new Date(today.getFullYear(), quarter * 3, 1);
                            endDate = new Date(today.getFullYear(), quarter * 3 + 3, 0);
                            break;
                        case 'thisyear':
                            startDate = new Date(today.getFullYear(), 0, 1);
                            endDate = new Date(today.getFullYear(), 11, 31);
                            break;
                        case 'last30days':
                            startDate = new Date(today.getTime() - 30 * 24 * 60 * 60 * 1000);
                            endDate = today;
                            break;
                        case 'last90days':
                            startDate = new Date(today.getTime() - 90 * 24 * 60 * 60 * 1000);
                            endDate = today;
                            break;
                    }
                    
                    if (startDate && endDate) {
                        $('#startDate').val(formatDate(startDate));
                        $('#endDate').val(formatDate(endDate));
                    }
                }
            });
        }

        function initializeQuickFilters() {
            $('.toggle-filter').on('click', function() {
                const filter = $(this).data('filter');
                const isActive = $(this).hasClass('btn-warning');
                
                if (isActive) {
                    $(this).removeClass('btn-warning').addClass('btn-outline-warning');
                    $(`#${filter}Input`).val('false');
                } else {
                    $(this).removeClass('btn-outline-warning').addClass('btn-warning');
                    $(`#${filter}Input`).val('true');
                }
            });
        }

        function formatDate(date) {
            return date.toISOString().split('T')[0];
        }

        function sortBy(column) {
            const currentSort = '@filter.SortBy';
            const currentOrder = '@filter.SortOrder';
            
            let newOrder = 'asc';
            if (currentSort === column && currentOrder === 'asc') {
                newOrder = 'desc';
            }
            
            $('#sortBy').val(column);
            $('#sortOrder').val(newOrder);
            $('#pageInput').val(1); // Reset to first page
            $('#filterForm').submit();
        }

        function goToPage(page) {
            $('#pageInput').val(page);
            $('#filterForm').submit();
        }

        function changePageSize(pageSize) {
            $('#pageSizeInput').val(pageSize);
            $('#pageInput').val(1); // Reset to first page
            $('#filterForm').submit();
        }

        function clearFilters() {
            $('#filterForm')[0].reset();
            $('#customerId').val(null).trigger('change');
            window.location.href = '@Url.Action("Index")';
        }

        function exportOrders(format) {
            // Get current filter values
            const filterData = $('#filterForm').serialize();
            const exportUrl = `@Url.Action("Export")?format=${format}&${filterData}`;
            
            // Show loading indicator
            const exportBtn = $(event.target).closest('.btn-group').find('.btn-primary');
            const originalText = exportBtn.html();
            exportBtn.html('<i class="fas fa-spinner fa-spin"></i> Exporting...');
            
            // Create a temporary link to trigger download
            const link = document.createElement('a');
            link.href = exportUrl;
            link.download = '';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            
            // Restore button text after a delay
            setTimeout(() => {
                exportBtn.html(originalText);
            }, 2000);
        }

        function saveFilterPreset() {
            const presetName = prompt('Enter a name for this filter preset:');
            if (presetName) {
                const filterData = $('#filterForm').serialize();
                localStorage.setItem(`orderFilter_${presetName}`, filterData);
                
                // Show success message
                toastr.success(`Filter preset "${presetName}" saved successfully!`);
                
                // Add to presets dropdown if it exists
                updatePresetsDropdown();
            }
        }

        function updatePresetsDropdown() {
