@page
@model AmplePack.Pages_Inventory.EditModel
@{
    ViewData["Title"] = "Edit Inventory Item";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="row">
  <div class="col-md-12">
    <div class="card card-warning">
      <div class="card-header">
        <h3 class="card-title">Edit Inventory Item</h3>
      </div>
      <!-- /.card-header -->
      <!-- form start -->
      <form method="post">
        <div class="card-body">
          <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
          <input type="hidden" asp-for="Inventory.Id" />
          
          <div class="form-group">
            <label asp-for="Inventory.ItemName" class="control-label">Item Name</label>
            <input asp-for="Inventory.ItemName" class="form-control" placeholder="Enter item name" />
            <span asp-validation-for="Inventory.ItemName" class="text-danger"></span>
          </div>

          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <label asp-for="Inventory.Quantity" class="control-label">Current Quantity</label>
                <input asp-for="Inventory.Quantity" class="form-control" type="number" min="0" step="1" />
                <span asp-validation-for="Inventory.Quantity" class="text-danger"></span>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label asp-for="Inventory.Unit" class="control-label">Unit of Measurement</label>
                <select asp-for="Inventory.Unit" class="form-control">
                  <option value="">-- Select Unit --</option>
                  <option value="pieces">Pieces</option>
                  <option value="rolls">Rolls</option>
                  <option value="boxes">Boxes</option>
                  <option value="sheets">Sheets</option>
                  <option value="meters">Meters</option>
                  <option value="kilograms">Kilograms</option>
                </select>
                <span asp-validation-for="Inventory.Unit" class="text-danger"></span>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label asp-for="Inventory.ReorderLevel" class="control-label">Reorder Level</label>
            <input asp-for="Inventory.ReorderLevel" class="form-control" type="number" min="0" step="1" />
            <span asp-validation-for="Inventory.ReorderLevel" class="text-danger"></span>
            <small class="form-text text-muted">Alert will be shown when quantity falls below this level</small>
          </div>

          <!-- Stock Status Display -->
          <div class="form-group">
            <label>Current Stock Status</label>
            <div class="progress">
              @{
                var percentage = Model.Inventory.ReorderLevel > 0 ? 
                  Math.Min(100, (double)(Model.Inventory.Quantity / Model.Inventory.ReorderLevel) * 100) : 100;
                var progressClass = percentage > 100 ? "bg-success" : percentage > 50 ? "bg-warning" : "bg-danger";
              }
              <div class="progress-bar @progressClass" role="progressbar" 
                   style="width: @Math.Min(100, percentage)%" 
                   aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100">
                @percentage.ToString("F0")%
              </div>
            </div>
            <small class="text-muted">
              @if (Model.Inventory.Quantity > Model.Inventory.ReorderLevel)
              {
                <span class="text-success">? Stock levels are healthy</span>
              }
              else if (Model.Inventory.Quantity > 0)
              {
                <span class="text-warning">? Stock is below reorder level</span>
              }
              else
              {
                <span class="text-danger">? Out of stock</span>
              }
            </small>
          </div>
        </div>
        <!-- /.card-body -->

        <div class="card-footer">
          <button type="submit" class="btn btn-warning">
            <i class="fas fa-save"></i> Update Item
          </button>
          <a asp-page="./Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
          </a>
          <a asp-page="./Details" asp-route-id="@Model.Inventory?.Id" class="btn btn-info">
            <i class="fas fa-eye"></i> View Details
          </a>
        </div>
      </form>
    </div>
    <!-- /.card -->
  </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            // Update progress bar when quantity or reorder level changes
            function updateStockStatus() {
                var quantity = parseFloat($('#Inventory_Quantity').val()) || 0;
                var reorderLevel = parseFloat($('#Inventory_ReorderLevel').val()) || 0;
                
                if (reorderLevel > 0) {
                    var percentage = Math.min(100, (quantity / reorderLevel) * 100);
                    var progressClass = percentage > 100 ? 'bg-success' : percentage > 50 ? 'bg-warning' : 'bg-danger';
                    
                    $('.progress-bar')
                        .removeClass('bg-success bg-warning bg-danger')
                        .addClass(progressClass)
                        .css('width', Math.min(100, percentage) + '%')
                        .text(percentage.toFixed(0) + '%');
                    
                    // Update status text
                    var statusText = '';
                    if (quantity > reorderLevel) {
                        statusText = '<span class="text-success">? Stock levels are healthy</span>';
                    } else if (quantity > 0) {
                        statusText = '<span class="text-warning">? Stock is below reorder level</span>';
                    } else {
                        statusText = '<span class="text-danger">? Out of stock</span>';
                    }
                    $('.text-muted').html(statusText);
                }
            }
            
            $('#Inventory_Quantity, #Inventory_ReorderLevel').on('input', updateStockStatus);
        });
    </script>
}