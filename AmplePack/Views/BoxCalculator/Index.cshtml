                                                </tr>
                                                <tr>
                                                    <td><i class="fas fa-droplet mr-2"></i><strong>Pasting</strong></td>
                                                    <td class="text-right">Rs.@Model.Result.Quantities["1000"].Pasting.ToString("F4")</td>
                                                    <td class="text-right">Rs.@Model.Result.Quantities["2000"].Pasting.ToString("F4")</td>
                                                    <td class="text-right">Rs.@Model.Result.Quantities["3000"].Pasting.ToString("F4")</td>
