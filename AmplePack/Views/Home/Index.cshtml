@{
    ViewData["Title"] = "Dashboard";
}

<!-- Content Header -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">
                    <i class="fas fa-tachometer-alt mr-2"></i>
                    Dashboard
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item active">Dashboard</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        
        <!-- Stats Row -->
        <div class="row">
            <div class="col-lg-3 col-6">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3 id="totalOrdersCount">@ViewBag.TotalOrders</h3>
                        <p>Total Orders</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <a asp-controller="Orders" asp-action="Index" class="small-box-footer">
                        View Orders <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3 id="totalCustomersCount">@ViewBag.TotalCustomers</h3>
                        <p>Total Customers</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <a asp-controller="Customers" asp-action="Index" class="small-box-footer">
                        View Customers <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3 id="lowStockCount">@ViewBag.LowStockCount</h3>
                        <p>Low Stock Items</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <a asp-controller="Inventory" asp-action="Index" class="small-box-footer">
                        View Inventory <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-danger">
                    <div class="inner">
                        <h3 id="totalRevenue">@AmplePack.Helpers.CurrencyHelper.FormatCurrency(ViewBag.TotalRevenue)</h3>
                        <p>Total Revenue</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-rupee-sign"></i>
                    </div>
                    <a asp-controller="Reports" asp-action="Index" class="small-box-footer">
                        View Reports <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Charts Row -->
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-chart-line mr-2"></i>
                            Monthly Revenue & Orders Trend (Last 12 Months)
                        </h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" onclick="refreshRevenueChart()" title="Refresh Chart">
                                <i class="fas fa-sync-alt"></i>
                            </button>
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                            <button type="button" class="btn btn-tool" data-card-widget="maximize">
                                <i class="fas fa-expand"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="chart">
                            <canvas id="revenueChart" style="min-height: 300px; height: 300px; max-height: 300px; max-width: 100%;"></canvas>
                        </div>
                        <div class="mt-2 text-center">
                            <small class="text-muted">Data automatically updates every 5 minutes</small>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-chart-pie mr-2"></i>
                            Current Order Status Distribution
                        </h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" onclick="refreshStatusChart()" title="Refresh Chart">
                                <i class="fas fa-sync-alt"></i>
                            </button>
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <canvas id="orderStatusChart" style="min-height: 300px; height: 300px; max-height: 300px;"></canvas>
                        <div class="mt-2">
                            <div class="d-flex justify-content-between">
                                <small class="text-muted">
                                    <span class="badge badge-warning">Pending: @ViewBag.PendingOrders</span>
                                    <span class="badge badge-info">Processing: @ViewBag.ProcessingOrders</span>
                                </small>
                            </div>
                            <div class="d-flex justify-content-between mt-1">
                                <small class="text-muted">
                                    <span class="badge badge-success">Completed: @ViewBag.CompletedOrders</span>
                                    <span class="badge badge-danger">Cancelled: @ViewBag.CancelledOrders</span>
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Activity Row -->
        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-clock mr-2"></i>
                            Recent Orders
                        </h3>
                        <div class="card-tools">
                            <a asp-controller="Orders" asp-action="Index" class="btn btn-tool" title="View All Orders">
                                <i class="fas fa-external-link-alt"></i>
                            </a>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Order</th>
                                        <th>Customer</th>
                                        <th>Status</th>
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (ViewBag.RecentOrders != null && ((List<AmplePack.Models.Order>)ViewBag.RecentOrders).Any())
                                    {
                                        @foreach (var order in ViewBag.RecentOrders as List<AmplePack.Models.Order>)
                                        {
                                            <tr>
                                                <td>
                                                    <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="text-decoration-none">
                                                        <strong>#@order.Id.ToString("D4")</strong>
                                                    </a>
                                                    <br>
                                                    <small class="text-muted">@order.Date.ToString("MMM dd, yyyy")</small>
                                                </td>
                                                <td>
                                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@order.CustomerId" class="text-decoration-none">
                                                        @(order.Customer?.Name ?? "Unknown Customer")
                                                    </a>
                                                </td>
                                                <td>
                                                    <span class="badge badge-@(order.Status.ToLower() switch 
                                                    {
                                                        "pending" => "warning",
                                                        "processing" => "info", 
                                                        "completed" => "success",
                                                        "delivered" => "primary",
                                                        "cancelled" => "danger",
                                                        _ => "secondary"
                                                    })">@order.Status</span>
                                                </td>
                                                <td class="currency">@AmplePack.Helpers.CurrencyHelper.FormatCurrency(order.TotalAmount)</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-4">
                                                <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                                No recent orders found
                                                <br>
                                                <a asp-controller="Orders" asp-action="CreateWorkflow" class="btn btn-sm btn-primary mt-2">
                                                    Create First Order
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-exclamation-triangle mr-2"></i>
                            Low Stock Alerts
                        </h3>
                        <div class="card-tools">
                            <span class="badge badge-danger">@ViewBag.LowStockCount items</span>
                            <a asp-controller="Inventory" asp-action="Index" class="btn btn-tool" title="View All Inventory">
                                <i class="fas fa-external-link-alt"></i>
                            </a>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Item</th>
                                        <th>Current</th>
                                        <th>Reorder</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (ViewBag.LowStockItems != null && ((List<AmplePack.Models.Inventory>)ViewBag.LowStockItems).Any())
                                    {
                                        @foreach (var item in ViewBag.LowStockItems as List<AmplePack.Models.Inventory>)
                                        {
                                            <tr>
                                                <td>
                                                    <a asp-controller="Inventory" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                                                        <strong>@item.ItemName</strong>
                                                    </a>
                                                    @if (!string.IsNullOrEmpty(item.Category))
                                                    {
                                                        <br><small class="text-muted">@item.Category</small>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge @(item.AvailableQuantity <= 0 ? "badge-danger" : item.AvailableQuantity <= item.ReorderLevel / 2 ? "badge-danger" : "badge-warning")">
                                                        @item.AvailableQuantity.ToString("F1") @item.Unit
                                                    </span>
                                                </td>
                                                <td>
                                                    <small class="text-muted">@item.ReorderLevel.ToString("F1") @item.Unit</small>
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-success quick-add" 
                                                            data-item-id="@item.Id" 
                                                            data-item-name="@item.ItemName"
                                                            title="Quick Add Stock">
                                                        <i class="fas fa-plus"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-4">
                                                <i class="fas fa-check-circle fa-2x mb-2 d-block text-success"></i>
                                                All items are well stocked
                                                <br>
                                                <small>No immediate action required</small>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions Row -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-rocket mr-2"></i>
                            Quick Actions
                        </h3>
                    </div>
                    <div class="card-body">
                        <!-- Quick Actions remain the same -->
                        <div class="row">
                            <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mb-4">
                                <button onclick="location.href='@Url.Action("CreateWorkflow", "Orders")'" class="btn btn-app-enhanced btn-primary">
                                    <div class="btn-app-icon">
                                        <i class="fas fa-plus-circle"></i>
                                    </div>
                                    <div class="btn-app-text">
                                        <span class="btn-app-title">Add Order</span>
                                        <span class="btn-app-desc">Create new order</span>
                                    </div>
                                </button>
                            </div>
                            <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mb-4">
                                <button onclick="location.href='@Url.Action("Index", "BoxCalculator")'" class="btn btn-app-enhanced btn-warning">
                                    <div class="btn-app-icon">
                                        <i class="fas fa-calculator"></i>
                                    </div>
                                    <div class="btn-app-text">
                                        <span class="btn-app-title">Box Calculator</span>
                                        <span class="btn-app-desc">Calculate box pricing</span>
                                    </div>
                                </button>
                            </div>
                            <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mb-4">
                                <button onclick="location.href='@Url.Action("Create", "Customers")'" class="btn btn-app-enhanced btn-success">
                                    <div class="btn-app-icon">
                                        <i class="fas fa-user-plus"></i>
                                    </div>
                                    <div class="btn-app-text">
                                        <span class="btn-app-title">Add Customer</span>
                                        <span class="btn-app-desc">Register new customer</span>
                                    </div>
                                </button>
                            </div>
                            <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mb-4">
                                <button onclick="location.href='@Url.Action("Create", "CustomerProducts")'" class="btn btn-app-enhanced btn-info">
                                    <div class="btn-app-icon">
                                        <i class="fas fa-cube"></i>
                                    </div>
                                    <div class="btn-app-text">
                                        <span class="btn-app-title">Add Product</span>
                                        <span class="btn-app-desc">New customer product</span>
                                    </div>
                                </button>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mb-4">
                                <button onclick="location.href='@Url.Action("Create", "Inventory")'" class="btn btn-app-enhanced btn-secondary">
                                    <div class="btn-app-icon">
                                        <i class="fas fa-boxes"></i>
                                    </div>
                                    <div class="btn-app-text">
                                        <span class="btn-app-title">Add Inventory</span>
                                        <span class="btn-app-desc">Stock management</span>
                                    </div>
                                </button>
                            </div>
                            <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mb-4">
                                <button onclick="location.href='@Url.Action("Index", "Reports")'" class="btn btn-app-enhanced btn-dark">
                                    <div class="btn-app-icon">
                                        <i class="fas fa-chart-line"></i>
                                    </div>
                                    <div class="btn-app-text">
                                        <span class="btn-app-title">View Reports</span>
                                        <span class="btn-app-desc">Analytics & insights</span>
                                    </div>
                                </button>
                            </div>
                            <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mb-4">
                                <button onclick="location.href='@Url.Action("Help", "BoxCalculator")'" class="btn btn-app-enhanced btn-outline-primary">
                                    <div class="btn-app-icon">
                                        <i class="fas fa-question-circle"></i>
                                    </div>
                                    <div class="btn-app-text">
                                        <span class="btn-app-title">Calculator Help</span>
                                        <span class="btn-app-desc">Learn formulas & tips</span>
                                    </div>
                                </button>
                            </div>
                            <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mb-4">
                                <button onclick="quickPriceCheck()" class="btn btn-app-enhanced btn-outline-success">
                                    <div class="btn-app-icon">
                                        <i class="fas fa-search-dollar"></i>
                                    </div>
                                    <div class="btn-app-text">
                                        <span class="btn-app-title">Quick Price Check</span>
                                        <span class="btn-app-desc">Fast calculation</span>
                                    </div>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        let revenueChart, statusChart;
        
        $(document).ready(function() {
            initializeCharts();
            setupQuickActions();
            
            // Auto-refresh charts every 5 minutes
            setInterval(function() {
                refreshRevenueChart();
                refreshStatusChart();
            }, 300000);
        });

        async function initializeCharts() {
            await loadRevenueChart();
            await loadStatusChart();
        }

        async function loadRevenueChart() {
            try {
                const response = await fetch('/Reports/GetChartData?chartType=monthlyrevenue');
                const result = await response.json();
                
                const ctx = document.getElementById('revenueChart').getContext('2d');
                
                if (revenueChart) {
                    revenueChart.destroy();
                }
                
                revenueChart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: result.data.map(d => d.month),
                        datasets: [{
                            label: 'Revenue (Rs.)',
                            data: result.data.map(d => d.revenue),
                            borderColor: 'rgb(54, 162, 235)',
                            backgroundColor: 'rgba(54, 162, 235, 0.1)',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4,
                            yAxisID: 'y'
                        }, {
                            label: 'Orders Count',
                            data: result.data.map(d => d.orderCount),
                            borderColor: 'rgb(255, 99, 132)',
                            backgroundColor: 'rgba(255, 99, 132, 0.1)',
                            borderWidth: 2,
                            fill: false,
                            tension: 0.4,
                            yAxisID: 'y1'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'top'
                            },
                            tooltip: {
                                mode: 'index',
                                intersect: false,
                                callbacks: {
                                    label: function(context) {
                                        if (context.datasetIndex === 0) {
                                            return 'Revenue: Rs. ' + context.parsed.y.toLocaleString('en-IN');
                                        } else {
                                            return 'Orders: ' + context.parsed.y;
                                        }
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                display: true,
                                title: {
                                    display: true,
                                    text: 'Month'
                                }
                            },
                            y: {
                                type: 'linear',
                                display: true,
                                position: 'left',
                                title: {
                                    display: true,
                                    text: 'Revenue (Rs.)'
                                },
                                ticks: {
                                    callback: function(value) {
                                        return 'Rs. ' + value.toLocaleString('en-IN');
                                    }
                                }
                            },
                            y1: {
                                type: 'linear',
                                display: true,
                                position: 'right',
                                title: {
                                    display: true,
                                    text: 'Orders Count'
                                },
                                grid: {
                                    drawOnChartArea: false,
                                }
                            }
                        },
                        interaction: {
                            intersect: false,
                            mode: 'index'
                        }
                    }
                });
            } catch (error) {
                console.error('Failed to load revenue chart:', error);
                document.getElementById('revenueChart').parentElement.innerHTML = 
                    '<div class="text-center py-4"><i class="fas fa-chart-line fa-3x text-muted mb-3"></i><br>Unable to load chart data</div>';
            }
        }

        async function loadStatusChart() {
            try {
                const response = await fetch('/Reports/GetChartData?chartType=orderstatus');
                const result = await response.json();
                
                const ctx = document.getElementById('orderStatusChart').getContext('2d');
                
                if (statusChart) {
                    statusChart.destroy();
                }
                
                statusChart = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: result.labels,
                        datasets: [{
                            data: result.data,
                            backgroundColor: [
                                '#ffc107', // Pending - Warning
                                '#17a2b8', // Processing - Info
                                '#28a745', // Completed - Success
                                '#007bff', // Delivered - Primary
                                '#dc3545'  // Cancelled - Danger
                            ],
                            borderWidth: 2,
                            borderColor: '#fff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    padding: 15,
                                    usePointStyle: true
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                        const percentage = ((context.parsed / total) * 100).toFixed(1);
                                        return context.label + ': ' + context.parsed + ' (' + percentage + '%)';
                                    }
                                }
                            }
                        }
                    }
                });
            } catch (error) {
                console.error('Failed to load status chart:', error);
                document.getElementById('orderStatusChart').parentElement.innerHTML = 
                    '<div class="text-center py-4"><i class="fas fa-chart-pie fa-3x text-muted mb-3"></i><br>Unable to load chart data</div>';
            }
        }

        async function refreshRevenueChart() {
            const refreshBtn = event?.target?.closest('button') || document.querySelector('[onclick="refreshRevenueChart()"]');
            if (refreshBtn) {
                refreshBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            }
            
            await loadRevenueChart();
            
            if (refreshBtn) {
                refreshBtn.innerHTML = '<i class="fas fa-sync-alt"></i>';
            }
        }

        async function refreshStatusChart() {
            const refreshBtn = event?.target?.closest('button') || document.querySelector('[onclick="refreshStatusChart()"]');
            if (refreshBtn) {
                refreshBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            }
            
            await loadStatusChart();
            
            if (refreshBtn) {
                refreshBtn.innerHTML = '<i class="fas fa-sync-alt"></i>';
            }
        }

        function setupQuickActions() {
            // Quick add functionality for low stock items with real API integration
            $(document).on('click', '.quick-add', function(e) {
                e.preventDefault();
                const itemId = $(this).data('item-id');
                const itemName = $(this).data('item-name');
                
                Swal.fire({
                    title: 'Quick Stock Add',
                    html: `
                        <p>Add stock for: <strong>${itemName}</strong></p>
                        <div class="form-group text-left">
                            <label for="addQuantity">Quantity to Add:</label>
                            <input type="number" class="form-control" id="addQuantity" min="0.01" step="0.01" value="10">
                        </div>
                        <div class="form-group text-left">
                            <label for="addReason">Reason:</label>
                            <input type="text" class="form-control" id="addReason" placeholder="Stock replenishment">
                        </div>
                    `,
                    showCancelButton: true,
                    confirmButtonText: 'Add Stock',
                    cancelButtonText: 'Cancel',
                    preConfirm: () => {
                        const quantity = document.getElementById('addQuantity').value;
                        const reason = document.getElementById('addReason').value;
                        
                        if (!quantity || quantity <= 0) {
                            Swal.showValidationMessage('Please enter a valid quantity');
                            return false;
                        }
                        
                        return { quantity: parseFloat(quantity), reason: reason || 'Stock replenishment' };
                    }
                }).then(async (result) => {
                    if (result.isConfirmed) {
                        try {
                            // Show loading
                            Swal.fire({
                                title: 'Adding Stock...',
                                text: 'Please wait while we update the inventory.',
                                icon: 'info',
                                showConfirmButton: false,
                                allowOutsideClick: false
                            });

                            // Make actual API call
                            const response = await fetch('/Inventory/AdjustStock', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                                },
                                body: JSON.stringify({
                                    itemId: itemId,
                                    quantity: result.value.quantity,
                                    action: 'add',
                                    reason: result.value.reason
                                })
                            });

                            const data = await response.json();

                            if (data.success) {
                                Swal.fire({
                                    title: 'Success!',
                                    text: data.message,
                                    icon: 'success',
                                    timer: 2000,
                                    showConfirmButton: false
                                });
                                
                                // Refresh the page after 2 seconds
                                setTimeout(() => {
                                    location.reload();
                                }, 2000);
                            } else {
                                Swal.fire({
                                    title: 'Error!',
                                    text: data.message || 'Failed to add stock',
                                    icon: 'error'
                                });
                            }
                        } catch (error) {
                            Swal.fire({
                                title: 'Error!',
                                text: 'Failed to add stock. Please try again.',
                                icon: 'error'
                            });
                        }
                    }
                });
            });
        }

        function quickPriceCheck() {
            Swal.fire({
                title: 'Quick Box Price Check',
                html: `
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group text-left">
                                <label for="quickLength">Length (in):</label>
                                <input type="number" class="form-control" id="quickLength" step="0.1" value="10">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group text-left">
                                <label for="quickWidth">Width (in):</label>
                                <input type="number" class="form-control" id="quickWidth" step="0.1" value="8">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group text-left">
                                <label for="quickHeight">Height (in):</label>
                                <input type="number" class="form-control" id="quickHeight" step="0.1" value="6">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group text-left">
                                <label for="quickQuantity">Quantity:</label>
                                <input type="number" class="form-control" id="quickQuantity" value="1000">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group text-left">
                                <label for="quickBoardType">Board Type:</label>
                                <select class="form-control" id="quickBoardType">
                                    <option value="3 Ply">3 Ply</option>
                                    <option value="5 Ply">5 Ply</option>
                                    <option value="7 Ply">7 Ply</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div id="quickResult" class="mt-3" style="display: none;">
                        <div class="alert alert-success">
                            <h5><i class="fas fa-calculator me-2"></i>Quick Calculation Result</h5>
                            <div class="row">
                                <div class="col-6">
                                    <strong>Price per Box:</strong><br>
                                    <span id="quickPricePerBox" class="h4 text-success">Rs. 0.00</span>
                                </div>
                                <div class="col-6">
                                    <strong>Total Order Value:</strong><br>
                                    <span id="quickTotalValue" class="h4 text-primary">Rs. 0.00</span>
                                </div>
                            </div>
                            <small class="text-muted">* Based on default parameters. For detailed calculation, use the full calculator.</small>
                        </div>
                    </div>
                `,
                width: '600px',
                showCancelButton: true,
                showConfirmButton: true,
                confirmButtonText: '<i class="fas fa-calculator me-2"></i>Calculate',
                cancelButtonText: 'Full Calculator',
                allowOutsideClick: false,
                preConfirm: async () => {
                    const length = parseFloat(document.getElementById('quickLength').value);
                    const width = parseFloat(document.getElementById('quickWidth').value);
                    const height = parseFloat(document.getElementById('quickHeight').value);
                    const quantity = parseInt(document.getElementById('quickQuantity').value);
                    const boardType = document.getElementById('quickBoardType').value;

                    if (!length || !width || !height || !quantity) {
                        Swal.showValidationMessage('Please fill all fields with valid values');
                        return false;
                    }

                    try {
                        // Show calculating message
                        Swal.update({
                            html: Swal.getHtmlContainer().innerHTML.replace(
                                '<div id="quickResult"',
                                '<div class="text-center"><i class="fas fa-spinner fa-spin fa-2x text-primary"></i><br>Calculating...</div><div id="quickResult"'
                            )
                        });

                        const response = await fetch('/BoxCalculator/Calculate', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                Length: length,
                                Width: width,
                                Height: height,
                                BoardType: boardType,
                                GSM: 150,
                                Quantity: quantity,
                                SheetSize1Length: 40,
                                SheetSize1Width: 30,
                                SheetSize2Length: 36,
                                SheetSize2Width: 28,
                                PaperRatePerKg: 45.00,
                                PrintingCostPerSheet: 2.50,
                                DieCuttingCostPerSheet: 1.50,
                                LaborCostPerBox: 0.50,
                                OverheadPercentage: 15.0,
                                ProfitMarginPercentage: 20.0,
                                WastageFactorPercentage: 10.0,
                                IncludeGST: true,
                                GSTRate: 18.0
                            })
                        });

                        const result = await response.json();
                        
                        if (result.success) {
                            document.getElementById('quickPricePerBox').textContent = 'Rs. ' + result.result.finalPricePerBoxWithGST.toFixed(2);
                            document.getElementById('quickTotalValue').textContent = 'Rs. ' + result.result.totalOrderValueWithGST.toFixed(2);
                            document.getElementById('quickResult').style.display = 'block';
                            
                            // Update the HTML to show results
                            Swal.update({
                                html: Swal.getHtmlContainer().innerHTML.replace(
                                    /<div class="text-center">.*?<\/div>/,
                                    ''
                                ),
                                confirmButtonText: '<i class="fas fa-external-link-alt me-2"></i>Full Calculator',
                                cancelButtonText: 'Close'
                            });
                            
                            return { calculated: true, result: result.result };
                        } else {
                            throw new Error(result.message || 'Calculation failed');
                        }
                    } catch (error) {
                        Swal.showValidationMessage('Calculation failed: ' + error.message);
                        return false;
                    }
                }
            }).then((result) => {
                if (result.isConfirmed && result.value?.calculated) {
                    // Go to full calculator
                    window.location.href = '@Url.Action("Index", "BoxCalculator")';
                } else if (result.dismiss === Swal.DismissReason.cancel) {
                    // Go to full calculator
                    window.location.href = '@Url.Action("Index", "BoxCalculator")';
                }
            });
        }
    </script>
}

