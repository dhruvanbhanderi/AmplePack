@page
@model AmplePack.Pages_Customers.DeleteModel
@{
    ViewData["Title"] = "Delete Customer";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="row">
  <div class="col-md-8 offset-md-2">
    <div class="card card-danger">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fas fa-exclamation-triangle"></i> Delete Customer
        </h3>
      </div>
      <div class="card-body">
        <div class="alert alert-warning">
          <h5><i class="icon fas fa-exclamation-triangle"></i> Warning!</h5>
          Are you sure you want to delete this customer? This action cannot be undone.
        </div>

        <div class="row">
          <div class="col-md-4 text-center">
            <img class="img-fluid img-circle"
                 src="https://adminlte.io/themes/v3/dist/img/user4-128x128.jpg"
                 alt="User profile picture"
                 style="width: 100px; height: 100px;">
          </div>
          <div class="col-md-8">
            <table class="table table-borderless">
              <tr>
                <th>Customer ID:</th>
                <td>@Html.DisplayFor(model => model.Customer!.Id)</td>
              </tr>
              <tr>
                <th>Name:</th>
                <td>@Html.DisplayFor(model => model.Customer!.Name)</td>
              </tr>
              <tr>
                <th>Email:</th>
                <td>@Html.DisplayFor(model => model.Customer!.Email)</td>
              </tr>
              <tr>
                <th>Contact:</th>
                <td>@Html.DisplayFor(model => model.Customer!.Contact)</td>
              </tr>
              <tr>
                <th>Address:</th>
                <td>@Html.DisplayFor(model => model.Customer!.Address)</td>
              </tr>
            </table>
          </div>
        </div>
      </div>
      <div class="card-footer">
        <form method="post">
          <input type="hidden" asp-for="Customer!.Id" />
          <button type="submit" class="btn btn-danger">
            <i class="fas fa-trash"></i> Yes, Delete Customer
          </button>
          <a asp-page="./Index" class="btn btn-secondary">
            <i class="fas fa-times"></i> Cancel
          </a>
          <a asp-page="./Details" asp-route-id="@Model.Customer?.Id" class="btn btn-info">
            <i class="fas fa-eye"></i> View Details
          </a>
        </form>
      </div>
    </div>
  </div>
</div>
