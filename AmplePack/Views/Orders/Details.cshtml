@using AmplePack.Helpers
@model AmplePack.Models.Order
@{
    ViewData["Title"] = "Order Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Order #@Model.Id</h1>
            </div>
            <div class="col-sm-6">
                <div class="float-sm-right">
                    <span class="badge @(Model.Status == "Completed" ? "badge-success" : Model.Status == "Pending" ? "badge-warning" : Model.Status == "Processing" ? "badge-info" : "badge-danger") badge-lg">
                        @Model.Status
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-8">
                <!-- Order Information -->
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-shopping-cart"></i> Order Information
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-6">
                                <strong><i class="fas fa-calendar mr-1"></i> Order Date:</strong>
                                <p class="text-muted">@Model.Date.ToString("MMMM dd, yyyy")</p>
                            </div>
                            <div class="col-sm-6">
                                <strong><i class="fas fa-money-bill mr-1"></i> Total Amount:</strong>
                                <p class="text-muted h5">@CurrencyHelper.FormatCurrency(Model.TotalAmount)</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Customer Information -->
                <div class="card card-info">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-user"></i> Customer Information
                        </h3>
                    </div>
                    <div class="card-body">
                        @if (Model.Customer != null)
                        {
                            <div class="row">
                                <div class="col-sm-6">
                                    <strong><i class="fas fa-user mr-1"></i> Name:</strong>
                                    <p class="text-muted">@Model.Customer.Name</p>
                                </div>
                                <div class="col-sm-6">
                                    <strong><i class="fas fa-envelope mr-1"></i> Email:</strong>
                                    <p class="text-muted">
                                        <a href="mailto:@Model.Customer.Email">@Model.Customer.Email</a>
                                    </p>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-6">
                                    <strong><i class="fas fa-phone mr-1"></i> Contact:</strong>
                                    <p class="text-muted">
                                        <a href="tel:@Model.Customer.Contact">@Model.Customer.Contact</a>
                                    </p>
                                </div>
                                <div class="col-sm-6">
                                    <strong><i class="fas fa-map-marker-alt mr-1"></i> Address:</strong>
                                    <p class="text-muted">@Model.Customer.Address</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Order Details -->
                @if (Model.OrderDetails?.Any() == true)
                {
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-list"></i> Order Items (@Model.OrderDetails.Count())
                            </h3>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Box Type</th>
                                        <th>Size</th>
                                        <th>Quantity</th>
                                        <th>Price per Box</th>
                                        <th>Total</th>
                                        <th>Delivery Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var detail in Model.OrderDetails)
                                    {
                                        <tr>
                                            <td>@detail.BoxType</td>
                                            <td>@detail.Size</td>
                                            <td>@detail.Quantity</td>
                                            <td>@CurrencyHelper.FormatCurrency(detail.PricePerBox)</td>
                                            <td>@CurrencyHelper.FormatCurrency(detail.Quantity * detail.PricePerBox)</td>
                                            <td>
                                                @if (detail.DeliveryDate.HasValue)
                                                {
                                                    @detail.DeliveryDate.Value.ToString("MMM dd, yyyy")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not specified</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-info">
                                        <th colspan="4" class="text-right">Grand Total:</th>
                                        <th colspan="2">@CurrencyHelper.FormatCurrency(Model.TotalAmount)</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card">
                        <div class="card-body text-center">
                            <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                            <h4>No Order Items</h4>
                            <p class="text-muted">This order doesn't have any items yet.</p>
                        </div>
                    </div>
                }
            </div>
            
            <div class="col-md-4">
                <!-- Order Timeline -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-history"></i> Order Timeline
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="timeline">
                            <div class="time-label">
                                <span class="bg-green">@Model.Date.ToString("MMM dd")</span>
                            </div>
                            <div>
                                <i class="fas fa-plus bg-blue"></i>
                                <div class="timeline-item">
                                    <span class="time"><i class="fas fa-clock"></i> @Model.Date.ToString("h:mm tt")</span>
                                    <h3 class="timeline-header">Order Created</h3>
                                    <div class="timeline-body">
                                        Order #@Model.Id was created for @Model.Customer?.Name
                                    </div>
                                </div>
                            </div>
                            
                            @if (Model.Status == "Processing" || Model.Status == "Completed")
                            {
                                <div>
                                    <i class="fas fa-cog bg-yellow"></i>
                                    <div class="timeline-item">
                                        <h3 class="timeline-header">Order Processing</h3>
                                        <div class="timeline-body">
                                            Order is being processed
                                        </div>
                                    </div>
                                </div>
                            }
                            
                            @if (Model.Status == "Completed")
                            {
                                <div>
                                    <i class="fas fa-check bg-green"></i>
                                    <div class="timeline-item">
                                        <h3 class="timeline-header">Order Completed</h3>
                                        <div class="timeline-body">
                                            Order has been completed successfully
                                        </div>
                                    </div>
                                </div>
                            }
                            
                            @if (Model.Status == "Cancelled")
                            {
                                <div>
                                    <i class="fas fa-times bg-red"></i>
                                    <div class="timeline-item">
                                        <h3 class="timeline-header">Order Cancelled</h3>
                                        <div class="timeline-body">
                                            Order has been cancelled
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-tools"></i> Quick Actions
                        </h3>
                    </div>
                    <div class="card-body">
                        <a href="#" onclick="generateInvoice(@Model.Id)" class="btn btn-primary btn-block">
                            <i class="fas fa-file-pdf"></i> Download Invoice (PDF)
                        </a>
                        
                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-block">
                                <i class="fas fa-edit"></i> Edit Order
                            </a>
                            
                            <button type="button" class="btn btn-info btn-block" onclick="changeOrderStatusDetailed(@Model.Id, '@Model.Status')">
                                <i class="fas fa-exchange-alt"></i> Change Status
                            </button>
                        }
                        
                        @if (Model.Status == "Completed" && (User.IsInRole("Admin") || User.IsInRole("Manager")))
                        {
                            <button type="button" class="btn btn-outline-warning btn-block" onclick="reverseCompletedOrder(@Model.Id)">
                                <i class="fas fa-undo"></i> Reverse to Processing
                            </button>
                        }
                        
                        @if (Model.Status == "Completed")
                        {
                            <button type="button" class="btn btn-outline-success btn-block" onclick="reorderFromDetails(@Model.Id)">
                                <i class="fas fa-redo"></i> Reorder
                            </button>
                        }
                        
                        <a href="mailto:@Model.Customer?.Email" class="btn btn-outline-primary btn-block">
                            <i class="fas fa-envelope"></i> Email Customer
                        </a>
                        
                        <a href="tel:@Model.Customer?.Contact" class="btn btn-outline-secondary btn-block">
                            <i class="fas fa-phone"></i> Call Customer
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card-footer">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to Orders
                    </a>
                    <a asp-action="DownloadInvoice" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="fas fa-file-pdf"></i> Download Invoice (PDF)
                    </a>
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="fas fa-edit"></i> Edit Order
                        </a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                            <i class="fas fa-trash"></i> Delete Order
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function generateInvoice(orderId) {
            window.open(`/Orders/GenerateInvoice/${orderId}`, '_blank');
        }

        function changeOrderStatusDetailed(orderId, currentStatus) {
            const statusOptions = ['Pending', 'Processing', 'Completed', 'Delivered', 'Cancelled'];
            let optionsHtml = statusOptions.map(status => 
                `<option value="${status}" ${status === currentStatus ? 'selected' : ''}>${status}</option>`
            ).join('');

            const modalHtml = `
                <div class="modal fade" id="statusChangeModal" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">
                                    <i class="fas fa-exchange-alt mr-2"></i>Change Order Status
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label for="newStatus" class="form-label">Select New Status:</label>
                                    <select id="newStatus" class="form-control">
                                        ${optionsHtml}
                                    </select>
                                </div>
                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle mr-2"></i>
                                    <strong>Current status:</strong> ${currentStatus}
                                </div>
                                <div class="alert alert-warning">
                                    <i class="fas fa-exclamation-triangle mr-2"></i>
                                    <strong>Note:</strong> This will update the order status and may affect reporting and workflow.
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="button" class="btn btn-primary" onclick="updateOrderStatusDetailed(${orderId})">
                                    <i class="fas fa-check mr-1"></i>Update Status
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            $('#statusChangeModal').remove();
            $('body').append(modalHtml);
            $('#statusChangeModal').modal('show');
        }

        function reverseCompletedOrder(orderId) {
            const modalHtml = `
                <div class="modal fade" id="reverseOrderModal" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header bg-warning">
                                <h5 class="modal-title">
                                    <i class="fas fa-undo mr-2"></i>Reverse Completed Order
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="alert alert-warning">
                                    <i class="fas fa-exclamation-triangle mr-2"></i>
                                    <strong>Warning:</strong> You are about to reverse a completed order back to "Processing" status.
                                </div>
                                <p>This action will:</p>
                                <ul>
                                    <li>Change order status from "Completed" to "Processing"</li>
                                    <li>Make the order appear in active orders list</li>
                                    <li>Remove it from completed orders</li>
                                    <li>May affect revenue reporting</li>
                                </ul>
                                <div class="form-group">
                                    <label for="reverseReason">Reason for reversal (optional):</label>
                                    <textarea id="reverseReason" class="form-control" rows="3" placeholder="Enter reason for reversing this order..."></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="button" class="btn btn-warning" onclick="confirmReverseOrder(${orderId})">
                                    <i class="fas fa-undo mr-1"></i>Reverse Order
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            $('#reverseOrderModal').remove();
            $('body').append(modalHtml);
            $('#reverseOrderModal').modal('show');
        }

        function confirmReverseOrder(orderId) {
            const reason = $('#reverseReason').val();
            const button = $('.modal-footer .btn-warning');
            
            button.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i>Reversing...');

            fetch(`/Orders/ChangeStatus/${orderId}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val(),
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ 
                    status: 'Processing',
                    reason: reason 
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    $('#reverseOrderModal').modal('hide');
                    showToast('Order successfully reversed to Processing status', 'success');
                    setTimeout(() => location.reload(), 2000);
                } else {
                    showToast('Failed to reverse order: ' + data.message, 'danger');
                }
            })
            .catch(error => {
                showToast('Error reversing order: ' + error.message, 'danger');
            })
            .finally(() => {
                button.prop('disabled', false).html('<i class="fas fa-undo mr-1"></i>Reverse Order');
            });
        }

        function updateOrderStatusDetailed(orderId) {
            const newStatus = $('#newStatus').val();
            const button = $('.modal-footer .btn-primary');
            
            button.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i>Updating...');

            fetch(`/Orders/ChangeStatus/${orderId}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val(),
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ status: newStatus })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    $('#statusChangeModal').modal('hide');
                    showToast(data.message, 'success');
                    setTimeout(() => location.reload(), 2000);
                } else {
                    showToast('Failed to change status: ' + data.message, 'danger');
                }
            })
            .catch(error => {
                showToast('Error changing status: ' + error.message, 'danger');
            })
            .finally(() => {
                button.prop('disabled', false).html('<i class="fas fa-check mr-1"></i>Update Status');
            });
        }

        function reorderFromDetails(orderId) {
            if (confirm('Create a new order based on this completed order?')) {
                fetch(`/Orders/Reorder/${orderId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showToast('Reorder created successfully!', 'success');
                        setTimeout(() => {
                            window.location.href = `/Orders/Edit/${data.newOrderId}`;
                        }, 1500);
                    } else {
                        showToast('Failed to create reorder: ' + data.message, 'danger');
                    }
                })
                .catch(error => {
                    showToast('Error creating reorder: ' + error.message, 'danger');
                });
            }
        }

        function showToast(message, type) {
            const toastHtml = `
                <div class="toast align-items-center text-white bg-${type} border-0" role="alert" style="min-width: 350px;">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-triangle'} mr-2"></i>
                            ${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;
            
            if (!$('.toast-container').length) {
                $('body').append('<div class="toast-container position-fixed top-0 end-0 p-3"></div>');
            }
            
            $('.toast-container').append(toastHtml);
            $('.toast:last').toast('show');
            
            setTimeout(() => {
                $('.toast:first').remove();
            }, 5000);
        }
    </script>
}

@Html.AntiForgeryToken()