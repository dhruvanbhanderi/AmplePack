@page
@model AmplePack.Pages.TestDbModel
@{
    ViewData["Title"] = "Database Test";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Database Connection & CRUD Test</h3>
            </div>
            <div class="card-body">
                <div class="alert @(Model.ConnectionStatus.StartsWith("?") ? "alert-success" : "alert-danger")">
                    @Model.ConnectionStatus
                </div>

                <!-- Statistics Row -->
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="info-box">
                            <span class="info-box-icon bg-info"><i class="fas fa-users"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">Customers</span>
                                <span class="info-box-number">@Model.CustomerCount</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="info-box">
                            <span class="info-box-icon bg-success"><i class="fas fa-layer-group"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">Product Patterns</span>
                                <span class="info-box-number">@Model.ProductPatternsCount</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="info-box">
                            <span class="info-box-icon bg-warning"><i class="fas fa-shopping-cart"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">Orders</span>
                                <span class="info-box-number">@Model.OrdersCount</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="info-box">
                            <span class="info-box-icon bg-danger"><i class="fas fa-database"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">Status</span>
                                <span class="info-box-number">@(Model.ConnectionStatus.StartsWith("?") ? "OK" : "ERROR")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <!-- Test Actions -->
                    <div class="col-md-4">
                        <h5>Test Actions</h5>
                        <div class="btn-group-vertical w-100 mb-3">
                            <form method="post" asp-page-handler="CreateTestCustomer" class="mb-2">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="fas fa-user-plus"></i> Create Test Customer
                                </button>
                            </form>
                            <form method="post" asp-page-handler="CreateTestProduct" class="mb-2">
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="fas fa-box"></i> Create Test Product Pattern
                                </button>
                            </form>
                            <form method="post" asp-page-handler="CreateTestOrder" class="mb-2">
                                <button type="submit" class="btn btn-warning w-100">
                                    <i class="fas fa-shopping-cart"></i> Create Basic Test Order
                                </button>
                            </form>
                            <form method="post" asp-page-handler="CreateTestCompleteOrder" class="mb-2">
                                <button type="submit" class="btn btn-info w-100">
                                    <i class="fas fa-check-double"></i> Create Complete Test Order
                                </button>
                            </form>
                            <form method="post" asp-page-handler="TestOrderDetails" class="mb-2">
                                <button type="submit" class="btn btn-dark w-100">
                                    <i class="fas fa-microscope"></i> Test Order Details & BoxType
                                </button>
                            </form>
                            <form method="post" asp-page-handler="CheckDatabaseSchema" class="mb-2">
                                <button type="submit" class="btn btn-outline-primary w-100">
                                    <i class="fas fa-database"></i> Check Database Schema
                                </button>
                            </form>
                            <form method="post" asp-page-handler="TestWorkflowOrder" class="mb-2">
                                <button type="submit" class="btn btn-outline-success w-100">
                                    <i class="fas fa-project-diagram"></i> Test Workflow Order
                                </button>
                            </form>
                            <form method="post" asp-page-handler="TestCompleteWorkflow" class="mb-2">
                                <button type="submit" class="btn btn-outline-info w-100">
                                    <i class="fas fa-mobile-alt"></i> Test Complete Mobile Workflow
                                </button>
                            </form>
                        </div>
                        
                        <h6>Navigation</h6>
                        <div class="btn-group-vertical w-100">
                            <a asp-page="/Orders/Create" class="btn btn-outline-primary mb-1">
                                <i class="fas fa-plus"></i> New Order (Enhanced)
                            </a>
                            <a asp-page="/CustomerProducts/Index" class="btn btn-outline-success mb-1">
                                <i class="fas fa-layer-group"></i> Product Patterns
                            </a>
                            <a asp-page="/Orders/Index" class="btn btn-outline-info mb-1">
                                <i class="fas fa-list"></i> All Orders
                            </a>
                        </div>
                    </div>
                    
                    <!-- Recent Customers -->
                    <div class="col-md-4">
                        <h5>Recent Customers (@Model.CustomerCount)</h5>
                        @if (Model.Customers.Any())
                        {
                            @foreach (var customer in Model.Customers.Take(5))
                            {
                                <div class="card card-outline card-primary mb-2">
                                    <div class="card-body p-2">
                                        <h6 class="card-title mb-1">@customer.Name</h6>
                                        <small class="text-muted">
                                            @customer.Email<br>
                                            @customer.Contact
                                        </small>
                                        <div class="mt-1">
                                            <span class="badge badge-primary">ID: @customer.Id</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">No customers found in database.</p>
                            <a asp-page="/Customers/Create" class="btn btn-sm btn-primary">Create First Customer</a>
                        }
                    </div>

                    <!-- Recent Orders & Patterns -->
                    <div class="col-md-4">
                        <h5>Recent Orders (@Model.OrdersCount)</h5>
                        @if (Model.Orders.Any())
                        {
                            @foreach (var order in Model.Orders)
                            {
                                <div class="card card-outline card-warning mb-2">
                                    <div class="card-body p-2">
                                        <h6 class="card-title mb-1">Order #@order.Id</h6>
                                        <small class="text-muted">
                                            Customer: @order.Customer?.Name<br>
                                            Date: @order.Date.ToString("MM/dd/yyyy")<br>
                                            Amount: $@order.TotalAmount<br>
                                            Items: @order.OrderDetails.Count()
                                        </small>
                                        <div class="mt-1">
                                            <span class="badge @(order.Status == "Completed" ? "badge-success" : order.Status == "Pending" ? "badge-warning" : "badge-info")">
                                                @order.Status
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">No orders found.</p>
                            <a asp-page="/Orders/Create" class="btn btn-sm btn-warning">Create First Order</a>
                        }

                        @if (Model.CustomerProducts.Any())
                        {
                            <h6 class="mt-3">Sample Product Patterns</h6>
                            @foreach (var product in Model.CustomerProducts.Take(3))
                            {
                                <div class="card card-outline card-success mb-1">
                                    <div class="card-body p-1">
                                        <small>
                                            <strong>@product.ProductName</strong><br>
                                            @product.Customer?.Name - @product.SizeDisplay
                                        </small>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- Enhanced Order Create Test -->
                <div class="mt-4">
                    <div class="alert alert-info">
                        <h5><i class="fas fa-star text-warning"></i> Enhanced Order Create Features</h5>
                        <ul class="mb-0">
                            <li><strong>Separate dimension inputs</strong> - Length × Width × Height in separate boxes</li>
                            <li><strong>Customer product patterns</strong> - Auto-load saved patterns when customer is selected</li>
                            <li><strong>One-click pattern addition</strong> - Click on a pattern to add it to the order</li>
                            <li><strong>Improved add/remove</strong> - Better row management with duplicate functionality</li>
                            <li><strong>Real-time calculations</strong> - Automatic total updates</li>
                            <li><strong>Form validation</strong> - Complete field validation with helpful messages</li>
                        </ul>
                        <div class="mt-2">
                            <a asp-page="/Orders/Create" class="btn btn-primary">
                                <i class="fas fa-rocket"></i> Try Enhanced Order Create
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>