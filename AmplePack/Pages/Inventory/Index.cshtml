@page
@model AmplePack.Pages_Inventory.IndexModel
@{
    ViewData["Title"] = "Inventory";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Inventory Management</h3>
        <div class="card-tools">
          <a asp-page="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add Item
          </a>
        </div>
      </div>
      <!-- /.card-header -->
      <div class="card-body">
        <table id="inventoryTable" class="table table-bordered table-hover">
          <thead>
          <tr>
            <th>@Html.DisplayNameFor(model => model.Inventory[0].Id)</th>
            <th>@Html.DisplayNameFor(model => model.Inventory[0].ItemName)</th>
            <th>@Html.DisplayNameFor(model => model.Inventory[0].Quantity)</th>
            <th>@Html.DisplayNameFor(model => model.Inventory[0].Unit)</th>
            <th>@Html.DisplayNameFor(model => model.Inventory[0].ReorderLevel)</th>
            <th>Stock Status</th>
            <th>Actions</th>
          </tr>
          </thead>
          <tbody>
          @foreach (var item in Model.Inventory) {
              <tr>
                  <td>@Html.DisplayFor(modelItem => item.Id)</td>
                  <td>
                    <div class="d-flex align-items-center">
                      <div class="mr-2">
                        <i class="fas fa-box text-primary"></i>
                      </div>
                      <div>
                        <strong>@Html.DisplayFor(modelItem => item.ItemName)</strong>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class="badge @(item.Quantity > 50 ? "badge-success" : item.Quantity > item.ReorderLevel ? "badge-warning" : "badge-danger")">
                      @Html.DisplayFor(modelItem => item.Quantity)
                    </span>
                  </td>
                  <td>@Html.DisplayFor(modelItem => item.Unit)</td>
                  <td>@Html.DisplayFor(modelItem => item.ReorderLevel)</td>
                  <td>
                    @if (item.Quantity > 50)
                    {
                      <span class="badge badge-success">In Stock</span>
                    }
                    else if (item.Quantity > item.ReorderLevel)
                    {
                      <span class="badge badge-warning">Low Stock</span>
                    }
                    else if (item.Quantity > 0)
                    {
                      <span class="badge badge-danger">Very Low</span>
                    }
                    else
                    {
                      <span class="badge badge-dark">Out of Stock</span>
                    }
                  </td>
                  <td>
                    <div class="btn-group">
                      <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary" title="Edit">
                        <i class="fas fa-edit"></i>
                      </a>
                      <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Details">
                        <i class="fas fa-eye"></i>
                      </a>
                      <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Delete">
                        <i class="fas fa-trash"></i>
                      </a>
                    </div>
                  </td>
              </tr>
          }
          </tbody>
          <tfoot>
          <tr>
            <th>ID</th>
            <th>Item Name</th>
            <th>Quantity</th>
            <th>Unit</th>
            <th>Reorder Level</th>
            <th>Stock Status</th>
            <th>Actions</th>
          </tr>
          </tfoot>
        </table>
      </div>
      <!-- /.card-body -->
    </div>
    <!-- /.card -->
  </div>
  <!-- /.col -->
</div>
<!-- /.row -->

@section Scripts {
  <!-- DataTables  & Plugins -->
  <script src="https://cdn.datatables.net/1.11.4/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.11.4/js/dataTables.bootstrap4.min.js"></script>
  <script>
    $(function () {
      $("#inventoryTable").DataTable({
        "responsive": true, 
        "lengthChange": false, 
        "autoWidth": false,
        "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"]
      }).buttons().container().appendTo('#inventoryTable_wrapper .col-md-6:eq(0)');
    });
  </script>
}