@model IEnumerable<AmplePack.Models.Order>
@{
    ViewData["Title"] = "Orders Management";
}

<!-- Content Header -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Orders Management</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                    <li class="breadcrumb-item active">Orders</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        
        <!-- Stats Row -->
        <div class="row">
            <div class="col-lg-3 col-6">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3>@ViewBag.TotalOrders</h3>
                        <p>Total Orders</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <a asp-action="CreateWorkflow" class="small-box-footer">
                        Create New Order <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3>@ViewBag.PendingOrders</h3>
                        <p>Pending Orders</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <a href="#" onclick="filterByStatus('Pending')" class="small-box-footer">
                        View Pending <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-primary">
                    <div class="inner">
                        <h3>@ViewBag.ProcessingOrders</h3>
                        <p>Processing</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-cog"></i>
                    </div>
                    <a href="#" onclick="filterByStatus('Processing')" class="small-box-footer">
                        View Processing <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3>@ViewBag.CompletedOrders</h3>
                        <p>Completed</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-check"></i>
                    </div>
                    <a asp-action="Completed" class="small-box-footer">
                        View Completed <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Filter Row -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-filter mr-2"></i>
                            Order Filters
                        </h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <form method="get" class="row">
                            <div class="col-md-2 mb-3">
                                <label for="statusFilter" class="form-label">Status</label>
                                <select name="statusFilter" id="statusFilter" class="form-control">
                                    <option value="">All Active Statuses</option>
                                    @{
                                        var statusFilter = ViewBag.StatusFilter as string;
                                    }
                                    <option value="Pending" selected="@(statusFilter == "Pending")">Pending</option>
                                    <option value="Processing" selected="@(statusFilter == "Processing")">Processing</option>
                                </select>
                            </div>
                            <div class="col-md-2 mb-3">
                                <label for="customerFilter" class="form-label">Customer</label>
                                <select name="customerFilter" id="customerFilter" class="form-control">
                                    <option value="">All Customers</option>
                                    @{
                                        var customerFilter = ViewBag.CustomerFilter as string;
                                    }
                                    @foreach (var customer in ViewBag.Customers as List<AmplePack.Models.Customer>)
                                    {
                                        <option value="@customer.Id" selected="@(customerFilter == customer.Id.ToString())">@customer.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2 mb-3">
                                <label for="startDate" class="form-label">Date From</label>
                                <input type="date" name="startDate" id="startDate" class="form-control" value="@ViewBag.StartDate">
                            </div>
                            <div class="col-md-2 mb-3">
                                <label for="endDate" class="form-label">Date To</label>
                                <input type="date" name="endDate" id="endDate" class="form-control" value="@ViewBag.EndDate">
                            </div>
                            <div class="col-md-2 mb-3">
                                <label for="searchTerm" class="form-label">Search</label>
                                <input type="text" name="searchTerm" id="searchTerm" class="form-control" 
                                       placeholder="Order ID, Customer, Items..." value="@ViewBag.SearchTerm">
                            </div>
                            <div class="col-md-2 mb-3">
                                <label class="form-label">&nbsp;</label>
                                <div class="d-flex flex-column gap-2">
                                    <button type="submit" class="btn btn-primary btn-sm">
                                        <i class="fas fa-search mr-1"></i>
                                        Filter
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary btn-sm">
                                        <i class="fas fa-times mr-1"></i>
                                        Clear
                                    </a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Orders Table -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-list mr-2"></i>
                            Active Orders
                        </h3>
                        <div class="card-tools">
                            <a asp-action="CreateWorkflow" class="btn btn-primary btn-sm">
                                <i class="fas fa-plus mr-1"></i>
                                New Order
                            </a>
                            <div class="btn-group ml-1">
                                <button type="button" class="btn btn-info btn-sm dropdown-toggle" data-toggle="dropdown">
                                    <i class="fas fa-download mr-1"></i>Export
                                </button>
                                <div class="dropdown-menu dropdown-menu-right">
                                    <a class="dropdown-item" href="javascript:void(0)" onclick="exportOrders('csv')">
                                        <i class="fas fa-file-csv mr-2 text-success"></i>Export as CSV (Recommended)
                                    </a>
                                    <a class="dropdown-item" href="javascript:void(0)" onclick="exportOrders('pdf')">
                                        <i class="fas fa-file-pdf mr-2 text-danger"></i>Export as PDF (Limited)
                                    </a>
                                    <div class="dropdown-divider"></div>
                                    <div class="dropdown-header">
                                        <small class="text-muted">
                                            <i class="fas fa-info-circle mr-1"></i>
                                            CSV includes all data
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="ordersTable" class="table table-bordered table-striped data-table">
                                <thead>
                                    <tr>
                                        <th>Order</th>
                                        <th>Customer</th>
                                        <th>Items</th>
                                        <th>Total</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                        <th class="no-sort" style="width: 180px">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Any())
                                    {
                                        @foreach (var order in Model)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="d-flex flex-column">
                                                        <strong>@($"#CP{order.Id:D3}")</strong>
                                                        <small class="text-muted">@order.Date.ToString("MMM dd, yyyy")</small>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="customer-info">
                                                        <strong>@(order.Customer?.Name ?? "Unknown")</strong>
                                                        <small class="text-muted">@(order.Customer?.Contact ?? "")</small>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="items-display">
                                                        @if (order.OrderDetails?.Any() == true)
                                                        {
                                                            var firstItem = order.OrderDetails.First();
                                                            <span class="items-badge">
                                                                @firstItem.BoxType (@firstItem.Quantity.ToString() Boxes)
                                                            </span>
                                                            @if (order.OrderDetails.Count > 1)
                                                            {
                                                                <div class="items-more">
                                                                    +@(order.OrderDetails.Count - 1) more item@(order.OrderDetails.Count > 2 ? "s" : "")
                                                                </div>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">No items</span>
                                                        }
                                                    </div>
                                                </td>
                                                <td class="currency">@AmplePack.Helpers.CurrencyHelper.FormatCurrency(order.TotalAmount)</td>
                                                <td>
                                                    <span class="status-badge status-@order.Status.ToLower()">
                                                        @order.Status
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="d-flex flex-column">
                                                        <small>@order.Date.ToString("MMM dd")</small>
                                                        <small class="text-muted">@order.Date.ToString("HH:mm")</small>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="btn-group">
                                                        <button type="button" class="btn btn-default btn-sm dropdown-toggle" 
                                                                data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                            <i class="fas fa-cog"></i>
                                                            Actions
                                                        </button>
                                                        <div class="dropdown-menu dropdown-menu-right">
                                                            <a class="dropdown-item" asp-action="Details" asp-route-id="@order.Id">
                                                                <i class="fas fa-eye mr-2"></i>
                                                                View Details
                                                            </a>
                                                            <a class="dropdown-item" asp-action="Edit" asp-route-id="@order.Id">
                                                                <i class="fas fa-edit mr-2"></i>
                                                                Edit Order
                                                            </a>
                                                            <div class="dropdown-divider"></div>
                                                            <a class="dropdown-item" href="javascript:void(0)" 
                                                               onclick="changeOrderStatus(@order.Id, '@order.Status')">
                                                                <i class="fas fa-exchange-alt mr-2"></i>
                                                                Change Status
                                                            </a>
                                                            <a class="dropdown-item" href="javascript:void(0)" 
                                                               onclick="generateInvoice(@order.Id)">
                                                                <i class="fas fa-file-invoice mr-2"></i>
                                                                Generate Invoice
                                                            </a>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center text-muted py-4">
                                                <i class="fas fa-inbox fa-3x mb-3"></i>
                                                <br>
                                                No orders found. <a asp-action="CreateWorkflow">Create your first order</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <!-- DataTables & Plugins -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap4.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap4.min.js"></script>
    
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        $(document).ready(function() {
            // Initialize DataTable
            $('#ordersTable').DataTable({
                responsive: true,
                autoWidth: false,
                pageLength: 25,
                order: [[5, 'desc']], // Sort by date descending
                columnDefs: [
                    { orderable: false, targets: [6] }, // Actions column
                    { responsivePriority: 1, targets: 0 }, // Order ID
                    { responsivePriority: 2, targets: 1 }, // Customer
                    { responsivePriority: 3, targets: 4 }, // Status
                    { responsivePriority: 4, targets: 6 }  // Actions
                ],
                language: {
                    search: "Search orders:",
                    lengthMenu: "Show _MENU_ orders per page",
                    info: "Showing _START_ to _END_ of _TOTAL_ orders",
                    emptyTable: "No orders found",
                    zeroRecords: "No matching orders found"
                }
            });
        });

        // Order management functions
        function filterByStatus(status) {
            $('#statusFilter').val(status);
            $('form').submit();
        }

        function duplicateOrder(orderId) {
            Swal.fire({
                title: 'Duplicate Order',
                text: 'Do you want to create a copy of this order?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, duplicate it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = `/Orders/Duplicate/${orderId}`;
                }
            });
        }

        function confirmDelete(orderId) {
            Swal.fire({
                title: 'Delete Order?',
                text: 'Are you sure you want to delete this order? This action cannot be undone.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = `/Orders/Delete/${orderId}`;
                }
            });
        }
        
        function changeOrderStatus(orderId, currentStatus) {
            // Use the OrderManager from app.js if available
            if (typeof window.OrderManager !== 'undefined' && window.OrderManager.changeStatus) {
                window.OrderManager.changeStatus(orderId, currentStatus);
            } else {
                // Fallback implementation
                const statuses = ['Pending', 'Processing', 'Completed', 'Delivered', 'Cancelled'];
                const options = statuses.map(status => 
                    `<option value="${status}" ${status === currentStatus ? 'selected' : ''}>${status}</option>`
                ).join('');

                Swal.fire({
                    title: 'Change Order Status',
                    html: `
                        <div class="form-group">
                            <label for="newStatus">New Status</label>
                            <select class="form-control" id="newStatus">
                                ${options}
                            </select>
                        </div>
                        <div class="alert alert-info">
                            <small>Current status: <strong>${currentStatus}</strong></small>
                        </div>
                    `,
                    showCancelButton: true,
                    confirmButtonText: 'Update Status',
                    cancelButtonText: 'Cancel',
                    preConfirm: () => {
                        const newStatus = document.getElementById('newStatus').value;
                        return { newStatus: newStatus };
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        const newStatus = result.value.newStatus;
                        
                        // Make AJAX call to update status
                        fetch(`/Orders/ChangeStatus/${orderId}`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                            },
                            body: JSON.stringify({ status: newStatus })
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire('Success!', 'Order status updated successfully', 'success');
                                setTimeout(() => location.reload(), 1000);
                            } else {
                                Swal.fire('Error!', data.message || 'Failed to update status', 'error');
                            }
                        })
                        .catch(error => {
                            Swal.fire('Error!', 'An error occurred while updating status', 'error');
                        });
                    }
                });
            }
        }
        
        function generateInvoice(orderId) {
            // Use the OrderManager from app.js if available
            if (typeof window.OrderManager !== 'undefined' && window.OrderManager.generateInvoice) {
                window.OrderManager.generateInvoice(orderId);
            } else {
                // Enhanced fallback implementation
                const button = event?.target?.closest('a, button');
                
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        title: 'Generating Invoice...',
                        text: 'Please wait while we prepare your PDF invoice.',
                        icon: 'info',
                        showConfirmButton: false,
                        timer: 1500,
                        timerProgressBar: true
                    });
                }
                
                if (button) {
                    const originalText = button.innerHTML;
                    button.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i>Generating...';
                    button.disabled = true;
                    
                    setTimeout(() => {
                        button.innerHTML = originalText;
                        button.disabled = false;
                    }, 3000);
                }
                
                // Open invoice in new tab - using both endpoints for compatibility
                const invoiceUrl = `/Orders/GenerateInvoice/${orderId}`;
                window.open(invoiceUrl, '_blank');
            }
        }
        
        function exportOrders(format) {
            // Validate format - only allow PDF and CSV
            if (format !== 'pdf' && format !== 'csv') {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        title: 'Invalid Format',
                        text: 'Only PDF and CSV exports are supported.',
                        icon: 'error'
                    });
                }
                return;
            }

            const button = event?.target?.closest('a, button');
            const originalText = button?.innerHTML || 'Export';
            
            if (button) {
                button.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i>Generating...';
                button.disabled = true;
            }
            
            // Get current filter values
            const params = new URLSearchParams();
            
            const customerFilter = document.getElementById('customerFilter')?.value;
            const statusFilter = document.getElementById('statusFilter')?.value;
            const startDate = document.getElementById('startDate')?.value;
            const endDate = document.getElementById('endDate')?.value;
            const searchTerm = document.getElementById('searchTerm')?.value;
            
            if (customerFilter) params.append('customerFilter', customerFilter);
            if (statusFilter) params.append('statusFilter', statusFilter);
            if (startDate) params.append('startDate', startDate);
            if (endDate) params.append('endDate', endDate);
            if (searchTerm) params.append('searchTerm', searchTerm);
            params.append('format', format);
            
            const exportUrl = `/Orders/Export?${params.toString()}`;
            
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: 'Generating Export...',
                    text: `Please wait while we prepare your ${format.toUpperCase()} file.`,
                    icon: 'info',
                    showConfirmButton: false,
                    timer: 2000
                });
            }
            
            // Create a temporary link to trigger download
            const link = document.createElement('a');
            link.href = exportUrl;
            link.download = `orders_export_${new Date().getTime()}.${format}`;
            link.style.display = 'none';
            
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            
            // Restore button after delay
            setTimeout(() => {
                if (button) {
                    button.innerHTML = originalText;
                    button.disabled = false;
                }
                
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        title: 'Export Complete!',
                        text: `Your ${format.toUpperCase()} file has been downloaded.`,
                        icon: 'success',
                        timer: 2000,
                        showConfirmButton: false
                    });
                }
            }, 2500);
        }
    </script>
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap4.min.css">
    
    <style>
        .items-display {
            max-width: 200px;
        }
        
        .gap-2 {
            gap: 0.5rem;
        }
        
        .d-flex.gap-2 > * {
            margin-right: 0.5rem;
        }
        
        .d-flex.gap-2 > *:last-child {
            margin-right: 0;
        }
        
        .status-pending {
            background-color: #fff3cd;
            color: #856404;
            border: 1px solid #ffeaa7;
        }
        
        .status-processing {
            background-color: #cfe2ff;
            color: #084298;
            border: 1px solid #b6d4fe;
        }
        
        .status-completed {
            background-color: #d1e7dd;
            color: #0f5132;
            border: 1px solid #badbcc;
        }
        
        .status-delivered {
            background-color: #d1ecf1;
            color: #0c5460;
            border: 1px solid #b8daff;
        }
        
        .status-cancelled {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
    </style>
}

@Html.AntiForgeryToken()