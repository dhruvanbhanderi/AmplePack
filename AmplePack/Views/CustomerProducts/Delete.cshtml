@model AmplePack.Models.CustomerProduct
@{
    ViewData["Title"] = "Delete Customer Product";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Delete Customer Product</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <div class="card card-danger">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-exclamation-triangle mr-2"></i>
                            Confirm Deletion
                        </h3>
                    </div>
                    
                    <div class="card-body">
                        <div class="alert alert-danger">
                            <h5><i class="fas fa-exclamation-triangle"></i> Warning!</h5>
                            Are you sure you want to delete this customer product? This action cannot be undone and may affect existing orders.
                        </div>
                        
                        <dl class="row">
                            <dt class="col-sm-3">Customer:</dt>
                            <dd class="col-sm-9">@Model.Customer?.Name</dd>
                            
                            <dt class="col-sm-3">Product Name:</dt>
                            <dd class="col-sm-9">@Model.ProductName</dd>
                            
                            <dt class="col-sm-3">Description:</dt>
                            <dd class="col-sm-9">@Model.Description</dd>
                            
                            <dt class="col-sm-3">Dimensions:</dt>
                            <dd class="col-sm-9">@Model.SizeDisplay</dd>
                            
                            <dt class="col-sm-3">Specifications:</dt>
                            <dd class="col-sm-9">@Model.SpecificationDisplay</dd>
                            
                            <dt class="col-sm-3">Price per Box:</dt>
                            <dd class="col-sm-9">
                                <strong class="text-success">$@Model.PricePerBox.ToString("N2")</strong>
                            </dd>
                            
                            <dt class="col-sm-3">Category:</dt>
                            <dd class="col-sm-9">
                                <span class="badge badge-info">@Model.Category</span>
                            </dd>
                            
                            <dt class="col-sm-3">Status:</dt>
                            <dd class="col-sm-9">
                                <span class="badge badge-@(Model.IsActive ? "success" : "secondary")">
                                    @(Model.IsActive ? "Active" : "Inactive")
                                </span>
                            </dd>
                            
                            <dt class="col-sm-3">Total Orders:</dt>
                            <dd class="col-sm-9">
                                <span class="badge badge-primary">@Model.TotalOrdersCount orders</span>
                            </dd>
                        </dl>
                        
                        @if (Model.TotalOrdersCount > 0)
                        {
                            <div class="alert alert-warning">
                                <strong>Impact Notice:</strong> This product has been used in @Model.TotalOrdersCount order(s). 
                                Deleting this product will not affect existing orders, but it will no longer be available for new orders.
                            </div>
                        }
                    </div>
                    
                    <div class="card-footer">
                        <form asp-action="Delete" method="post" class="d-inline">
                            <input type="hidden" asp-for="Id" />
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Are you absolutely sure you want to delete this customer product? This action cannot be undone.')">
                                <i class="fas fa-trash"></i> Yes, Delete Product
                            </button>
                        </form>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info ml-2">
                            <i class="fas fa-eye"></i> View Details
                        </a>
                        <a asp-action="Index" class="btn btn-secondary ml-2">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>