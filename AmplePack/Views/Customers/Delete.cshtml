@using AmplePack.Helpers
@model AmplePack.Models.Customer
@{
    ViewData["Title"] = "Delete Customer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Delete Customer</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <div class="card card-danger">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-exclamation-triangle"></i> Delete Customer
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-warning">
                            <h5><i class="icon fas fa-exclamation-triangle"></i> Warning!</h5>
                            Are you sure you want to delete this customer? This action cannot be undone and will also delete:
                            <ul class="mb-0 mt-2">
                                <li>All customer orders (@Model.Orders.Count orders)</li>
                                <li>All customer products (@Model.CustomerProducts.Count products)</li>
                                <li>All related order details and history</li>
                            </ul>
                        </div>

                        <div class="row">
                            <div class="col-md-4 text-center">
                                <img class="img-fluid img-circle"
                                     src="https://adminlte.io/themes/v3/dist/img/user4-128x128.jpg"
                                     alt="Customer profile picture"
                                     style="width: 100px; height: 100px;">
                            </div>
                            <div class="col-md-8">
                                <table class="table table-borderless">
                                    <tr>
                                        <th><i class="fas fa-hashtag mr-1"></i> Customer ID:</th>
                                        <td><strong>#@Model.Id</strong></td>
                                    </tr>
                                    <tr>
                                        <th><i class="fas fa-user mr-1"></i> Name:</th>
                                        <td>@Model.Name</td>
                                    </tr>
                                    <tr>
                                        <th><i class="fas fa-envelope mr-1"></i> Email:</th>
                                        <td>
                                            @if (!string.IsNullOrEmpty(Model.Email))
                                            {
                                                <a href="mailto:@Model.Email">@Model.Email</a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not provided</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <th><i class="fas fa-phone mr-1"></i> Contact:</th>
                                        <td>
                                            @if (!string.IsNullOrEmpty(Model.Contact))
                                            {
                                                <a href="tel:@Model.Contact">@Model.Contact</a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not provided</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <th><i class="fas fa-map-marker-alt mr-1"></i> Address:</th>
                                        <td>
                                            @if (!string.IsNullOrEmpty(Model.Address))
                                            {
                                                @Model.Address
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not provided</span>
                                            }
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        @if (Model.Orders.Any() || Model.CustomerProducts.Any())
                        {
                            <hr>
                            <div class="row">
                                @if (Model.Orders.Any())
                                {
                                    <div class="col-md-6">
                                        <h6><i class="fas fa-shopping-cart mr-1"></i> Recent Orders (@Model.Orders.Count):</h6>
                                        <div class="list-group list-group-flush">
                                            @foreach (var order in Model.Orders.OrderByDescending(o => o.Date).Take(3))
                                            {
                                                <div class="list-group-item p-2">
                                                    <strong>Order #@order.Id</strong>
                                                    <span class="badge @(order.Status == "Completed" ? "badge-success" : order.Status == "Pending" ? "badge-warning" : order.Status == "Processing" ? "badge-info" : "badge-danger") badge-sm float-right">
                                                        @order.Status
                                                    </span><br>
                                                    <small class="text-muted">
                                                        @order.Date.ToString("MMM dd, yyyy") – @CurrencyHelper.FormatCurrency(order.TotalAmount)
                                                    </small>
                                                </div>
                                            }
                                            @if (Model.Orders.Count > 3)
                                            {
                                                <div class="list-group-item p-2 text-muted">
                                                    <small><i class="fas fa-ellipsis-h mr-1"></i>...and @(Model.Orders.Count - 3) more orders</small>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (Model.CustomerProducts.Any())
                                {
                                    <div class="col-md-6">
                                        <h6><i class="fas fa-cube mr-1"></i> Customer Products (@Model.CustomerProducts.Count):</h6>
                                        <div class="list-group list-group-flush">
                                            @foreach (var product in Model.CustomerProducts.Take(3))
                                            {
                                                <div class="list-group-item p-2">
                                                    <strong>@product.ProductName</strong>
                                                    <span class="badge @(product.IsActive ? "badge-success" : "badge-secondary") badge-sm float-right">
                                                        @(product.IsActive ? "Active" : "Inactive")
                                                    </span><br>
                                                    <small class="text-muted">
                                                        @product.Length×@product.Width×@product.Height – @CurrencyHelper.FormatCurrency(product.PricePerBox)
                                                    </small>
                                                </div>
                                            }
                                            @if (Model.CustomerProducts.Count > 3)
                                            {
                                                <div class="list-group-item p-2 text-muted">
                                                    <small><i class="fas fa-ellipsis-h mr-1"></i>...and @(Model.CustomerProducts.Count - 3) more products</small>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="alert alert-info mt-3">
                                <i class="fas fa-info-circle mr-1"></i>
                                <strong>Impact Summary:</strong>
                                Deleting this customer will permanently remove:
                                <ul class="mb-0 mt-1">
                                    <li>@Model.Orders.Count order(s) worth @CurrencyHelper.FormatCurrency(Model.Orders.Sum(o => o.TotalAmount))</li>
                                    <li>@Model.CustomerProducts.Count product template(s)</li>
                                    <li>All associated order details and history</li>
                                </ul>
                            </div>
                        }
                    </div>
                    <div class="card-footer">
                        <form asp-action="Delete" method="post">
                            <input type="hidden" asp-for="Id" />
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Are you absolutely sure you want to delete this customer and ALL associated data? This action cannot be undone!')">
                                <i class="fas fa-trash"></i> Yes, Delete Customer
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info">
                                <i class="fas fa-eye"></i> View Details
                            </a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>