@{
    ViewData["Title"] = "Account Locked";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-warning text-dark">
                <h4 class="card-title mb-0">
                    <i class="fas fa-lock mr-2"></i>
                    Account Locked
                </h4>
            </div>
            <div class="card-body text-center">
                <div class="mb-4">
                    <i class="fas fa-user-lock text-warning" style="font-size: 4rem;"></i>
                </div>
                <h5 class="mb-3">Your account has been temporarily locked.</h5>
                <p class="text-muted">
                    This is due to multiple failed login attempts. Please try again later or contact support if you need immediate assistance.
                </p>
                <div class="mt-4">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary mr-2">
                        <i class="fas fa-sign-in-alt mr-2"></i>
                        Try Login Again
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-home mr-2"></i>
                        Return to Home
                    </a>
                </div>
                <div class="mt-3">
                    <small class="text-muted">
                        If you continue to experience issues, please contact our support team.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>