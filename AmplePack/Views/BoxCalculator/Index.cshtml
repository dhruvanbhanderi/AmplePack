@model BoxCalculatorViewModel
@{
    ViewData["Title"] = "Box Rate Calculator";
}

<!-- Content Header -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Box Rate Calculator</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Tools</a></li>
                    <li class="breadcrumb-item active">Box Rate Calculator</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-calculator mr-2"></i>Advanced Box Price Calculator
                        </h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <form asp-action="Calculate" method="post" id="calculatorForm">
                            @Html.AntiForgeryToken()
                            
                            <!-- Quick Controls Row -->
                            <div class="row mb-4">
                                <div class="col-md-3">
                                    <label asp-for="Input.Mode" class="form-label">Box Type</label>
                                    <select asp-for="Input.Mode" class="form-control" id="modeSelect">
                                        <option value="single-liner">Single Wall (3-Ply)</option>
                                        <option value="dual-liner">Double Wall (3-Ply + 5-Ply)</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Quick Setup</label>
                                    <select class="form-control" id="presetSelect">
                                        <option value="">Custom Setup</option>
                                        <option value="single-liner-default">Standard Single Wall</option>
                                        <option value="dual-liner-default">Standard Double Wall</option>
                                        <option value="economy">Economy Grade</option>
                                        <option value="premium">Premium Grade</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Sheet Size</label>
                                    <select class="form-control" id="sheetSizeSelect">
                                        <option value="">Select Sheet Size</option>
                                        <option value="20x30">20" × 30"</option>
                                        <option value="22x32">22" × 32"</option>
                                        <option value="25x35">25" × 35"</option>
                                        <option value="28x40">28" × 40"</option>
                                        <option value="30x40">30" × 40"</option>
                                        <option value="custom">Custom Size</option>
                                    </select>
                                </div>
                                <div class="col-md-3 d-flex align-items-end">
                                    <button type="submit" class="btn btn-success btn-block">
                                        <i class="fas fa-calculator mr-1"></i>Calculate
                                    </button>
                                </div>
                            </div>

                            <!-- Custom Sheet Size Input (Hidden by default) -->
                            <div class="row mb-3" id="customSheetSizeRow" style="display: none;">
                                <div class="col-md-6">
                                    <label class="form-label">Custom Sheet Length (inches)</label>
                                    <input type="number" class="form-control" id="customSheetLength" step="0.1" placeholder="30.0">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Custom Sheet Width (inches)</label>
                                    <input type="number" class="form-control" id="customSheetWidth" step="0.1" placeholder="40.0">
                                </div>
                            </div>

                            <!-- Box Layout Visualization -->
                            <div class="row mb-4" id="layoutVisualizationSection" style="display: none;">
                                <div class="col-12">
                                    <div class="card card-info">
                                        <div class="card-header">
                                            <h3 class="card-title">
                                                <i class="fas fa-th mr-2"></i>Box Layout Analysis
                                            </h3>
                                            <div class="card-tools">
                                                <span class="badge badge-success" id="boxCountBadge">0 boxes per sheet</span>
                                            </div>
                                        </div>
                                        <div class="card-body p-2">
                                            <div id="layoutVisualization"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Box Dimensions & Quantities -->
                            <div class="card mb-3">
                                <div class="card-header">
                                    <h5 class="card-title">
                                        <i class="fas fa-cube mr-2"></i>Box Dimensions & Quantities
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <h6 class="text-primary"><i class="fas fa-ruler mr-2"></i>Box Dimensions (inches)</h6>
                                            <div class="row">
                                                <div class="col-6">
                                                    <label asp-for="Input.Size1" class="form-label">Length</label>
                                                    <div class="input-group">
                                                        <input asp-for="Input.Size1" class="form-control" step="0.1" placeholder="20.0" id="boxLength" />
                                                        <div class="input-group-append">
                                                            <span class="input-group-text">in</span>
                                                        </div>
                                                    </div>
                                                    <span asp-validation-for="Input.Size1" class="text-danger"></span>
                                                </div>
                                                <div class="col-6">
                                                    <label asp-for="Input.Size2" class="form-label">Width</label>
                                                    <div class="input-group">
                                                        <input asp-for="Input.Size2" class="form-control" step="0.1" placeholder="21.0" id="boxWidth" />
                                                        <div class="input-group-append">
                                                            <span class="input-group-text">in</span>
                                                        </div>
                                                    </div>
                                                    <span asp-validation-for="Input.Size2" class="text-danger"></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <h6 class="text-primary"><i class="fas fa-hashtag mr-2"></i>Order Quantities</h6>
                                            <div class="row">
                                                <div class="col-4">
                                                    <label asp-for="Input.Qty1" class="form-label">Small</label>
                                                    <input asp-for="Input.Qty1" class="form-control" placeholder="1000" />
                                                    <small class="text-muted">pieces</small>
                                                    <span asp-validation-for="Input.Qty1" class="text-danger"></span>
                                                </div>
                                                <div class="col-4">
                                                    <label asp-for="Input.Qty2" class="form-label">Medium</label>
                                                    <input asp-for="Input.Qty2" class="form-control" placeholder="2000" />
                                                    <small class="text-muted">pieces</small>
                                                    <span asp-validation-for="Input.Qty2" class="text-danger"></span>
                                                </div>
                                                <div class="col-4">
                                                    <label asp-for="Input.Qty3" class="form-label">Large</label>
                                                    <input asp-for="Input.Qty3" class="form-control" placeholder="3000" />
                                                    <small class="text-muted">pieces</small>
                                                    <span asp-validation-for="Input.Qty3" class="text-danger"></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Paper & Material Costs -->
                            <div class="card mb-3">
                                <div class="card-header">
                                    <h5 class="card-title">
                                        <i class="fas fa-layer-group mr-2"></i>Paper & Material Costs
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <h6 class="text-primary"><i class="fas fa-file-alt mr-2"></i>Top Layer (Duplex)</h6>
                                            <div class="row">
                                                <div class="col-6">
                                                    <label asp-for="Input.DuplexGsm" class="form-label">GSM</label>
                                                    <input asp-for="Input.DuplexGsm" class="form-control" placeholder="230" />
                                                    <span asp-validation-for="Input.DuplexGsm" class="text-danger"></span>
                                                </div>
                                                <div class="col-6">
                                                    <label asp-for="Input.DuplexRate" class="form-label">Rate (Rs./kg)</label>
                                                    <div class="input-group">
                                                        <div class="input-group-prepend">
                                                            <span class="input-group-text">Rs.</span>
                                                        </div>
                                                        <input asp-for="Input.DuplexRate" class="form-control" step="0.01" placeholder="58.00" />
                                                    </div>
                                                    <span asp-validation-for="Input.DuplexRate" class="text-danger"></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <h6 class="text-primary"><i class="fas fa-layer-group mr-2"></i>Inner Liner</h6>
                                            <div class="row">
                                                <div class="col-6">
                                                    <label asp-for="Input.LinerGsm" class="form-label">GSM</label>
                                                    <input asp-for="Input.LinerGsm" class="form-control" placeholder="360" />
                                                    <span asp-validation-for="Input.LinerGsm" class="text-danger"></span>
                                                </div>
                                                <div class="col-6">
                                                    <label asp-for="Input.LinerRate" class="form-label">Rate (Rs./kg)</label>
                                                    <div class="input-group">
                                                        <div class="input-group-prepend">
                                                            <span class="input-group-text">Rs.</span>
                                                        </div>
                                                        <input asp-for="Input.LinerRate" class="form-control" step="0.01" placeholder="43.00" />
                                                    </div>
                                                    <span asp-validation-for="Input.LinerRate" class="text-danger"></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Double Wall Fields -->
                                    <div id="dualLinerFields" class="row mt-3" style="display: none;">
                                        <div class="col-12">
                                            <h6 class="text-warning"><i class="fas fa-plus-circle mr-2"></i>Additional Layer (Double Wall)</h6>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="Input.Liner2Gsm" class="form-label">Second Liner GSM</label>
                                            <input asp-for="Input.Liner2Gsm" class="form-control" placeholder="290" />
                                            <span asp-validation-for="Input.Liner2Gsm" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="Input.Liner2Rate" class="form-label">Second Liner Rate (Rs./kg)</label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text">Rs.</span>
                                                </div>
                                                <input asp-for="Input.Liner2Rate" class="form-control" step="0.01" placeholder="43.00" />
                                            </div>
                                            <span asp-validation-for="Input.Liner2Rate" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="row mt-3">
                                        <div class="col-md-4">
                                            <label asp-for="Input.Divide1" class="form-label">Sheet Length Factor</label>
                                            <input asp-for="Input.Divide1" class="form-control" placeholder="1550" />
                                            <small class="text-muted">Length conversion factor for material calculation</small>
                                            <span asp-validation-for="Input.Divide1" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="Input.Divide2" class="form-label">Sheet Width Factor</label>
                                            <input asp-for="Input.Divide2" class="form-control" placeholder="1000" />
                                            <small class="text-muted">Width conversion factor for material calculation</small>
                                            <span asp-validation-for="Input.Divide2" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="Input.AppsDivisor" class="form-label">Production Efficiency</label>
                                            <input asp-for="Input.AppsDivisor" class="form-control" step="0.1" placeholder="2.0" />
                                            <small class="text-muted">Higher value = more efficient production (lower cost)</small>
                                            <span asp-validation-for="Input.AppsDivisor" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Printing & Production -->
                            <div class="card mb-3">
                                <div class="card-header">
                                    <h5 class="card-title">
                                        <i class="fas fa-print mr-2"></i>Printing & Production
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <label asp-for="Input.PrintingRate1" class="form-label">Small Order Printing (Rs.)</label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text">Rs.</span>
                                                </div>
                                                <input asp-for="Input.PrintingRate1" class="form-control" step="0.01" placeholder="3000.00" />
                                            </div>
                                            <span asp-validation-for="Input.PrintingRate1" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="Input.PrintingRate2" class="form-label">Medium Order Printing (Rs.)</label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text">Rs.</span>
                                                </div>
                                                <input asp-for="Input.PrintingRate2" class="form-control" step="0.01" placeholder="2000.00" />
                                            </div>
                                            <span asp-validation-for="Input.PrintingRate2" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="Input.PrintingRate3" class="form-label">Large Order Printing (Rs.)</label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text">Rs.</span>
                                                </div>
                                                <input asp-for="Input.PrintingRate3" class="form-control" step="0.01" placeholder="2100.00" />
                                            </div>
                                            <span asp-validation-for="Input.PrintingRate3" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="row mt-3">
                                        <div class="col-md-6">
                                            <label asp-for="Input.LaminationRate" class="form-label">Lamination Rate</label>
                                            <input asp-for="Input.LaminationRate" class="form-control" step="0.0001" placeholder="0.0039" />
                                            <span asp-validation-for="Input.LaminationRate" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="Input.PastingRate" class="form-label">Pasting Rate</label>
                                            <input asp-for="Input.PastingRate" class="form-control" step="0.0001" placeholder="0.0013" />
                                            <span asp-validation-for="Input.PastingRate" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="row mt-3">
                                        <div class="col-md-4">
                                            <label asp-for="Input.PunchingRate" class="form-label">Punching Rate (Rs.)</label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text">Rs.</span>
                                                </div>
                                                <input asp-for="Input.PunchingRate" class="form-control" step="0.01" placeholder="0.35" />
                                            </div>
                                            <span asp-validation-for="Input.PunchingRate" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="Input.PunchingQty" class="form-label">Punching Quantity</label>
                                            <input asp-for="Input.PunchingQty" class="form-control" step="0.1" placeholder="1.0" />
                                            <span asp-validation-for="Input.PunchingQty" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="Input.FreightRate" class="form-label">Freight Rate (Rs.)</label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text">Rs.</span>
                                                </div>
                                                <input asp-for="Input.FreightRate" class="form-control" step="0.01" placeholder="300.00" />
                                            </div>
                                            <span asp-validation-for="Input.FreightRate" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Setup & Additional Services -->
                            <div class="card mb-3">
                                <div class="card-header">
                                    <h5 class="card-title">
                                        <i class="fas fa-wrench mr-2"></i>Setup & Additional Services
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <h6 class="text-primary"><i class="fas fa-industry mr-2"></i>Setup Costs</h6>
                                            <div class="row">
                                                <div class="col-6">
                                                    <label asp-for="Input.PlateCharge" class="form-label">Plate Cost (Rs.)</label>
                                                    <div class="input-group">
                                                        <div class="input-group-prepend">
                                                            <span class="input-group-text">Rs.</span>
                                                        </div>
                                                        <input asp-for="Input.PlateCharge" class="form-control" step="0.01" placeholder="1000.00" />
                                                    </div>
                                                    <span asp-validation-for="Input.PlateCharge" class="text-danger"></span>
                                                </div>
                                                <div class="col-6">
                                                    <label asp-for="Input.PlateQty" class="form-label">Plate Qty</label>
                                                    <input asp-for="Input.PlateQty" class="form-control" step="0.1" placeholder="1.0" />
                                                    <span asp-validation-for="Input.PlateQty" class="text-danger"></span>
                                                </div>
                                            </div>
                                            <div class="row mt-2">
                                                <div class="col-6">
                                                    <label asp-for="Input.DieCharge" class="form-label">Die Cost (Rs.)</label>
                                                    <div class="input-group">
                                                        <div class="input-group-prepend">
                                                            <span class="input-group-text">Rs.</span>
                                                        </div>
                                                        <input asp-for="Input.DieCharge" class="form-control" step="0.01" placeholder="0.00" />
                                                    </div>
                                                    <span asp-validation-for="Input.DieCharge" class="text-danger"></span>
                                                </div>
                                                <div class="col-6">
                                                    <label asp-for="Input.DieQty" class="form-label">Die Qty</label>
                                                    <input asp-for="Input.DieQty" class="form-control" step="0.1" placeholder="1.0" />
                                                    <span asp-validation-for="Input.DieQty" class="text-danger"></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <h6 class="text-primary"><i class="fas fa-percentage mr-2"></i>Profit Margin</h6>
                                            <label asp-for="Input.ProfitPercent" class="form-label">Profit Percentage (%)</label>
                                            <div class="input-group">
                                                <input asp-for="Input.ProfitPercent" class="form-control" step="0.1" placeholder="10.0" />
                                                <div class="input-group-append">
                                                    <span class="input-group-text">%</span>
                                                </div>
                                            </div>
                                            <span asp-validation-for="Input.ProfitPercent" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <!-- Assembly Options -->
                                    <div class="row mt-3">
                                        <div class="col-md-6">
                                            <h6 class="text-muted">Basic Assembly</h6>
                                            <div class="row">
                                                <div class="col-6">
                                                    <label asp-for="Input.PinRateNoExtras" class="form-label">Pin Rate (Rs.)</label>
                                                    <div class="input-group">
                                                        <div class="input-group-prepend">
                                                            <span class="input-group-text">Rs.</span>
                                                        </div>
                                                        <input asp-for="Input.PinRateNoExtras" class="form-control" step="0.01" placeholder="0.40" />
                                                    </div>
                                                    <span asp-validation-for="Input.PinRateNoExtras" class="text-danger"></span>
                                                </div>
                                                <div class="col-6">
                                                    <label asp-for="Input.PinQtyNoExtras" class="form-label">Pin Qty</label>
                                                    <input asp-for="Input.PinQtyNoExtras" class="form-control" step="0.1" placeholder="1.0" />
                                                    <span asp-validation-for="Input.PinQtyNoExtras" class="text-danger"></span>
                                                </div>
                                            </div>
                                            <div class="row mt-2">
                                                <div class="col-6">
                                                    <label asp-for="Input.BoxPesRateNoExtras" class="form-label">Box Pes Rate (Rs.)</label>
                                                    <div class="input-group">
                                                        <div class="input-group-prepend">
                                                            <span class="input-group-text">Rs.</span>
                                                        </div>
                                                        <input asp-for="Input.BoxPesRateNoExtras" class="form-control" step="0.01" placeholder="0.00" />
                                                    </div>
                                                    <span asp-validation-for="Input.BoxPesRateNoExtras" class="text-danger"></span>
                                                </div>
                                                <div class="col-6">
                                                    <label asp-for="Input.BoxPesQtyNoExtras" class="form-label">Box Pes Qty</label>
                                                    <input asp-for="Input.BoxPesQtyNoExtras" class="form-control" step="0.1" placeholder="0.0" />
                                                    <span asp-validation-for="Input.BoxPesQtyNoExtras" class="text-danger"></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <h6 class="text-muted">Premium Assembly</h6>
                                            <div class="row">
                                                <div class="col-6">
                                                    <label asp-for="Input.PinRateWithExtras" class="form-label">Pin Rate (Rs.)</label>
                                                    <div class="input-group">
                                                        <div class="input-group-prepend">
                                                            <span class="input-group-text">Rs.</span>
                                                        </div>
                                                        <input asp-for="Input.PinRateWithExtras" class="form-control" step="0.01" placeholder="0.08" />
                                                    </div>
                                                    <span asp-validation-for="Input.PinRateWithExtras" class="text-danger"></span>
                                                </div>
                                                <div class="col-6">
                                                    <label asp-for="Input.PinQtyWithExtras" class="form-label">Pin Qty</label>
                                                    <input asp-for="Input.PinQtyWithExtras" class="form-control" step="0.1" placeholder="3.0" />
                                                    <span asp-validation-for="Input.PinQtyWithExtras" class="text-danger"></span>
                                                </div>
                                            </div>
                                            <div class="row mt-2">
                                                <div class="col-6">
                                                    <label asp-for="Input.BoxPesRateWithExtras" class="form-label">Box Pes Rate (Rs.)</label>
                                                    <div class="input-group">
                                                        <div class="input-group-prepend">
                                                            <span class="input-group-text">Rs.</span>
                                                        </div>
                                                        <input asp-for="Input.BoxPesRateWithExtras" class="form-control" step="0.01" placeholder="0.07" />
                                                    </div>
                                                    <span asp-validation-for="Input.BoxPesRateWithExtras" class="text-danger"></span>
                                                </div>
                                                <div class="col-6">
                                                    <label asp-for="Input.BoxPesQtyWithExtras" class="form-label">Box Pes Qty</label>
                                                    <input asp-for="Input.BoxPesQtyWithExtras" class="form-control" step="0.1" placeholder="1.0" />
                                                    <span asp-validation-for="Input.BoxPesQtyWithExtras" class="text-danger"></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="row mt-4">
                                <div class="col-12 text-center">
                                    <button type="submit" formaction="@Url.Action("Calculate")" class="btn btn-success btn-lg mr-2">
                                        <i class="fas fa-calculator mr-1"></i>Calculate Prices
                                    </button>
                                    <button type="submit" formaction="@Url.Action("LoadDefaults")" class="btn btn-outline-secondary mr-2">
                                        <i class="fas fa-refresh mr-1"></i>Reset to Defaults
                                    </button>
                                    @if (Model.ShowResults && Model.Result != null && !Model.Result.Errors.Any())
                                    {
                                        <button type="submit" formaction="@Url.Action("Export")" class="btn btn-primary">
                                            <i class="fas fa-download mr-1"></i>Export Results
                                        </button>
                                    }
                                </div>
                            </div>
                        </form>
