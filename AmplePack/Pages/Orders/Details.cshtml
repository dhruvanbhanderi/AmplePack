@page
@model AmplePack.Pages_Orders.DetailsModel
@{
    ViewData["Title"] = "Order Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="row">
  <div class="col-md-8">
    <!-- Order Information -->
    <div class="card card-primary">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fas fa-shopping-cart"></i> Order #@Model.Order?.Id
        </h3>
        <div class="card-tools">
          <span class="badge @(Model.Order?.Status == "Completed" ? "badge-success" : Model.Order?.Status == "Pending" ? "badge-warning" : Model.Order?.Status == "Processing" ? "badge-info" : "badge-danger")">
            @Model.Order?.Status
          </span>
        </div>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-sm-6">
            <strong>Order Date:</strong>
            <p class="text-muted">@Model.Order?.Date.ToString("MMMM dd, yyyy")</p>
          </div>
          <div class="col-sm-6">
            <strong>Total Amount:</strong>
            <p class="text-muted">$@Model.Order?.TotalAmount</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Customer Information -->
    <div class="card card-info">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fas fa-user"></i> Customer Information
        </h3>
      </div>
      <div class="card-body">
        @if (Model.Order?.Customer != null)
        {
          <div class="row">
            <div class="col-sm-6">
              <strong>Name:</strong>
              <p class="text-muted">@Model.Order.Customer.Name</p>
            </div>
            <div class="col-sm-6">
              <strong>Email:</strong>
              <p class="text-muted">
                <a href="mailto:@Model.Order.Customer.Email">@Model.Order.Customer.Email</a>
              </p>
            </div>
          </div>
          <div class="row">
            <div class="col-sm-6">
              <strong>Contact:</strong>
              <p class="text-muted">
                <a href="tel:@Model.Order.Customer.Contact">@Model.Order.Customer.Contact</a>
              </p>
            </div>
            <div class="col-sm-6">
              <strong>Address:</strong>
              <p class="text-muted">@Model.Order.Customer.Address</p>
            </div>
          </div>
        }
      </div>
    </div>

    <!-- Order Details -->
    @if (Model.Order?.OrderDetails?.Any() == true)
    {
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">
            <i class="fas fa-list"></i> Order Items
          </h3>
        </div>
        <div class="card-body p-0">
          <table class="table table-striped">
            <thead>
              <tr>
                <th>Box Type</th>
                <th>Size</th>
                <th>Quantity</th>
                <th>Price per Box</th>
                <th>Total</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var detail in Model.Order.OrderDetails)
              {
                <tr>
                  <td>@detail.BoxType</td>
                  <td>@detail.Size</td>
                  <td>@detail.Quantity</td>
                  <td>$@detail.PricePerBox</td>
                  <td>$@((detail.Quantity * detail.PricePerBox).ToString("F2"))</td>
                </tr>
              }
            </tbody>
            <tfoot>
              <tr>
                <th colspan="4" class="text-right">Grand Total:</th>
                <th>$@Model.Order.TotalAmount</th>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    }
  </div>
  
  <div class="col-md-4">
    <!-- Order Timeline -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Order Timeline</h3>
      </div>
      <div class="card-body">
        <div class="timeline">
          <div class="time-label">
            <span class="bg-green">@Model.Order?.Date.ToString("MMM dd")</span>
          </div>
          <div>
            <i class="fas fa-plus bg-blue"></i>
            <div class="timeline-item">
              <span class="time"><i class="fas fa-clock"></i> @Model.Order?.Date.ToString("h:mm tt")</span>
              <h3 class="timeline-header">Order Created</h3>
              <div class="timeline-body">
                Order #@Model.Order?.Id was created for @Model.Order?.Customer?.Name
              </div>
            </div>
          </div>
          
          @if (Model.Order?.Status == "Processing" || Model.Order?.Status == "Completed")
          {
            <div>
              <i class="fas fa-cog bg-yellow"></i>
              <div class="timeline-item">
                <h3 class="timeline-header">Order Processing</h3>
                <div class="timeline-body">
                  Order is being processed
                </div>
              </div>
            </div>
          }
          
          @if (Model.Order?.Status == "Completed")
          {
            <div>
              <i class="fas fa-check bg-green"></i>
              <div class="timeline-item">
                <h3 class="timeline-header">Order Completed</h3>
                <div class="timeline-body">
                  Order has been completed successfully
                </div>
              </div>
            </div>
          }
          
          @if (Model.Order?.Status == "Cancelled")
          {
            <div>
              <i class="fas fa-times bg-red"></i>
              <div class="timeline-item">
                <h3 class="timeline-header">Order Cancelled</h3>
                <div class="timeline-body">
                  Order has been cancelled
                </div>
              </div>
            </div>
          }
        </div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Quick Actions</h3>
      </div>
      <div class="card-body">
        <a asp-page="./Edit" asp-route-id="@Model.Order?.Id" class="btn btn-warning btn-block">
          <i class="fas fa-edit"></i> Edit Order
        </a>
        @if (Model.Order?.Status != "Completed")
        {
          <button class="btn btn-success btn-block" onclick="updateStatus('Completed')">
            <i class="fas fa-check"></i> Mark as Completed
          </button>
        }
        @if (Model.Order?.Status == "Pending")
        {
          <button class="btn btn-info btn-block" onclick="updateStatus('Processing')">
            <i class="fas fa-cog"></i> Start Processing
          </button>
        }
        <a href="mailto:@Model.Order?.Customer?.Email" class="btn btn-primary btn-block">
          <i class="fas fa-envelope"></i> Email Customer
        </a>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-12">
    <div class="card-footer">
      <a asp-page="./Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back to List
      </a>
      <a asp-page="./Edit" asp-route-id="@Model.Order?.Id" class="btn btn-warning">
        <i class="fas fa-edit"></i> Edit Order
      </a>
      <a asp-page="./Delete" asp-route-id="@Model.Order?.Id" class="btn btn-danger">
        <i class="fas fa-trash"></i> Delete Order
      </a>
    </div>
  </div>
</div>

@section Scripts {
  <script>
    function updateStatus(newStatus) {
      if (confirm('Are you sure you want to update the order status to ' + newStatus + '?')) {
        // This would typically make an AJAX call to update the status
        alert('Status update functionality would be implemented here');
      }
    }
  </script>
}
