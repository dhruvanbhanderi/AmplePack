@model List<AmplePack.Models.Order>
@{
    ViewData["Title"] = "Orders Management";
}

<!-- Statistics Cards -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Orders Management</h1>
            </div>
            <div class="col-sm-6">
                <div class="float-sm-right">
                    <a asp-action="CreateWorkflow" class="btn btn-primary">
                        <i class="fas fa-plus"></i> New Order
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <!-- Statistics Cards -->
        <div class="row mb-3">
          <div class="col-lg-3 col-6">
            <div class="small-box bg-info">
              <div class="inner">
                <h3>@ViewBag.TotalOrders</h3>
                <p>Total Orders</p>
              </div>
              <div class="icon">
                <i class="fas fa-shopping-cart"></i>
              </div>
            </div>
          </div>
          <div class="col-lg-3 col-6">
            <div class="small-box bg-warning">
              <div class="inner">
                <h3>@ViewBag.PendingOrders</h3>
                <p>Pending Orders</p>
              </div>
              <div class="icon">
                <i class="fas fa-clock"></i>
              </div>
            </div>
          </div>
          <div class="col-lg-3 col-6">
            <div class="small-box bg-success">
              <div class="inner">
                <h3>@ViewBag.CompletedOrders</h3>
                <p>Completed Orders</p>
              </div>
              <div class="icon">
                <i class="fas fa-check-circle"></i>
              </div>
            </div>
          </div>
          <div class="col-lg-3 col-6">
            <div class="small-box bg-danger">
              <div class="inner">
                <h3>$@ViewBag.MonthlyRevenue.ToString("N2")</h3>
                <p>Monthly Revenue</p>
              </div>
              <div class="icon">
                <i class="fas fa-dollar-sign"></i>
              </div>
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-12">
            <div class="card">
              <div class="card-header">
                <h3 class="card-title">
                  <i class="fas fa-shopping-cart mr-2"></i>
                  Orders Management
                </h3>
                <div class="card-tools">
                  <a asp-action="CreateWorkflow" class="btn btn-primary">
                    <i class="fas fa-plus"></i> New Order
                  </a>
                </div>
              </div>
              <!-- /.card-header -->
              <div class="card-body">
                @if (Model.Any())
                {
                  <table id="ordersTable" class="table table-bordered table-hover table-striped">
                    <thead class="thead-dark">
                    <tr>
                      <th>Order #</th>
                      <th>Customer</th>
                      <th>Date</th>
                      <th>Items</th>
                      <th>Total Amount</th>
                      <th>Status</th>
                      <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var order in Model) 
                    {
                        <tr>
                            <td>
                              <strong>#@order.Id</strong>
                            </td>
                            <td>
                              <div>
                                <strong>@order.Customer?.Name</strong><br>
                                <small class="text-muted">@order.Customer?.Email</small>
                              </div>
                            </td>
                            <td>
                              <div>
                                @order.Date.ToString("MMM dd, yyyy")<br>
                                <small class="text-muted">@order.Date.ToString("dddd")</small>
                              </div>
                            </td>
                            <td>
                              @if (order.OrderDetails?.Any() == true)
                              {
                                <div class="order-items-summary">
                                  @foreach (var detail in order.OrderDetails.Take(2))
                                  {
                                    <div class="item-line">
                                      @if (detail.CustomerProduct != null)
                                      {
                                        <span class="badge badge-success">@detail.CustomerProduct.ProductName</span>
                                        <small class="text-muted">@detail.Size (×@detail.Quantity)</small>
                                      }
                                      else
                                      {
                                        <span class="badge badge-light">@detail.BoxType</span>
                                        <small class="text-muted">@detail.Size (×@detail.Quantity)</small>
                                      }
                                    </div>
                                  }
                                  @if (order.OrderDetails.Count() > 2)
                                  {
                                    <div class="item-line">
                                      <small class="text-muted">... and @(order.OrderDetails.Count() - 2) more</small>
                                    </div>
                                  }
                                </div>
                              }
                              else
                              {
                                <span class="badge badge-secondary">
                                  0 items
                                </span>
                              }
                            </td>
                            <td>
                              <strong class="text-success">$@order.TotalAmount.ToString("N2")</strong>
                            </td>
                            <td>
                              @if (order.Status == "Pending")
                              {
                                <span class="badge badge-warning">
                                  <i class="fas fa-clock mr-1"></i>@order.Status
                                </span>
                              }
                              else if (order.Status == "Processing")
                              {
                                <span class="badge badge-info">
                                  <i class="fas fa-cog mr-1"></i>@order.Status
                                </span>
                              }
                              else if (order.Status == "Completed")
                              {
                                <span class="badge badge-success">
                                  <i class="fas fa-check mr-1"></i>@order.Status
                                </span>
                              }
                              else if (order.Status == "Cancelled")
                              {
                                <span class="badge badge-danger">
                                  <i class="fas fa-times mr-1"></i>@order.Status
                                </span>
                              }
                              else
                              {
                                <span class="badge badge-secondary">@order.Status</span>
                              }
                            </td>
                            <td>
                              <div class="btn-group">
                                <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-toggle="dropdown">
                                  Actions
                                </button>
                                <div class="dropdown-menu">
                                  <a class="dropdown-item" asp-action="Details" asp-route-id="@order.Id">
                                    <i class="fas fa-eye mr-2"></i>View Details
                                  </a>
                                  <a class="dropdown-item" asp-action="Edit" asp-route-id="@order.Id">
                                    <i class="fas fa-edit mr-2"></i>Edit Order
                                  </a>
                                  <div class="dropdown-divider"></div>
                                  @if (order.Status == "Pending")
                                  {
                                    <a class="dropdown-item text-info" href="#" onclick="updateStatus(@order.Id, 'Processing')">
                                      <i class="fas fa-play mr-2"></i>Start Processing
                                    </a>
                                  }
                                  @if (order.Status == "Processing")
                                  {
                                    <a class="dropdown-item text-success" href="#" onclick="updateStatus(@order.Id, 'Completed')">
                                      <i class="fas fa-check mr-2"></i>Mark Completed
                                    </a>
                                  }
                                  @if (order.Status != "Cancelled" && order.Status != "Completed")
                                  {
                                    <a class="dropdown-item text-warning" href="#" onclick="updateStatus(@order.Id, 'Cancelled')">
                                      <i class="fas fa-ban mr-2"></i>Cancel Order
                                    </a>
                                  }
                                  <div class="dropdown-divider"></div>
                                  <a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@order.Id">
                                    <i class="fas fa-trash mr-2"></i>Delete Order
                                  </a>
                                </div>
                              </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                  </table>
                }
                else
                {
                  <div class="text-center py-5">
                    <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
                    <h4>No Orders Found</h4>
                    <p class="text-muted">Get started by creating your first order.</p>
                    <a asp-action="CreateWorkflow" class="btn btn-primary">
                      <i class="fas fa-plus"></i> Create First Order
                    </a>
                  </div>
                }
              </div>
              <!-- /.card-body -->
            </div>
            <!-- /.card -->
          </div>
          <!-- /.col -->
        </div>
        <!-- /.row -->
    </div>
</section>

@section Scripts {
  <!-- DataTables CSS -->
  <link rel="stylesheet" href="https://cdn.datatables.net/1.11.4/css/dataTables.bootstrap4.min.css">
  <!-- DataTables JS -->
  <script src="https://cdn.datatables.net/1.11.4/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.11.4/js/dataTables.bootstrap4.min.js"></script>
  
  <script>
    $(function () {
      $("#ordersTable").DataTable({
        "responsive": true, 
        "lengthChange": true, 
        "autoWidth": false,
        "pageLength": 25,
        "order": [[ 0, "desc" ]], // Sort by Order # descending
        "columnDefs": [
          { "orderable": false, "targets": 6 } // Disable sorting on Actions column
        ],
        "language": {
          "search": "Search orders:",
          "lengthMenu": "Show _MENU_ orders per page",
          "info": "Showing _START_ to _END_ of _TOTAL_ orders",
          "paginate": {
            "previous": "Previous",
            "next": "Next"
          }
        }
      });
    });

    function updateStatus(orderId, newStatus) {
      if (confirm(`Are you sure you want to change the order status to ${newStatus}?`)) {
        // AJAX call to update status
        $.post('/Orders/UpdateStatus', {
          id: orderId,
          status: newStatus,
          __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        })
        .done(function() {
          location.reload();
        })
        .fail(function() {
          alert('Failed to update order status. Please try again.');
        });
      }
    }
  </script>
}

<style>
  .order-items-summary {
    max-width: 200px;
  }
  
  .item-line {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-bottom: 2px;
  }
  
  .item-line:last-child {
    margin-bottom: 0;
  }
  
  .badge-light {
    color: #495057;
    background-color: #f8f9fa;
    border: 1px solid #dee2e6;
  }
  
  .order-items-summary small {
    font-size: 0.75rem;
  }
}