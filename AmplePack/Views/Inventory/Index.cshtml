@model IEnumerable<AmplePack.Models.Inventory>
@{
    ViewData["Title"] = "Inventory Management";
}

<!-- Content Header -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">
                    <i class="fas fa-warehouse mr-2"></i>
                    Inventory Management
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Dashboard</a></li>
                    <li class="breadcrumb-item active">Inventory</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        
        <!-- Real-Time Stats Row -->
        <div class="row">
            <div class="col-lg-3 col-6">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3 id="totalItemsCount">@ViewBag.TotalItems</h3>
                        <p>Total Items</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-boxes"></i>
                    </div>
                    <a asp-action="Create" class="small-box-footer">
                        Add New Item <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3 id="inStockCount">@ViewBag.InStockItems</h3>
                        <p>In Stock</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <a href="?stockStatus=instock" class="small-box-footer">
                        View Items <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3 id="lowStockCount">@ViewBag.LowStockItems</h3>
                        <p>Low Stock</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <a href="?stockStatus=lowstock" class="small-box-footer">
                        View Alerts <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-danger">
                    <div class="inner">
                        <h3 id="outOfStockCount">@ViewBag.OutOfStockItems</h3>
                        <p>Out of Stock</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-times-circle"></i>
                    </div>
                    <a href="?stockStatus=outofstock" class="small-box-footer">
                        Urgent Action <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Additional Stats Row -->
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="info-box">
                    <span class="info-box-icon bg-gradient-success">
                        <i class="fas fa-rupee-sign"></i>
                    </span>
                    <div class="info-box-content">
                        <span class="info-box-text">Total Inventory Value</span>
                        <span class="info-box-number">@AmplePack.Helpers.CurrencyHelper.FormatCurrency(ViewBag.TotalInventoryValue)</span>
                        <div class="progress">
                            <div class="progress-bar bg-success" style="width: 100%"></div>
                        </div>
                        <span class="progress-description">Current market value</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="info-box">
                    <span class="info-box-icon bg-gradient-info">
                        <i class="fas fa-percentage"></i>
                    </span>
                    <div class="info-box-content">
                        <span class="info-box-text">Stock Health</span>
                        <span class="info-box-number">
                            @{
                                var healthPercentage = ViewBag.TotalItems > 0 ? 
                                    Math.Round((double)ViewBag.InStockItems / (int)ViewBag.TotalItems * 100, 1) : 0;
                            }
                            @healthPercentage%
                        </span>
                        <div class="progress">
                            <div class="progress-bar bg-@(healthPercentage >= 80 ? "success" : healthPercentage >= 60 ? "warning" : "danger")" 
                                 style="width: @healthPercentage%"></div>
                        </div>
                        <span class="progress-description">Items in good stock</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter Row -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-filter mr-2"></i>
                            Filters & Search
                        </h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <form method="get" class="row">
                            <div class="col-md-3 mb-3">
                                <label for="category" class="form-label">Category</label>
                                <select name="category" id="category" class="form-control">
                                    <option value="">All Categories</option>
                                    @if (ViewBag.Categories != null)
                                    {
                                        @foreach (var cat in ViewBag.Categories as List<string>)
                                        {
                                            var isSelected = ViewBag.CategoryFilter as string == cat;
                                            <option value="@cat" selected="@isSelected">@cat</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="stockStatus" class="form-label">Stock Status</label>
                                <select name="stockStatus" id="stockStatus" class="form-control">
                                    <option value="">All Items</option>
                                    @{
                                        var statusFilter = ViewBag.StockStatusFilter as string;
                                    }
                                    <option value="instock" selected="@(statusFilter == "instock")">In Stock (@ViewBag.InStockItems)</option>
                                    <option value="lowstock" selected="@(statusFilter == "lowstock")">Low Stock (@ViewBag.LowStockItems)</option>
                                    <option value="outofstock" selected="@(statusFilter == "outofstock")">Out of Stock (@ViewBag.OutOfStockItems)</option>
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="searchTerm" class="form-label">Search</label>
                                <input type="text" name="searchTerm" id="searchTerm" class="form-control" 
                                       placeholder="Search by item name, product, or category..."
                                       value="@ViewBag.SearchTerm">
                            </div>
                            <div class="col-md-2 mb-3">
                                <label class="form-label">&nbsp;</label>
                                <div class="d-flex flex-column gap-2">
                                    <button type="submit" class="btn btn-primary btn-block">
                                        <i class="fas fa-search mr-1"></i>
                                        Filter
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary btn-block">
                                        <i class="fas fa-times mr-1"></i>
                                        Clear
                                    </a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Inventory Table -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-list mr-2"></i>
                            Inventory Items (@Model.Count() items)
                        </h3>
                        <div class="card-tools">
                            <a asp-action="Create" class="btn btn-primary btn-sm">
                                <i class="fas fa-plus mr-1"></i>
                                Add Item
                            </a>
                            <button type="button" class="btn btn-info btn-sm ml-1" onclick="refreshInventoryData()">
                                <i class="fas fa-sync-alt mr-1"></i>
                                Refresh
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (Model.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-bordered table-striped table-hover data-table inventory-table">
                                    <thead class="thead-dark">
                                        <tr>
                                            <th>Item Name</th>
                                            <th>Category</th>
                                            <th>Available Quantity</th>
                                            <th>Unit Price</th>
                                            <th>Total Value</th>
                                            <th>Reorder Level</th>
                                            <th>Status</th>
                                            <th class="no-sort">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr data-item-id="@item.Id" class="inventory-row">
                                                <td>
                                                    <strong>@item.ItemName</strong>
                                                    @if (!string.IsNullOrEmpty(item.Category))
                                                    {
                                                        <br><small class="text-muted">@item.Category</small>
                                                    }
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(item.Category))
                                                    {
                                                        <span class="badge badge-secondary">@item.Category</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted"><em>Uncategorized</em></span>
                                                    }
                                                </td>
                                                <td class="available-quantity">
                                                    <span class="badge @(item.AvailableQuantity <= 0 ? "badge-danger" : item.AvailableQuantity <= item.ReorderLevel ? "badge-warning" : "badge-success")">
                                                        @item.AvailableQuantity.ToString("F2") @item.Unit
                                                    </span>
                                                </td>
                                                <td>@AmplePack.Helpers.CurrencyHelper.FormatCurrency(item.UnitPrice)</td>
                                                <td class="text-success font-weight-bold">@AmplePack.Helpers.CurrencyHelper.FormatCurrency(item.AvailableQuantity * item.UnitPrice)</td>
                                                <td>@item.ReorderLevel.ToString("F2") @item.Unit</td>
                                                <td>
                                                    <span class="badge stock-status @(item.AvailableQuantity <= 0 ? "badge-danger" : item.AvailableQuantity <= item.ReorderLevel ? "badge-warning" : "badge-success")">
                                                        @(item.AvailableQuantity <= 0 ? "Out of Stock" : item.AvailableQuantity <= item.ReorderLevel ? "Low Stock" : "In Stock")
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="btn-group" role="group">
                                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm" title="View Details">
                                                            <i class="fas fa-eye"></i>
                                                        </a>
                                                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                                        {
                                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm" title="Edit">
                                                                <i class="fas fa-edit"></i>
                                                            </a>
                                                            <button type="button" class="btn btn-success btn-sm quick-add" 
                                                                    data-item-id="@item.Id" 
                                                                    data-item-name="@item.ItemName" 
                                                                    title="Quick Add Stock">
                                                                <i class="fas fa-plus"></i>
                                                            </button>
                                                            <button type="button" class="btn btn-outline-danger btn-sm quick-remove" 
                                                                    data-item-id="@item.Id" 
                                                                    data-item-name="@item.ItemName" 
                                                                    title="Quick Remove Stock"
                                                                    @(item.AvailableQuantity <= 0 ? "disabled" : "")>
                                                                <i class="fas fa-minus"></i>
                                                            </button>
                                                        }
                                                        @if (User.IsInRole("Admin"))
                                                        {
                                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" title="Delete" 
                                                               onclick="return confirmDelete(@item.Id, '@item.ItemName');">
                                                                <i class="fas fa-trash"></i>
                                                            </a>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-boxes fa-4x text-muted mb-3"></i>
                                <h4 class="text-muted">No Inventory Items Found</h4>
                                @if (!string.IsNullOrEmpty(ViewBag.CategoryFilter) || !string.IsNullOrEmpty(ViewBag.StockStatusFilter) || !string.IsNullOrEmpty(ViewBag.SearchTerm))
                                {
                                    <p class="text-muted">Try adjusting your filters or search terms.</p>
                                    <a href="@Url.Action("Index")" class="btn btn-primary">Clear Filters</a>
                                }
                                else
                                {
                                    <p class="text-muted">Get started by adding your first inventory item.</p>
                                    <a asp-action="Create" class="btn btn-primary">Add First Item</a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        $(document).ready(function() {
            // Auto-refresh stats every 30 seconds
            setInterval(refreshInventoryStats, 30000);
        });

        function refreshInventoryStats() {
            fetch('/api/inventory/current-stock')
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        updateInventoryStats(data.data);
                    }
                })
                .catch(error => console.error('Error refreshing stats:', error));
        }

        function updateInventoryStats(inventoryData) {
            let totalItems = inventoryData.length;
            let inStock = inventoryData.filter(i => i.stockStatus === 'In Stock').length;
            let lowStock = inventoryData.filter(i => i.stockStatus === 'Low Stock').length;
            let outOfStock = inventoryData.filter(i => i.stockStatus === 'Out of Stock').length;

            document.getElementById('totalItemsCount').textContent = totalItems;
            document.getElementById('inStockCount').textContent = inStock;
            document.getElementById('lowStockCount').textContent = lowStock;
            document.getElementById('outOfStockCount').textContent = outOfStock;
        }

        function refreshInventoryData() {
            const refreshBtn = event.target.closest('button');
            const originalContent = refreshBtn.innerHTML;
            
            refreshBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i>Refreshing...';
            refreshBtn.disabled = true;
            
            setTimeout(() => {
                location.reload();
            }, 1000);
        }

        function confirmDelete(itemId, itemName) {
            event.preventDefault();
            
            Swal.fire({
                title: 'Delete Inventory Item?',
                html: `Are you sure you want to delete "<strong>${itemName}</strong>"?<br><br>
                       <div class="alert alert-warning">
                           <i class="fas fa-exclamation-triangle mr-2"></i>
                           This action cannot be undone and will remove all associated data.
                       </div>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = `/Inventory/Delete/${itemId}`;
                }
            });
            
            return false;
        }
    </script>
}

@section Styles {
    <style>
        .inventory-update-success {
            animation: pulse 2s ease-in-out;
        }
        
        .gap-2 {
            gap: 0.5rem;
        }
        
        .btn-group .btn {
            margin-right: 2px;
        }
        
        .btn-group .btn:last-child {
            margin-right: 0;
        }
        
        .table th {
            border-top: none;
            font-weight: 600;
        }
        
        .badge {
            font-size: 0.75em;
        }
        
        .info-box {
            box-shadow: 0 0 1px rgba(0,0,0,.125), 0 1px 3px rgba(0,0,0,.2);
            border-radius: 0.25rem;
            background: #fff;
            display: flex;
            margin-bottom: 1rem;
            min-height: 80px;
            padding: 10px;
            position: relative;
            width: 100%;
        }
        
        .info-box .info-box-icon {
            border-radius: 0.25rem;
            align-items: center;
            display: flex;
            font-size: 1.875rem;
            justify-content: center;
            text-align: center;
            width: 70px;
            color: rgba(255,255,255,.8);
            margin-right: 15px;
        }
        
        .info-box .info-box-content {
            display: flex;
            flex-direction: column;
            justify-content: center;
            line-height: 1.8;
            flex: 1;
        }
        
        .info-box .info-box-number {
            display: block;
            font-weight: 700;
            font-size: 18px;
        }
        
        .info-box .progress {
            background: rgba(0,0,0,.125);
            height: 2px;
            margin: 5px 0;
        }
        
        .info-box .progress .progress-bar {
            background: #007bff;
        }
        
        .info-box .progress-description {
            color: #6c757d;
            font-size: 12px;
        }
        
        .bg-gradient-success {
            background: linear-gradient(87deg, #2dce89 0, #2dcecc 100%);
        }
        
        .bg-gradient-info {
            background: linear-gradient(87deg, #11cdef 0, #1171ef 100%);
        }
    </style>
}

@Html.AntiForgeryToken()