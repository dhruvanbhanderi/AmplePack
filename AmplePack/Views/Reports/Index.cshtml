@model AmplePack.Models.ReportsViewModel
@{
    ViewData["Title"] = "Reports Dashboard";
}

<!-- Content Header -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Reports Dashboard</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                    <li class="breadcrumb-item active">Reports</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        
        <!-- Advanced Reports Link -->
        <div class="row">
            <div class="col-12">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-file-export mr-2"></i>
                            Advanced Reports & Data Export
                        </h3>
                    </div>
                    <div class="card-body text-center">
                        <p class="lead">Generate comprehensive reports with custom filters and export options</p>
                        <a asp-action="Export" class="btn btn-primary btn-lg">
                            <i class="fas fa-cogs mr-2"></i>
                            Go to Advanced Reports
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats Row -->
        <div class="row">
            <div class="col-lg-3 col-6">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3>@AmplePack.Helpers.CurrencyHelper.FormatCurrency(Model.TotalRevenue)</h3>
                        <p>Total Revenue</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-rupee-sign"></i>
                    </div>
                    <a href="#" class="small-box-footer">
                        More info <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
            
            <div class="col-lg-3 col-6">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3>@AmplePack.Helpers.CurrencyHelper.FormatCurrency(Model.MonthlyRevenue)</h3>
                        <p>This Month</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <a href="#" class="small-box-footer">
                        More info <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
            
            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3>@Model.TotalOrdersThisMonth</h3>
                        <p>Orders This Month</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <a href="#" class="small-box-footer">
                        More info <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
            
            <div class="col-lg-3 col-6">
                <div class="small-box bg-danger">
                    <div class="inner">
                        <h3>@Model.TotalCustomers</h3>
                        <p>Total Customers</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <a href="#" class="small-box-footer">
                        More info <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Advanced Charts Row -->
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-chart-line mr-2"></i>
                            Monthly Revenue & Orders Trend
                        </h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" onclick="refreshChart('monthlyrevenue')">
                                <i class="fas fa-sync"></i>
                            </button>
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                            <button type="button" class="btn btn-tool" data-card-widget="maximize">
                                <i class="fas fa-expand"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="chart">
                            <canvas id="monthlyRevenueChart" style="min-height: 300px; height: 300px; max-height: 300px;"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-chart-pie mr-2"></i>
                            Order Status Distribution
                        </h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" onclick="refreshChart('orderstatus')">
                                <i class="fas fa-sync"></i>
                            </button>
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <canvas id="orderStatusChart" style="min-height: 300px; height: 300px; max-height: 300px;"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Additional Charts Row -->
        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-chart-bar mr-2"></i>
                            Top Customers by Revenue
                        </h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" onclick="refreshChart('topcustomers')">
                                <i class="fas fa-sync"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <canvas id="topCustomersChart" style="min-height: 300px; height: 300px; max-height: 300px;"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-chart-area mr-2"></i>
                            Inventory Value by Category
                        </h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" onclick="refreshChart('inventoryvalue')">
                                <i class="fas fa-sync"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <canvas id="inventoryValueChart" style="min-height: 300px; height: 300px; max-height: 300px;"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Data Tables Row -->
        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-star mr-2"></i>
                            Top Customers
                        </h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Customer</th>
                                        <th>Orders</th>
                                        <th>Total Spent</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.TopCustomers != null && Model.TopCustomers.Any())
                                    {
                                        @foreach (var customer in Model.TopCustomers)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@customer.Name</strong>
                                                    <br><small class="text-muted">@customer.Contact</small>
                                                </td>
                                                <td>
                                                    <span class="badge badge-info">@customer.Orders.Count</span>
                                                </td>
                                                <td class="currency">@AmplePack.Helpers.CurrencyHelper.FormatCurrency(customer.Orders.Where(o => o.Status == "Completed").Sum(o => o.TotalAmount))</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="3" class="text-center text-muted py-3">
                                                No customer data available
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-exclamation-triangle mr-2 text-warning"></i>
                            Critical Stock Items
                        </h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Item</th>
                                        <th>Current Stock</th>
                                        <th>Reorder Level</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.CriticalStockItems != null && Model.CriticalStockItems.Any())
                                    {
                                        @foreach (var item in Model.CriticalStockItems)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@item.ItemName</strong>
                                                    <br><small class="text-muted">@(item.Category ?? "Uncategorized")</small>
                                                </td>
                                                <td>
                                                    <span class="badge @(item.AvailableQuantity <= item.ReorderLevel / 2 ? "badge-danger" : "badge-warning")">
                                                        @item.AvailableQuantity.ToString("F2") @item.Unit
                                                    </span>
                                                </td>
                                                <td>@item.ReorderLevel.ToString("F2") @item.Unit</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="3" class="text-center text-muted py-3">
                                                All items are well stocked
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        let chartInstances = {};

        $(document).ready(function() {
            initializeAllCharts();
        });

        async function initializeAllCharts() {
            try {
                // Load all chart data and initialize charts
                await Promise.all([
                    loadAndInitChart('monthlyrevenue', initMonthlyRevenueChart),
                    loadAndInitChart('orderstatus', initOrderStatusChart),
                    loadAndInitChart('topcustomers', initTopCustomersChart),
                    loadAndInitChart('inventoryvalue', initInventoryValueChart)
                ]);
            } catch (error) {
                console.error('Failed to initialize charts:', error);
                showToast('Failed to load chart data', 'error');
            }
        }

        async function loadAndInitChart(chartType, initFunction) {
            try {
                const response = await fetch(`/Reports/GetChartData?chartType=${chartType}`);
                if (!response.ok) throw new Error('Failed to fetch chart data');
                
                const data = await response.json();
                initFunction(data);
            } catch (error) {
                console.error(`Failed to load ${chartType} chart:`, error);
                // Initialize with empty data on error
                initFunction(null);
            }
        }

        function initMonthlyRevenueChart(data) {
            const ctx = document.getElementById('monthlyRevenueChart');
            if (!ctx) return;

            // Destroy existing chart if it exists
            if (chartInstances.monthlyRevenue) {
                chartInstances.monthlyRevenue.destroy();
            }

            const chartData = data?.data || [];
            
            chartInstances.monthlyRevenue = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: chartData.map(d => d.month),
                    datasets: [
                        {
                            label: 'Revenue (Rs.)',
                            data: chartData.map(d => d.revenue),
                            borderColor: 'rgb(54, 162, 235)',
                            backgroundColor: 'rgba(54, 162, 235, 0.1)',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4,
                            yAxisID: 'y'
                        },
                        {
                            label: 'Orders Count',
                            data: chartData.map(d => d.orderCount),
                            borderColor: 'rgb(255, 99, 132)',
                            backgroundColor: 'rgba(255, 99, 132, 0.1)',
                            borderWidth: 2,
                            fill: false,
                            tension: 0.4,
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: {
                                usePointStyle: true
                            }
                        },
                        tooltip: {
                            mode: 'index',
                            intersect: false,
                            callbacks: {
                                label: function(context) {
                                    if (context.datasetIndex === 0) {
                                        return `Revenue: Rs.${context.parsed.y.toLocaleString()}`;
                                    } else {
                                        return `Orders: ${context.parsed.y}`;
                                    }
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            display: true,
                            title: {
                                display: true,
                                text: 'Month'
                            }
                        },
                        y: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            title: {
                                display: true,
                                text: 'Revenue (Rs.)'
                            },
                            ticks: {
                                callback: function(value) {
                                    return 'Rs.' + value.toLocaleString();
                                }
                            }
                        },
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            title: {
                                display: true,
                                text: 'Orders Count'
                            },
                            grid: {
                                drawOnChartArea: false,
                            },
                        }
                    },
                    interaction: {
                        intersect: false,
                        mode: 'index'
                    }
                }
            });
        }

        function initOrderStatusChart(data) {
            const ctx = document.getElementById('orderStatusChart');
            if (!ctx) return;

            if (chartInstances.orderStatus) {
                chartInstances.orderStatus.destroy();
            }

            const labels = data?.labels || ['Pending', 'Processing', 'Completed', 'Cancelled'];
            const chartData = data?.data || [0, 0, 0, 0];

            chartInstances.orderStatus = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: chartData,
                        backgroundColor: [
                            '#ffc107',
                            '#17a2b8',
                            '#28a745',
                            '#dc3545'
                        ],
                        borderWidth: 2,
                        borderColor: '#fff',
                        hoverBorderWidth: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                padding: 20,
                                usePointStyle: true
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const percentage = ((context.parsed * 100) / total).toFixed(1);
                                    return `${context.label}: ${context.parsed} (${percentage}%)`;
                                }
                            }
                        }
                    }
                }
            });
        }

        function initTopCustomersChart(data) {
            const ctx = document.getElementById('topCustomersChart');
            if (!ctx) return;

            if (chartInstances.topCustomers) {
                chartInstances.topCustomers.destroy();
            }

            const labels = data?.labels || [];
            const chartData = data?.data || [];

            chartInstances.topCustomers = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Total Spent (Rs.)',
                        data: chartData,
                        backgroundColor: 'rgba(40, 167, 69, 0.8)',
                        borderColor: 'rgba(40, 167, 69, 1)',
                        borderWidth: 1,
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return `Total Spent: Rs.${context.parsed.y.toLocaleString()}`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            display: true,
                            ticks: {
                                maxRotation: 45,
                                minRotation: 45
                            }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return 'Rs.' + value.toLocaleString();
                                }
                            }
                        }
                    }
                }
            });
        }

        function initInventoryValueChart(data) {
            const ctx = document.getElementById('inventoryValueChart');
            if (!ctx) return;

            if (chartInstances.inventoryValue) {
                chartInstances.inventoryValue.destroy();
            }

            const labels = data?.labels || [];
            const chartData = data?.data || [];

            chartInstances.inventoryValue = new Chart(ctx, {
                type: 'polarArea',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Inventory Value (Rs.)',
                        data: chartData,
                        backgroundColor: [
                            'rgba(255, 99, 132, 0.7)',
                            'rgba(54, 162, 235, 0.7)',
                            'rgba(255, 205, 86, 0.7)',
                            'rgba(75, 192, 192, 0.7)',
                            'rgba(153, 102, 255, 0.7)',
                            'rgba(255, 159, 64, 0.7)'
                        ],
                        borderColor: [
                            'rgba(255, 99, 132, 1)',
                            'rgba(54, 162, 235, 1)',
                            'rgba(255, 205, 86, 1)',
                            'rgba(75, 192, 192, 1)',
                            'rgba(153, 102, 255, 1)',
                            'rgba(255, 159, 64, 1)'
                        ],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                padding: 20
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return `${context.label}: Rs.${context.parsed.r.toLocaleString()}`;
                                }
                            }
                        }
                    },
                    scales: {
                        r: {
                            beginAtZero: true,
                            ticks: {
                                display: false
                            }
                        }
                    }
                }
            });
        }

        async function refreshChart(chartType) {
            const button = event.target.closest('button');
            const originalIcon = button.innerHTML;
            
            button.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            button.disabled = true;

            try {
                await loadAndInitChart(chartType, getInitFunction(chartType));
                showToast('Chart refreshed successfully', 'success');
            } catch (error) {
                console.error('Failed to refresh chart:', error);
                showToast('Failed to refresh chart', 'error');
            } finally {
                button.innerHTML = originalIcon;
                button.disabled = false;
            }
        }

        function getInitFunction(chartType) {
            const functions = {
                'monthlyrevenue': initMonthlyRevenueChart,
                'orderstatus': initOrderStatusChart,
                'topcustomers': initTopCustomersChart,
                'inventoryvalue': initInventoryValueChart
            };
            return functions[chartType];
        }

        function showToast(message, type = 'info') {
            if (typeof Swal !== 'undefined') {
                const Toast = Swal.mixin({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });

                Toast.fire({
                    icon: type,
                    title: message
                });
            } else {
                alert(message);
            }
        }
    </script>
}

@Html.AntiForgeryToken()