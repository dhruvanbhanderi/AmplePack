@using AmplePack.Helpers
@model AmplePack.Controllers.ReportsViewModel
@{
    ViewData["Title"] = "Reports Dashboard";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Reports Dashboard</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <!-- Sales Summary Cards - More Compact -->
        <div class="row mb-3">
            <div class="col-lg-3 col-md-6 col-sm-6 mb-2">
                <div class="info-box">
                    <span class="info-box-icon bg-info">
                        <i class="fas fa-money-bill"></i>
                    </span>
                    <div class="info-box-content">
                        <span class="info-box-text">Total Revenue</span>
                        <span class="info-box-number">@CurrencyHelper.FormatCurrency(Model.TotalRevenue)</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-6 mb-2">
                <div class="info-box">
                    <span class="info-box-icon bg-success">
                        <i class="fas fa-chart-line"></i>
                    </span>
                    <div class="info-box-content">
                        <span class="info-box-text">Monthly Revenue</span>
                        <span class="info-box-number">@CurrencyHelper.FormatCurrency(Model.MonthlyRevenue)</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-6 mb-2">
                <div class="info-box">
                    <span class="info-box-icon bg-warning">
                        <i class="fas fa-shopping-cart"></i>
                    </span>
                    <div class="info-box-content">
                        <span class="info-box-text">Orders This Month</span>
                        <span class="info-box-number">@Model.TotalOrdersThisMonth</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-6 mb-2">
                <div class="info-box">
                    <span class="info-box-icon bg-primary">
                        <i class="fas fa-users"></i>
                    </span>
                    <div class="info-box-content">
                        <span class="info-box-text">Total Customers</span>
                        <span class="info-box-number">@Model.TotalCustomers</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Row -->
        <div class="row mb-3">
            <!-- Monthly Revenue Chart -->
            <div class="col-lg-8 mb-3">
                <div class="card h-100">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-chart-area mr-2"></i>
                            Monthly Revenue Trend
                        </h3>
                    </div>
                    <div class="card-body chart-container">
                        <div class="chart-wrapper" style="position: relative; height: 280px; max-height: 280px;">
                            <canvas id="monthlyRevenueChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Status Distribution -->
            <div class="col-lg-4 mb-3">
                <div class="card h-100">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-chart-pie mr-2"></i>
                            Order Status
                        </h3>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <div class="chart-wrapper flex-grow-1" style="position: relative; height: 180px; max-height: 180px;">
                            <canvas id="orderStatusChart"></canvas>
                        </div>
                        <div class="mt-3">
                            <div class="row text-center">
                                <div class="col-6">
                                    <small class="text-muted">Pending</small>
                                    <div class="font-weight-bold text-warning">@Model.PendingOrders</div>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted">Completed</small>
                                    <div class="font-weight-bold text-success">@Model.CompletedOrders</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Detailed Reports Row -->
        <div class="row mb-3">
            <!-- Top Customers -->
            <div class="col-lg-6 mb-3">
                <div class="card h-100">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-trophy mr-2"></i>
                            Top 5 Customers
                        </h3>
                    </div>
                    <div class="card-body p-0" style="max-height: 350px; overflow-y: auto;">
                        @if (Model.TopCustomers.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-striped mb-0">
                                    <thead class="thead-light sticky-top">
                                        <tr>
                                            <th width="15%">Rank</th>
                                            <th width="45%">Customer</th>
                                            <th width="20%">Orders</th>
                                            <th width="20%">Revenue</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{int rank = 1;}
                                        @foreach (var customer in Model.TopCustomers)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="badge @(rank == 1 ? "badge-warning" : rank == 2 ? "badge-secondary" : rank == 3 ? "badge-info" : "badge-light")">
                                                        #@rank
                                                    </span>
                                                </td>
                                                <td>
                                                    <div>
                                                        <strong class="d-block">@customer.Name</strong>
                                                        <small class="text-muted">@customer.Email</small>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge badge-primary">@customer.Orders.Count()</span>
                                                </td>
                                                <td>
                                                    <strong class="text-success">@CurrencyHelper.FormatCurrency(customer.Orders.Where(o => o.Status == "Completed").Sum(o => o.TotalAmount))</strong>
                                                </td>
                                            </tr>
                                            rank++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <p class="text-muted mb-0">No customer data available</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Critical Stock Items -->
            <div class="col-lg-6 mb-3">
                <div class="card h-100">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-exclamation-triangle mr-2 text-warning"></i>
                            Critical Stock Items
                        </h3>
                    </div>
                    <div class="card-body p-0" style="max-height: 350px; overflow-y: auto;">
                        @if (Model.CriticalStockItems.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-striped mb-0">
                                    <thead class="thead-light sticky-top">
                                        <tr>
                                            <th width="50%">Item</th>
                                            <th width="25%">Stock</th>
                                            <th width="25%">Reorder</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.CriticalStockItems)
                                        {
                                            <tr class="table-warning">
                                                <td>
                                                    <div>
                                                        <strong>@item.ItemName</strong>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge badge-warning">
                                                        @item.AvailableQuantity.ToString("N0") @item.Unit
                                                    </span>
                                                </td>
                                                <td>@item.ReorderLevel.ToString("N0") @item.Unit</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="fas fa-check-circle fa-2x text-success mb-2"></i>
                                <p class="text-success mb-0">All items well stocked!</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Inventory Summary -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-boxes mr-2"></i>
                            Inventory & Operations Summary
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-3 col-md-6 mb-2">
                                <div class="info-box">
                                    <span class="info-box-icon bg-info">
                                        <i class="fas fa-cubes"></i>
                                    </span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Total Items</span>
                                        <span class="info-box-number">@Model.TotalInventoryItems</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 mb-2">
                                <div class="info-box">
                                    <span class="info-box-icon bg-warning">
                                        <i class="fas fa-exclamation-triangle"></i>
                                    </span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Low Stock</span>
                                        <span class="info-box-number">@Model.LowStockCount</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 mb-2">
                                <div class="info-box">
                                    <span class="info-box-icon bg-success">
                                        <i class="fas fa-rupee-sign"></i>
                                    </span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Inventory Value</span>
                                        <span class="info-box-number">@CurrencyHelper.FormatCurrency(Model.TotalInventoryValue)</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 mb-2">
                                <div class="info-box">
                                    <span class="info-box-icon bg-primary">
                                        <i class="fas fa-cog"></i>
                                    </span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Processing</span>
                                        <span class="info-box-number">@Model.ProcessingOrders</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <script>
        $(document).ready(function() {
            // Prevent automatic scrolling
            $('html, body').css({
                'scroll-behavior': 'auto',
                'overflow-x': 'hidden'
            });
            
            // Initialize charts after DOM is ready
            initializeCharts();
        });
        
        function initializeCharts() {
            // Monthly Revenue Chart
            const monthlyCtx = document.getElementById('monthlyRevenueChart');
            if (monthlyCtx) {
                const monthlyChart = new Chart(monthlyCtx, {
                    type: 'line',
                    data: {
                        labels: [@Html.Raw(string.Join(",", Model.MonthlyRevenueChart.Select(x => "'" + x.Month + "'")))],
                        datasets: [{
                            label: 'Revenue (Rs.)',
                            data: [@Html.Raw(string.Join(",", Model.MonthlyRevenueChart.Select(x => x.Revenue.ToString())))],
                            borderColor: '#007bff',
                            backgroundColor: 'rgba(0, 123, 255, 0.1)',
                            borderWidth: 2,
                            tension: 0.1,
                            fill: true,
                            pointBackgroundColor: '#007bff',
                            pointBorderColor: '#fff',
                            pointBorderWidth: 2,
                            pointRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            intersect: false,
                            mode: 'index'
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: {
                                    color: 'rgba(0,0,0,0.1)'
                                },
                                ticks: {
                                    callback: function(value) {
                                        return 'Rs.' + value.toLocaleString('en-IN');
                                    }
                                }
                            },
                            x: {
                                grid: {
                                    color: 'rgba(0,0,0,0.1)'
                                }
                            }
                        },
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                backgroundColor: 'rgba(0,0,0,0.8)',
                                titleColor: '#fff',
                                bodyColor: '#fff',
                                callbacks: {
                                    label: function(context) {
                                        return 'Revenue: Rs.' + context.parsed.y.toLocaleString('en-IN');
                                    }
                                }
                            }
                        }
                    });
            }

            // Order Status Pie Chart
            const statusCtx = document.getElementById('orderStatusChart');
            if (statusCtx) {
                const statusChart = new Chart(statusCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Pending', 'Processing', 'Completed', 'Cancelled'],
                        datasets: [{
                            data: [@Model.PendingOrders, @Model.ProcessingOrders, @Model.CompletedOrders, @Model.CancelledOrders],
                            backgroundColor: [
                                '#ffc107',
                                '#17a2b8', 
                                '#28a745',
                                '#dc3545'
                            ],
                            borderWidth: 2,
                            borderColor: '#fff',
                            hoverBorderWidth: 3,
                            hoverBorderColor: '#fff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '60%',
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                backgroundColor: 'rgba(0,0,0,0.8)',
                                titleColor: '#fff',
                                bodyColor: '#fff',
                                callbacks: {
                                    label: function(context) {
                                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                        const percentage = ((context.parsed / total) * 100).toFixed(1);
                                        return context.label + ': ' + context.parsed + ' (' + percentage + '%)';
                                    }
                                }
                            }
                        }
                    });
            }
        }
    </script>
    
    <style>
        /* Fix scrolling and layout issues */
        .content-wrapper {
            overflow-x: hidden !important;
        }
        
        .chart-container {
            overflow: hidden;
        }
        
        .chart-wrapper {
            overflow: hidden;
        }
        
        .chart-wrapper canvas {
            max-width: 100% !important;
            height: auto !important;
        }
        
        /* Prevent horizontal scrolling */
        .row {
            margin-left: -7.5px;
            margin-right: -7.5px;
        }
        
        .row > [class*="col-"] {
            padding-left: 7.5px;
            padding-right: 7.5px;
        }
        
        /* Fix table scrolling */
        .table-responsive {
            border: none;
        }
        
        /* Sticky header for tables */
        .sticky-top {
            position: sticky;
            top: 0;
            z-index: 10;
            background-color: #f8f9fa;
        }
        
        /* Info box improvements */
        .info-box {
            min-height: 80px;
            margin-bottom: 0;
        }
        
        .info-box-content {
            padding: 10px 10px 10px 15px;
        }
        
        .info-box-number {
            font-size: 1.3rem;
            font-weight: 700;
        }
        
        .info-box-text {
            font-size: 0.875rem;
            text-transform: uppercase;
            font-weight: 600;
        }
        
        /* Card height consistency */
        .h-100 {
            height: 100% !important;
        }
        
        /* Smooth scrolling only for content areas */
        .card-body {
            scroll-behavior: smooth;
        }
        
        /* Prevent chart overflow */
        #monthlyRevenueChart, #orderStatusChart {
            max-width: 100% !important;
            max-height: 100% !important;
        }
    </style>
}