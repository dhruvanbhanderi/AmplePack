@using AmplePack.Helpers
@model AmplePack.Models.OrderDetailInput
@{
    ViewData["Title"] = "Create Order";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Create New Order</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-plus-circle mr-2"></i>
                            Order Details
                        </h3>
                    </div>
                    
                    <form asp-action="CreateWorkflow" method="post">
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(TempData["SuccessMessage"]?.ToString()))
                            {
                                <div class="alert alert-success alert-dismissible fade show">
                                    <i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]
                                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                                </div>
                            }
                            
                            <div asp-validation-summary="All" class="alert alert-danger"></div>
                            
                            <!-- Customer Selection -->
                            <div class="form-group">
                                <label asp-for="CustomerId" class="font-weight-bold">Customer *</label>
                                <select asp-for="CustomerId" class="form-control" asp-items="ViewBag.Customers" required>
                                    <option value="">-- Select Customer --</option>
                                </select>
                                <span asp-validation-for="CustomerId" class="text-danger"></span>
                            </div>

                            <!-- Product Selection -->
                            <div class="form-group">
                                <label asp-for="CustomerProductId" class="font-weight-bold">Customer Product (Optional)</label>
                                <select asp-for="CustomerProductId" class="form-control" id="productSelect">
                                    <option value="">-- Select Customer Product or Enter Manual Details --</option>
                                </select>
                                <small class="text-muted">Select a saved customer product or enter details manually below</small>
                            </div>

                            <!-- Manual Product Details -->
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="BoxType" class="font-weight-bold">Box Type</label>
                                        <input asp-for="BoxType" class="form-control" placeholder="e.g., Custom Shipping Box" />
                                        <span asp-validation-for="BoxType" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="font-weight-bold">Dimensions (cm)</label>
                                        <div class="row">
                                            <div class="col-4">
                                                <input asp-for="Length" class="form-control" placeholder="Length" />
                                                <small class="text-muted">Length</small>
                                            </div>
                                            <div class="col-4">
                                                <input asp-for="Width" class="form-control" placeholder="Width" />
                                                <small class="text-muted">Width</small>
                                            </div>
                                            <div class="col-4">
                                                <input asp-for="Height" class="form-control" placeholder="Height" />
                                                <small class="text-muted">Height</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Quantity and Price -->
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label asp-for="Quantity" class="font-weight-bold">Quantity *</label>
                                        <input asp-for="Quantity" class="form-control" type="number" min="1" required />
                                        <span asp-validation-for="Quantity" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label asp-for="PricePerBox" class="font-weight-bold">Price per Box *</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">Rs.</span>
                                            </div>
                                            <input asp-for="PricePerBox" class="form-control" type="number" step="0.01" min="0.01" required />
                                        </div>
                                        <span asp-validation-for="PricePerBox" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label class="font-weight-bold">Total Amount</label>
                                        <div class="form-control-plaintext">
                                            <h5 class="text-success mb-0" id="totalAmount">Rs.0.00</h5>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Delivery Date -->
                            <div class="form-group">
                                <label asp-for="DeliveryDate" class="font-weight-bold">Delivery Date (Optional)</label>
                                <input asp-for="DeliveryDate" class="form-control" type="date" />
                                <span asp-validation-for="DeliveryDate" class="text-danger"></span>
                            </div>

                            <!-- Notes -->
                            <div class="form-group">
                                <label asp-for="Notes" class="font-weight-bold">Notes (Optional)</label>
                                <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Special instructions, material notes, delivery requirements..."></textarea>
                                <span asp-validation-for="Notes" class="text-danger"></span>
                            </div>
                        </div>
                        
                        <div class="card-footer">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save mr-2"></i>Create Order
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-list mr-2"></i>Back to Orders
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            // Calculate total amount when quantity or price changes
            function calculateTotal() {
                const qty = parseInt($('#Quantity').val()) || 0;
                const price = parseFloat($('#PricePerBox').val()) || 0;
                const total = qty * price;
                $('#totalAmount').text('Rs.' + total.toFixed(2));
            }

            $('#Quantity, #PricePerBox').on('input', calculateTotal);

            // Load customer products when customer changes
            $('#CustomerId').on('change', function() {
                const customerId = $(this).val();
                if (customerId) {
                    loadCustomerProducts(customerId);
                } else {
                    $('#productSelect').html('<option value="">-- Select Customer Product or Enter Manual Details --</option>');
                }
            });

            // Load product details when product changes
            $('#productSelect').on('change', function() {
                const productId = $(this).val();
                if (productId) {
                    loadProductDetails(productId);
                }
            });

            function loadCustomerProducts(customerId) {
                $.get('/Orders/GetCustomerProducts', { customerId: customerId })
                    .done(function(products) {
                        let options = '<option value="">-- Select Customer Product or Enter Manual Details --</option>';
                        products.forEach(function(product) {
                            options += `<option value="${product.id}">${product.productName} - Rs.${product.pricePerBox}</option>`;
                        });
                        $('#productSelect').html(options);
                    })
                    .fail(function() {
                        console.error('Failed to load customer products');
                    });
            }

            function loadProductDetails(productId) {
                $.get('/Orders/GetProductDetails', { id: productId })
                    .done(function(response) {
                        if (response.success) {
                            const product = response.product;
                            $('#BoxType').val(product.productName);
                            $('#Length').val(product.length);
                            $('#Width').val(product.width);
                            $('#Height').val(product.height);
                            $('#Quantity').val(product.defaultQuantity);
                            $('#PricePerBox').val(product.pricePerBox);
                            calculateTotal();
                        }
                    })
                    .fail(function() {
                        console.error('Failed to load product details');
                    });
            }

            // Initial calculation
            calculateTotal();
        });
    </script>
}