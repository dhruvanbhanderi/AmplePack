@page
@model AmplePack.Pages_Orders.DeleteModel
@{
    ViewData["Title"] = "Delete Order";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="row">
  <div class="col-md-8 offset-md-2">
    <div class="card card-danger">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fas fa-exclamation-triangle"></i> Delete Order
        </h3>
      </div>
      <div class="card-body">
        <div class="alert alert-warning">
          <h5><i class="icon fas fa-exclamation-triangle"></i> Warning!</h5>
          Are you sure you want to delete this order? This action cannot be undone and will remove all associated order details.
        </div>

        <div class="row">
          <div class="col-md-6">
            <table class="table table-borderless">
              <tr>
                <th>Order ID:</th>
                <td>#@Html.DisplayFor(model => model.Order!.Id)</td>
              </tr>
              <tr>
                <th>Customer:</th>
                <td>@Html.DisplayFor(model => model.Order!.Customer!.Name)</td>
              </tr>
              <tr>
                <th>Order Date:</th>
                <td>@Model.Order?.Date.ToString("MMMM dd, yyyy")</td>
              </tr>
              <tr>
                <th>Status:</th>
                <td>
                  <span class="badge @(Model.Order?.Status == "Completed" ? "badge-success" : Model.Order?.Status == "Pending" ? "badge-warning" : Model.Order?.Status == "Processing" ? "badge-info" : "badge-danger")">
                    @Model.Order?.Status
                  </span>
                </td>
              </tr>
              <tr>
                <th>Total Amount:</th>
                <td><strong>$@Html.DisplayFor(model => model.Order!.TotalAmount)</strong></td>
              </tr>
            </table>
          </div>
          <div class="col-md-6">
            @if (Model.Order?.OrderDetails?.Any() == true)
            {
              <h6>Order Items:</h6>
              <ul class="list-group list-group-flush">
                @foreach (var detail in Model.Order.OrderDetails.Take(3))
                {
                  <li class="list-group-item p-2">
                    <strong>@detail.BoxType</strong> (@detail.Size)<br>
                    <small class="text-muted">Qty: @detail.Quantity × $@detail.PricePerBox</small>
                  </li>
                }
                @if (Model.Order.OrderDetails.Count() > 3)
                {
                  <li class="list-group-item p-2 text-muted">
                    <small>...and @(Model.Order.OrderDetails.Count() - 3) more items</small>
                  </li>
                }
              </ul>
            }
          </div>
        </div>
      </div>
      <div class="card-footer">
        <form method="post">
          <input type="hidden" asp-for="Order!.Id" />
          <button type="submit" class="btn btn-danger">
            <i class="fas fa-trash"></i> Yes, Delete Order
          </button>
          <a asp-page="./Index" class="btn btn-secondary">
            <i class="fas fa-times"></i> Cancel
          </a>
          <a asp-page="./Details" asp-route-id="@Model.Order?.Id" class="btn btn-info">
            <i class="fas fa-eye"></i> View Details
          </a>
        </form>
      </div>
    </div>
  </div>
</div>
