@model AmplePack.Models.Inventory
@{
    ViewData["Title"] = "Delete Inventory Item";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Delete Inventory Item</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <div class="card card-danger">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-exclamation-triangle mr-2"></i>
                            Confirm Deletion
                        </h3>
                    </div>
                    
                    <div class="card-body">
                        <div class="alert alert-danger">
                            <h5><i class="fas fa-exclamation-triangle"></i> Warning!</h5>
                            Are you sure you want to delete this inventory item? This action cannot be undone.
                        </div>
                        
                        <dl class="row">
                            <dt class="col-sm-3">Product Name:</dt>
                            <dd class="col-sm-9">@Model.ProductName</dd>
                            
                            <dt class="col-sm-3">Item Name:</dt>
                            <dd class="col-sm-9">@Model.ItemName</dd>
                            
                            <dt class="col-sm-3">Available Quantity:</dt>
                            <dd class="col-sm-9">
                                <span class="badge @(Model.IsLowStock ? "badge-warning" : "badge-success")">
                                    @Model.AvailableQuantity.ToString("N2") @Model.Unit
                                </span>
                            </dd>
                            
                            <dt class="col-sm-3">Unit Price:</dt>
                            <dd class="col-sm-9">$@Model.UnitPrice.ToString("N2")</dd>
                            
                            <dt class="col-sm-3">Total Value:</dt>
                            <dd class="col-sm-9">
                                <strong class="text-danger">$@Model.TotalValue.ToString("N2")</strong>
                            </dd>
                            
                            <dt class="col-sm-3">Category:</dt>
                            <dd class="col-sm-9">
                                <span class="badge badge-info">@Model.Category</span>
                            </dd>
                        </dl>
                        
                        @if (Model.AvailableQuantity > 0)
                        {
                            <div class="alert alert-warning">
                                <strong>Note:</strong> This item currently has @Model.AvailableQuantity.ToString("N2") @Model.Unit in stock 
                                with a total value of $@Model.TotalValue.ToString("N2"). 
                                Deleting this item will permanently remove this inventory value from your records.
                            </div>
                        }
                    </div>
                    
                    <div class="card-footer">
                        <form asp-action="Delete" method="post" class="d-inline">
                            <input type="hidden" asp-for="Id" />
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Are you absolutely sure you want to delete this inventory item? This action cannot be undone.')">
                                <i class="fas fa-trash"></i> Yes, Delete Item
                            </button>
                        </form>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info ml-2">
                            <i class="fas fa-eye"></i> View Details
                        </a>
                        <a asp-action="Index" class="btn btn-secondary ml-2">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>