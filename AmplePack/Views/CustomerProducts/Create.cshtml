@model AmplePack.Models.CustomerProduct
@{
    ViewData["Title"] = "Create Customer Product";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Create Customer Product</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-10 offset-md-1">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-cube mr-2"></i>
                            Add New Customer Product
                        </h3>
                    </div>
                    
                    <form asp-action="Create" method="post">
                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                            
                            <!-- Customer and Product Name -->
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="CustomerId" class="control-label">Customer *</label>
                                        <select asp-for="CustomerId" asp-items="ViewBag.CustomerId" class="form-control">
                                            <option value="">-- Select Customer --</option>
                                        </select>
                                        <span asp-validation-for="CustomerId" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="ProductName" class="control-label">Product Name *</label>
                                        <input asp-for="ProductName" class="form-control" placeholder="Enter product name" />
                                        <span asp-validation-for="ProductName" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Description -->
                            <div class="form-group">
                                <label asp-for="Description" class="control-label">Description</label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Product description (optional)"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                            
                            <!-- Box Dimensions -->
                            <div class="card card-outline card-info">
                                <div class="card-header">
                                    <h5 class="card-title">Box Dimensions (cm)</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label asp-for="Length" class="control-label">Length (cm) *</label>
                                                <input asp-for="Length" class="form-control" type="number" step="0.1" min="0.1" placeholder="0.0" />
                                                <span asp-validation-for="Length" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label asp-for="Width" class="control-label">Width (cm) *</label>
                                                <input asp-for="Width" class="form-control" type="number" step="0.1" min="0.1" placeholder="0.0" />
                                                <span asp-validation-for="Width" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label asp-for="Height" class="control-label">Height (cm) *</label>
                                                <input asp-for="Height" class="form-control" type="number" step="0.1" min="0.1" placeholder="0.0" />
                                                <span asp-validation-for="Height" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Box Specifications -->
                            <div class="card card-outline card-warning">
                                <div class="card-header">
                                    <h5 class="card-title">Box Specifications</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label asp-for="GSM" class="control-label">GSM *</label>
                                                <select asp-for="GSM" class="form-control">
                                                    <option value="">-- Select GSM --</option>
                                                    <option value="180">180 GSM</option>
                                                    <option value="200">200 GSM</option>
                                                    <option value="250">250 GSM</option>
                                                    <option value="300">300 GSM</option>
                                                    <option value="350">350 GSM</option>
                                                </select>
                                                <span asp-validation-for="GSM" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label asp-for="PaperType" class="control-label">Paper Type *</label>
                                                <select asp-for="PaperType" class="form-control">
                                                    <option value="">-- Select Paper --</option>
                                                    <option value="Corrugated">Corrugated</option>
                                                    <option value="Art Paper">Art Paper</option>
                                                    <option value="Kraft Paper">Kraft Paper</option>
                                                    <option value="Duplex Board">Duplex Board</option>
                                                </select>
                                                <span asp-validation-for="PaperType" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label asp-for="PrintingType" class="control-label">Printing Type *</label>
                                                <select asp-for="PrintingType" class="form-control">
                                                    <option value="">-- Select Printing --</option>
                                                    <option value="No Printing">No Printing</option>
                                                    <option value="1 Color">1 Color</option>
                                                    <option value="2 Color">2 Color</option>
                                                    <option value="4 Color">4 Color</option>
                                                    <option value="Full Color">Full Color</option>
                                                </select>
                                                <span asp-validation-for="PrintingType" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label asp-for="Category" class="control-label">Category</label>
                                                <select asp-for="Category" class="form-control">
                                                    <option value="">-- Select Category --</option>
                                                    <option value="Standard">Standard</option>
                                                    <option value="Premium">Premium</option>
                                                    <option value="Economy">Economy</option>
                                                    <option value="Custom">Custom</option>
                                                </select>
                                                <span asp-validation-for="Category" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Pricing and Quantity -->
                            <div class="card card-outline card-success">
                                <div class="card-header">
                                    <h5 class="card-title">Pricing & Quantity</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="PricePerBox" class="control-label">Price per Box ($) *</label>
                                                <input asp-for="PricePerBox" class="form-control" type="number" step="0.01" min="0.01" placeholder="0.00" />
                                                <span asp-validation-for="PricePerBox" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="DefaultQuantity" class="control-label">Default Quantity</label>
                                                <input asp-for="DefaultQuantity" class="form-control" type="number" min="1" placeholder="1" />
                                                <span asp-validation-for="DefaultQuantity" class="text-danger"></span>
                                                <small class="form-text text-muted">Default quantity for new orders</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="alert alert-info">
                                <h6><i class="fas fa-info-circle"></i> Product Summary</h6>
                                <p class="mb-0">This product will be saved as a template for quick order creation. 
                                   You can modify quantities and pricing when creating orders.</p>
                            </div>
                        </div>
                        
                        <div class="card-footer">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Create Product
                            </button>
                            <a asp-action="Index" class="btn btn-secondary ml-2">
                                <i class="fas fa-arrow-left"></i> Back to List
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}