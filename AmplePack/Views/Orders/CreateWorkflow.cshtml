@{
    ViewData["Title"] = "Create Order";
}

<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="card card-primary">
        <div class="card-header">
          <h3 class="card-title">Create New Order</h3>
        </div>
        
        <form method="post" asp-action="CreateWorkflow" id="orderForm">
          <div class="card-body">
            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
              <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
            }
            
            <!-- Step 1: Customer Selection -->
            <div class="card mb-3" id="step1">
              <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="fas fa-user"></i> Step 1: Select Customer</h6>
              </div>
              <div class="card-body">
                <div class="row">
                  <div class="col-md-6 col-12">
                    <div class="form-group">
                      <label for="customerId">Customer *</label>
                      <select name="customerId" class="form-control select2" id="customerSelect">
                        <option value="">-- Select Customer --</option>
                        @if (ViewBag.Customers != null)
                        {
                          @foreach (var customer in (List<AmplePack.Models.Customer>)ViewBag.Customers)
                          {
                            <option value="@customer.Id">@customer.Name</option>
                          }
                        }
                      </select>
                    </div>
                  </div>
                  <div class="col-md-6 col-12">
                    <div class="form-group">
                      <label for="orderDate">Order Date *</label>
                      <input name="orderDate" class="form-control" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Step 2: Product Selection -->
            <div class="card mb-3" id="step2" style="display: none;">
              <div class="card-header bg-success text-white">
                <h6 class="mb-0"><i class="fas fa-layer-group"></i> Step 2: Select Products</h6>
              </div>
              <div class="card-body">
                <div class="row">
                  <div class="col-lg-9 col-12">
                    <h6>Customer's Saved Products:</h6>
                    <div id="savedProductsList" class="row">
                      <!-- Saved products will load here -->
                    </div>
                  </div>
                  <div class="col-lg-3 col-12">
                    <div class="mt-3 mt-lg-0">
                      <button type="button" class="btn btn-outline-primary btn-block mb-2" id="addNewProductBtn">
                        <i class="fas fa-plus"></i> Add New Product
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Step 3: Order Details -->
            <div class="card mb-3" id="step3">
              <div class="card-header bg-info text-white">
                <h6 class="mb-0">
                  <i class="fas fa-shopping-cart"></i> Step 3: Order Details
                  <span class="badge badge-light text-dark ml-2" id="itemCount">0 items</span>
                </h6>
              </div>
              <div class="card-body">
                <div class="table-responsive">
                  <table class="table table-sm" id="orderItemsTable">
                    <thead>
                      <tr>
                        <th>Product</th>
                        <th class="d-none d-md-table-cell">Size</th>
                        <th>Qty</th>
                        <th>Price</th>
                        <th>Total</th>
                        <th>Action</th>
                      </tr>
                    </thead>
                    <tbody id="orderItemsBody">
                      <!-- Order items will be added here -->
                    </tbody>
                  </table>
                  
                  <div class="alert alert-info">
                    <strong>Grand Total: $<span id="grandTotal">0.00</span></strong>
                  </div>
                </div>
              </div>
            </div>

            <input type="hidden" name="orderDetails" id="orderDetailsJson" />
          </div>
          
          <div class="card-footer">
            <button type="submit" class="btn btn-primary btn-block btn-lg" id="submitBtn">
              <i class="fas fa-save"></i> Create Order
            </button>
            <a asp-action="Index" class="btn btn-secondary btn-block mt-2">
              <i class="fas fa-arrow-left"></i> Back to List
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            let orderItems = [];
            let selectedCustomerId = null;

            $('#customerSelect').select2({
                theme: 'bootstrap4',
                placeholder: '-- Select Customer --',
                width: '100%'
            });

            $('#customerSelect').on('change', function() {
                selectedCustomerId = $(this).val();
                if (selectedCustomerId) {
                    loadCustomerProducts(selectedCustomerId);
                    $('#step2').show();
                } else {
                    $('#step2').hide();
                }
            });

            function loadCustomerProducts(customerId) {
                // For now, we'll add a simple interface to add products manually
                let html = `
                    <div class="col-12">
                        <div class="card product-card" style="cursor: pointer;" onclick="addSimpleProduct()">
                            <div class="card-body p-2">
                                <h6 class="card-title mb-1">Add Product to Order</h6>
                                <small class="text-muted">Click to add a product to this order</small>
                            </div>
                        </div>
                    </div>
                `;
                $('#savedProductsList').html(html);
            }

            window.addSimpleProduct = function() {
                let productName = prompt("Enter product name:");
                let price = prompt("Enter price per unit:");
                
                if (productName && price) {
                    let orderItem = {
                        id: Date.now(),
                        customerProductId: null,
                        productName: productName,
                        boxType: productName,
                        size: "Custom",
                        quantity: 1,
                        pricePerBox: parseFloat(price),
                        deliveryDate: new Date().toISOString().split('T')[0],
                        notes: ''
                    };

                    orderItems.push(orderItem);
                    renderOrderItems();
                    updateOrderSummary();
                }
            };

            function renderOrderItems() {
                let html = '';
                orderItems.forEach(function(item, index) {
                    html += `
                        <tr data-item-id="${item.id}">
                            <td>
                                <strong>${item.productName}</strong>
                                <div class="d-md-none">
                                    <small class="text-muted">${item.size}</small>
                                </div>
                            </td>
                            <td class="d-none d-md-table-cell">
                                <small>${item.size}</small>
                            </td>
                            <td style="width: 80px;">
                                <input type="number" class="form-control form-control-sm quantity-input" 
                                       value="${item.quantity}" min="1" data-item-id="${item.id}" 
                                       style="font-size: 14px; padding: 0.25rem;">
                            </td>
                            <td style="width: 90px;">
                                <input type="number" class="form-control form-control-sm price-input" 
                                       value="${item.pricePerBox}" step="0.01" min="0" data-item-id="${item.id}"
                                       style="font-size: 14px; padding: 0.25rem;">
                            </td>
                            <td>
                                <strong class="item-total">$${(item.quantity * item.pricePerBox).toFixed(2)}</strong>
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-danger remove-item" data-item-id="${item.id}">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                });
                $('#orderItemsBody').html(html);
                $('#itemCount').text(`${orderItems.length} items`);
            }

            $(document).on('input', '.quantity-input, .price-input', function() {
                let itemId = parseInt($(this).data('item-id'));
                let field = $(this).hasClass('quantity-input') ? 'quantity' : 'pricePerBox';
                let value = parseFloat($(this).val()) || 0;
                
                let item = orderItems.find(item => item.id === itemId);
                if (item) {
                    item[field] = value;
                    
                    let $row = $(this).closest('tr');
                    let newTotal = item.quantity * item.pricePerBox;
                    $row.find('.item-total').text('$' + newTotal.toFixed(2));
                    
                    updateOrderSummary();
                }
            });

            $(document).on('click', '.remove-item', function() {
                let itemId = parseInt($(this).data('item-id'));
                orderItems = orderItems.filter(item => item.id !== itemId);
                renderOrderItems();
                updateOrderSummary();
            });

            function updateOrderSummary() {
                let grandTotal = orderItems.reduce((sum, item) => sum + (item.quantity * item.pricePerBox), 0);
                $('#grandTotal').text(grandTotal.toFixed(2));
            }

            $('#orderForm').on('submit', function(e) {
                if (orderItems.length === 0) {
                    e.preventDefault();
                    alert('Please add at least one product to the order.');
                    return false;
                }

                let orderDetails = orderItems.map(item => ({
                    CustomerProductId: item.customerProductId,
                    Quantity: item.quantity,
                    PricePerBox: item.pricePerBox
                }));

                $('#orderDetailsJson').val(JSON.stringify(orderDetails));
                $('#submitBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Creating...');
            });
        });
    </script>
}