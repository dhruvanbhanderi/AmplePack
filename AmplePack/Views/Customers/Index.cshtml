@model List<AmplePack.Models.Customer>
@{
    ViewData["Title"] = "Customer Management";
}

<!-- Content Header -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Customer Management</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                    <li class="breadcrumb-item active">Customers</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        
        <!-- Quick Stats Row -->
        <div class="row">
            <div class="col-lg-3 col-6">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3>@Model.Count</h3>
                        <p>Total Customers</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <a asp-action="Create" class="small-box-footer">
                        Add New Customer <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3>@Model.Where(c => c.Orders.Any()).Count()</h3>
                        <p>Active Customers</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-user-check"></i>
                    </div>
                    <a href="#" class="small-box-footer">
                        View Details <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3>@Model.Sum(c => c.Orders.Count)</h3>
                        <p>Total Orders</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <a asp-controller="Orders" asp-action="Index" class="small-box-footer">
                        View Orders <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-danger">
                    <div class="inner">
                        <h3>@Model.Sum(c => c.CustomerProducts.Count)</h3>
                        <p>Total Products</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-cube"></i>
                    </div>
                    <a asp-controller="CustomerProducts" asp-action="Index" class="small-box-footer">
                        View Products <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Customers Table -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-users mr-2"></i>
                            Customer Directory
                        </h3>
                        <div class="card-tools">
                            <a asp-action="Create" class="btn btn-primary btn-sm">
                                <i class="fas fa-plus mr-1"></i>
                                Add Customer
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (Model.Any())
                        {
                            <table id="customersTable" class="table table-bordered table-striped data-table">
                                <thead>
                                    <tr>
                                        <th>Customer</th>
                                        <th>Contact Info</th>
                                        <th>Address</th>
                                        <th>Orders</th>
                                        <th>Products</th>
                                        <th class="no-sort" style="width: 150px">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var customer in Model)
                                    {
                                        <tr>
                                            <td>
                                                <div class="customer-info">
                                                    <strong>@customer.Name</strong>
                                                    <small class="text-muted">ID: #@customer.Id</small>
                                                </div>
                                            </td>
                                            <td>
                                                <div>
                                                    @if (!string.IsNullOrEmpty(customer.Contact))
                                                    {
                                                        <div class="mb-1">
                                                            <i class="fas fa-phone text-primary mr-1"></i>
                                                            <small>@customer.Contact</small>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(customer.Email))
                                                    {
                                                        <div>
                                                            <i class="fas fa-envelope text-info mr-1"></i>
                                                            <small>
                                                                <a href="mailto:@customer.Email" class="text-info">
                                                                    @customer.Email
                                                                </a>
                                                            </small>
                                                        </div>
                                                    }
                                                    @if (string.IsNullOrEmpty(customer.Contact) && string.IsNullOrEmpty(customer.Email))
                                                    {
                                                        <small class="text-muted">No contact info</small>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(customer.Address))
                                                {
                                                    <small>@customer.Address</small>
                                                }
                                                else
                                                {
                                                    <small class="text-muted">No address</small>
                                                }
                                            </td>
                                            <td>
                                                @if (customer.Orders.Any())
                                                {
                                                    <span class="badge badge-primary">
                                                        @customer.Orders.Count
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary">0</span>
                                                }
                                            </td>
                                            <td>
                                                @if (customer.CustomerProducts.Any())
                                                {
                                                    <span class="badge badge-info">
                                                        @customer.CustomerProducts.Count
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary">0</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group">
                                                    <button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                        <i class="fas fa-cog"></i>
                                                        Actions
                                                    </button>
                                                    <div class="dropdown-menu dropdown-menu-right">
                                                        <a class="dropdown-item" asp-action="Details" asp-route-id="@customer.Id">
                                                            <i class="fas fa-eye mr-2"></i>
                                                            View Details
                                                        </a>
                                                        
                                                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                                        {
                                                            <a class="dropdown-item" asp-action="Edit" asp-route-id="@customer.Id">
                                                                <i class="fas fa-edit mr-2"></i>
                                                                Edit Customer
                                                            </a>
                                                        }
                                                        
                                                        <div class="dropdown-divider"></div>
                                                        
                                                        <a class="dropdown-item" href="javascript:void(0)" onclick="createOrderForCustomer(@customer.Id)">
                                                            <i class="fas fa-plus mr-2"></i>
                                                            Create Order
                                                        </a>
                                                        
                                                        <a class="dropdown-item" href="javascript:void(0)" onclick="addProductForCustomer(@customer.Id)">
                                                            <i class="fas fa-cube mr-2"></i>
                                                            Add Product
                                                        </a>
                                                        
                                                        @if (User.IsInRole("Admin"))
                                                        {
                                                            <div class="dropdown-divider"></div>
                                                            <a class="dropdown-item text-danger" href="javascript:void(0)" onclick="confirmDelete(@customer.Id, '@customer.Name')">
                                                                <i class="fas fa-trash mr-2"></i>
                                                                Delete Customer
                                                            </a>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <div class="mb-4">
                                    <i class="fas fa-users fa-4x text-muted"></i>
                                </div>
                                <h4 class="text-muted">No Customers Found</h4>
                                <p class="text-muted mb-4">Get started by adding your first customer to the system.</p>
                                <a asp-action="Create" class="btn btn-primary btn-lg">
                                    <i class="fas fa-plus mr-2"></i>
                                    Add First Customer
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <!-- DataTables & Plugins -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap4.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap4.min.js"></script>
    
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        // Page-specific JavaScript
        $(document).ready(function() {
            // Initialize DataTable with custom configuration
            $('#customersTable').DataTable({
                responsive: true,
                autoWidth: false,
                pageLength: 25,
                order: [[0, 'asc']],
                columnDefs: [
                    { orderable: false, targets: [5] }, // Actions column
                    { responsivePriority: 1, targets: 0 }, // Customer name
                    { responsivePriority: 2, targets: 5 }, // Actions
                    { responsivePriority: 3, targets: 1 }  // Contact info
                ],
                language: {
                    search: "Search customers:",
                    lengthMenu: "Show _MENU_ customers per page",
                    info: "Showing _START_ to _END_ of _TOTAL_ customers",
                    emptyTable: "No customers found",
                    zeroRecords: "No matching customers found"
                },
                dom: "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                     "<'row'<'col-sm-12'tr>>" +
                     "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>"
            });
        });

        // Customer management functions
        function createOrderForCustomer(customerId) {
            window.location.href = `/Orders/CreateWorkflow?customerId=${customerId}`;
        }

        function addProductForCustomer(customerId) {
            window.location.href = `/CustomerProducts/Create?customerId=${customerId}`;
        }

        function confirmDelete(customerId, customerName) {
            Swal.fire({
                title: 'Delete Customer?',
                text: `Are you sure you want to delete "${customerName}"? This action cannot be undone.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = `/Customers/Delete/${customerId}`;
                }
            });
        }
    </script>
}

<!-- Include DataTables CSS -->
@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap4.min.css">
}