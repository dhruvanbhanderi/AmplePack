                                                    <td class="text-right">Rs.@Model.Result.Quantities["1000"].Punching.ToString("F4")</td>
                                                    <td class="text-right">Rs.@Model.Result.Quantities["2000"].Punching.ToString("F4")</td>
                                                    <td class="text-right">Rs.@Model.Result.Quantities["3000"].Punching.ToString("F4")</td>
