@echo off
echo ????????????????????????????????????????????????????????????????
echo ?  AmplePack - Local Deployment (Port 5000)                   ?
echo ?  With SQLite Decimal Ordering Fixes                         ?
echo ????????????????????????????????????????????????????????????????
echo.

cd /d "%~dp0AmplePack"

echo [1/5] Cleaning previous builds...
dotnet clean --nologo >nul 2>&1

echo [2/5] Building project...
dotnet build --configuration Release --nologo
if errorlevel 1 (
    echo.
    echo ? Build failed! Check errors above.
    pause
    exit /b 1
)

echo [3/5] Checking database...
if not exist "AmplePack.sqlite" (
    echo    Creating new database...
) else (
    echo    Database found - will use existing data
)

echo [4/5] Starting AmplePack on http://localhost:5000...
echo.
echo ????????????????????????????????????????????????????????????????
echo ?  ? SERVER IS STARTING                                       ?
echo ?                                                               ?
echo ?  ?? URL: http://localhost:5000                              ?
echo ?  ?? Database: AmplePack.sqlite                              ?
echo ?                                                               ?
echo ?  ?? Default Login:                                          ?
echo ?     Email: admin@ample.com                                  ?
echo ?     Password: Admin@123                                      ?
echo ?                                                               ?
echo ?  ? DO NOT CLOSE THIS WINDOW                                ?
echo ?     The server is running here                              ?
echo ?                                                               ?
echo ?  Press Ctrl+C to stop the server                            ?
echo ????????????????????????????????????????????????????????????????
echo.
echo [5/5] Browser will open automatically...
echo.

dotnet run --configuration Release --no-build

pause
