@using AmplePack.Helpers
@{
    ViewData["Title"] = "Dashboard";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">
                    <i class="fas fa-tachometer-alt mr-2"></i>
                    Dashboard
                </h1>
                <p class="text-muted">Welcome back! Here's what's happening with your business today.</p>
            </div>
            <div class="col-sm-6">
                <div class="float-sm-right">
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="refreshDashboard()">
                        <i class="fas fa-sync-alt"></i> Refresh
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <!-- Enhanced Main Stats Cards -->
        <div class="row mb-4">
            <div class="col-lg-3 col-md-6 col-12">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3 id="totalOrders">@ViewBag.TotalOrders</h3>
                        <p>Total Orders</p>
                        <div class="progress progress-sm">
                            <div class="progress-bar bg-light" style="width: 70%"></div>
                        </div>
                        <span class="progress-description">
                            <i class="fas fa-arrow-up text-success"></i> 12% increase this month
                        </span>
                    </div>
                    <div class="icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <a href="@Url.Action("Index", "Orders")" class="small-box-footer">
                        More info <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-12">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3 id="totalCustomers">@ViewBag.TotalCustomers</h3>
                        <p>Total Customers</p>
                        <div class="progress progress-sm">
                            <div class="progress-bar bg-light" style="width: 85%"></div>
                        </div>
                        <span class="progress-description">
                            <i class="fas fa-arrow-up text-success"></i> 8% growth
                        </span>
                    </div>
                    <div class="icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <a href="@Url.Action("Index", "Customers")" class="small-box-footer">
                        More info <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-12">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3 id="monthlyRevenue">@CurrencyHelper.FormatCurrency(ViewBag.MonthlyRevenue ?? 0)</h3>
                        <p>Monthly Revenue</p>
                        <div class="progress progress-sm">
                            <div class="progress-bar bg-light" style="width: 60%"></div>
                        </div>
                        <span class="progress-description">
                            <i class="fas fa-arrow-down text-danger"></i> 2% lower than last month
                        </span>
                    </div>
                    <div class="icon">
                        <i class="fas fa-money-bill"></i>
                    </div>
                    <a href="@Url.Action("Index", "Reports")" class="small-box-footer">
                        More info <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-12">
                <div class="small-box bg-danger">
                    <div class="inner">
                        <h3 id="lowStockCount">@ViewBag.LowStockCount</h3>
                        <p>Low Stock Items</p>
                        <div class="progress progress-sm">
                            <div class="progress-bar bg-light" style="width: 30%"></div>
                        </div>
                        <span class="progress-description">
                            @if ((int)ViewBag.LowStockCount > 0)
                            {
                                <i class="fas fa-exclamation-triangle text-warning"></i> @ViewBag.LowStockCount @:items need attention
                            }
                            else
                            {
                                <i class="fas fa-check text-success"></i> @:All items in stock
                            }
                        </span>
                    </div>
                    <div class="icon">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <a href="@Url.Action("Index", "Inventory")" class="small-box-footer">
                        More info <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Enhanced Order Status & KPIs -->
        <div class="row mb-4">
            <div class="col-lg-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-chart-pie mr-2"></i>
                            Order Status Distribution
                        </h3>
                    </div>
                    <div class="card-body">
                        <canvas id="orderStatusChart" style="height: 250px;"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-chart-line mr-2"></i>
                            30-Day Order Trends
                        </h3>
                    </div>
                    <div class="card-body">
                        <canvas id="orderTrendsChart" style="height: 250px;"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions & Performance Metrics -->
        <div class="row mb-4">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-bolt mr-2"></i>
                            Quick Actions & Performance
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <!-- Quick Actions -->
                            <div class="col-md-6">
                                <h6>Quick Actions</h6>
                                <div class="btn-group-vertical w-100 mb-3">
                                    <a href="@Url.Action("CreateWorkflow", "Orders")" class="btn btn-primary mb-2">
                                        <i class="fas fa-plus mr-2"></i>Create New Order
                                    </a>
                                    <a href="@Url.Action("Create", "Customers")" class="btn btn-success mb-2">
                                        <i class="fas fa-user-plus mr-2"></i>Add Customer
                                    </a>
                                    <a href="@Url.Action("Create", "Inventory")" class="btn btn-info mb-2">
                                        <i class="fas fa-boxes mr-2"></i>Add Inventory
                                    </a>
                                    <a href="@Url.Action("Create", "CustomerProducts")" class="btn btn-warning">
                                        <i class="fas fa-cube mr-2"></i>Create Product
                                    </a>
                                </div>
                            </div>
                            <!-- KPIs -->
                            <div class="col-md-6">
                                <h6>Key Performance Indicators</h6>
                                <div class="row">
                                    <div class="col-6">
                                        <div class="info-box bg-info">
                                            <span class="info-box-icon"><i class="fas fa-chart-line"></i></span>
                                            <div class="info-box-content">
                                                <span class="info-box-text">Avg Order Value</span>
                                                <span class="info-box-number">@CurrencyHelper.FormatCurrency(ViewBag.AverageOrderValue ?? 0)</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="info-box bg-success">
                                            <span class="info-box-icon"><i class="fas fa-percentage"></i></span>
                                            <div class="info-box-content">
                                                <span class="info-box-text">Completion Rate</span>
                                                <span class="info-box-number">
                                                    @{
                                                        var completionRate = ViewBag.TotalOrders > 0 ? 
                                                            Math.Round((double)ViewBag.CompletedOrders / (double)ViewBag.TotalOrders * 100, 1) : 0;
                                                    }
                                                    @completionRate%
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-6">
                                        <div class="info-box bg-warning">
                                            <span class="info-box-icon"><i class="fas fa-clock"></i></span>
                                            <div class="info-box-content">
                                                <span class="info-box-text">Pending</span>
                                                <span class="info-box-number">@ViewBag.PendingOrders</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="info-box bg-danger">
                                            <span class="info-box-icon"><i class="fas fa-exclamation-triangle"></i></span>
                                            <div class="info-box-content">
                                                <span class="info-box-text">Overdue</span>
                                                <span class="info-box-number">@(ViewBag.OverdueOrders ?? 0)</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Top Customers -->
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-crown mr-2"></i>
                            Top Customers
                        </h3>
                    </div>
                    <div class="card-body">
                        @if (ViewBag.TopCustomers != null && ((List<AmplePack.ViewModels.TopCustomerDto>)ViewBag.TopCustomers).Any())
                        {
                            @foreach (var customer in (List<AmplePack.ViewModels.TopCustomerDto>)ViewBag.TopCustomers)
                            {
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <strong>@customer.CustomerName</strong><br>
                                        <small class="text-muted">@customer.OrderCount orders</small>
                                    </div>
                                    <div class="text-right">
                                        <span class="text-success font-weight-bold">
                                            @CurrencyHelper.FormatCurrency(customer.TotalValue)
                                        </span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-3">
                                <i class="fas fa-users fa-2x text-muted mb-2"></i>
                                <p class="text-muted">No customer data available</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Activity & Alerts -->
        <div class="row">
            <!-- Recent Orders -->
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-history mr-2"></i>
                            Recent Orders
                        </h3>
                        <div class="card-tools">
                            <a href="@Url.Action("Index", "Orders")" class="btn btn-tool">
                                <i class="fas fa-eye"></i> View All
                            </a>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        @if (ViewBag.RecentOrders != null && ((List<AmplePack.Models.Order>)ViewBag.RecentOrders).Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Order #</th>
                                            <th>Customer</th>
                                            <th>Date</th>
                                            <th>Items</th>
                                            <th>Amount</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var order in ((List<AmplePack.Models.Order>)ViewBag.RecentOrders))
                                        {
                                            <tr>
                                                <td>
                                                    <strong>#@order.Id</strong>
                                                </td>
                                                <td>@order.Customer?.Name</td>
                                                <td>@order.Date.ToString("MMM dd, yyyy")</td>
                                                <td>
                                                    <span class="badge badge-info">@(order.OrderDetails?.Count ?? 0) items</span>
                                                </td>
                                                <td>@CurrencyHelper.FormatCurrency(order.TotalAmount)</td>
                                                <td>
                                                    <span class="badge badge-@(order.Status switch {
                                                        "Pending" => "warning",
                                                        "Processing" => "info", 
                                                        "Completed" => "success",
                                                        "Cancelled" => "secondary",
                                                        _ => "secondary"
                                                    })">
                                                        @order.Status
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="btn-group btn-group-sm">
                                                        <a href="@Url.Action("Details", "Orders", new { id = order.Id })" 
                                                           class="btn btn-outline-info" title="View Details">
                                                            <i class="fas fa-eye"></i>
                                                        </a>
                                                        <a href="@Url.Action("DownloadInvoice", "Orders", new { id = order.Id })" 
                                                           class="btn btn-outline-primary" title="Download Invoice">
                                                            <i class="fas fa-file-pdf"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
                                <h5>No Recent Orders</h5>
                                <p class="text-muted">Start by creating your first order.</p>
                                <a href="@Url.Action("CreateWorkflow", "Orders")" class="btn btn-primary">
                                    <i class="fas fa-plus"></i> Create Order
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Alerts & Notifications -->
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-bell mr-2"></i>
                            Alerts & Notifications
                        </h3>
                    </div>
                    <div class="card-body">
                        @if (ViewBag.LowStockItems != null && ((List<AmplePack.Models.Inventory>)ViewBag.LowStockItems).Any())
                        {
                            <div class="alert alert-warning">
                                <h6><i class="fas fa-exclamation-triangle"></i> Low Stock Alert</h6>
                                <p class="mb-0">@ViewBag.LowStockCount items are running low on stock.</p>
                            </div>
                            
                            @foreach (var item in ((List<AmplePack.Models.Inventory>)ViewBag.LowStockItems).Take(3))
                            {
                                <div class="alert alert-warning alert-dismissible">
                                    <button type="button" class="close" data-dismiss="alert">×</button>
                                    <h6 class="mb-1">@item.ItemName</h6>
                                    <small>Only @item.AvailableQuantity @item.Unit remaining (Reorder at @item.ReorderLevel)</small>
                                </div>
                            }

                            @if (((List<AmplePack.Models.Inventory>)ViewBag.LowStockItems).Count > 3)
                            {
                                <div class="text-center">
                                    <a href="@Url.Action("Index", "Inventory")" class="btn btn-warning btn-sm">
                                        View All Low Stock Items
                                    </a>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-success">
                                <h6><i class="fas fa-check-circle"></i> All Good!</h6>
                                <p class="mb-0">No critical alerts at this time. All inventory levels are adequate.</p>
                            </div>
                        }

                        <!-- System Status -->
                        <div class="mt-3">
                            <h6>System Status</h6>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span>Database</span>
                                <span class="badge badge-success">Online</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span>Application</span>
                                <span class="badge badge-success">Running</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span>Last Updated</span>
                                <small class="text-muted">@DateTime.Now.ToString("MMM dd, yyyy HH:mm")</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <script>
        $(document).ready(function() {
            loadDashboardCharts();
        });

        function loadDashboardCharts() {
            // Get chart data from API
            $.ajax({
                url: '@Url.Action("GetDashboardChartData")',
                type: 'GET',
                success: function(response) {
                    if (response.success) {
                        renderOrderStatusChart(response.statusDistribution);
                        renderOrderTrendsChart(response.dailyTrends);
                    }
                },
                error: function() {
                    console.log('Failed to load chart data');
                }
            });
        }

        function renderOrderStatusChart(statusData) {
            const ctx = document.getElementById('orderStatusChart').getContext('2d');
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: statusData.map(item => item.status),
                    datasets: [{
                        data: statusData.map(item => item.count),
                        backgroundColor: [
                            '#ffc107', // Pending - Warning
                            '#17a2b8', // Processing - Info  
                            '#28a745', // Completed - Success
                            '#6c757d'  // Cancelled - Secondary
                        ],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom'
                        }
                    }
                }
            });
        }

        function renderOrderTrendsChart(trendsData) {
            const ctx = document.getElementById('orderTrendsChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: trendsData.map(item => new Date(item.date).toLocaleDateString()),
                    datasets: [{
                        label: 'Orders',
                        data: trendsData.map(item => item.orders),
                        borderColor: '#007bff',
                        backgroundColor: 'rgba(0, 123, 255, 0.1)',
                        tension: 0.4,
                        fill: true,
                        yAxisID: 'y'
                    }, {
                        label: 'Revenue',
                        data: trendsData.map(item => item.revenue),
                        borderColor: '#28a745',
                        backgroundColor: 'rgba(40, 167, 69, 0.1)',
                        tension: 0.4,
                        fill: true,
                        yAxisID: 'y1'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false,
                    },
                    scales: {
                        x: {
                            display: true,
                            title: {
                                display: true,
                                text: 'Date'
                            }
                        },
                        y: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            title: {
                                display: true,
                                text: 'Orders'
                            }
                        },
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            title: {
                                display: true,
                                text: 'Revenue'
                            },
                            grid: {
                                drawOnChartArea: false,
                            },
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'top'
                        }
                    }
                }
            });
        }

        function refreshDashboard() {
            window.location.reload();
        }

        // Auto-refresh dashboard every 5 minutes
        setInterval(function() {
            loadDashboardCharts();
        }, 300000);
    </script>
}
